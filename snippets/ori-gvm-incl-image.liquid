{%- comment -%}
  One frame in the What's included image grid. Shared by both sources (section
  Image blocks and the per-product metafield) so the markup cannot drift - the
  grid CSS keys off data-count and :nth-child.

  image - image drop. alt - optional override. attrs - block.shopify_attributes
  (empty for metafield images). span - true when the frame runs full width.
{%- endcomment -%}

{%- liquid
  # sizes must describe the width the frame really renders at, or Shopify
  # serves a candidate too small and the browser scales it up. A spanning
  # frame is roughly twice a half-row one, hence the two branches below.
  if span
    assign incl_img_sizes = '(min-width: 1440px) 730px, (min-width: 990px) 56vw, 100vw'
  else
    assign incl_img_sizes = '(min-width: 1440px) 360px, (min-width: 990px) 28vw, (min-width: 750px) 50vw, 100vw'
  endif
-%}

{%- if image != blank -%}
  {%- assign incl_img_alt = alt | default: image.alt -%}
  <figure class="ori-gvm-incl__frame" data-gallery-slide {{ attrs }}>
    {{-
      image
      | image_url: width: 1200
      | image_tag:
        loading: 'lazy',
        class: 'ori-gvm-incl__img',
        widths: '360,540,720,960,1200',
        sizes: incl_img_sizes,
        alt: incl_img_alt
    -}}
  </figure>
{%- endif -%}
