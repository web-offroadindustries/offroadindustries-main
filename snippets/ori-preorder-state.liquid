{%- comment -%}
  Outputs 'pre' for a variant selling past zero stock, otherwise nothing.

  variant.available stays true under inventory_policy 'continue', and
  quantity_rule_soldout switches itself off in that same case, so neither can
  answer "has this run out". Needs all three: tracked by Shopify, quantity at
  or below zero, policy 'continue'. 'deny' at zero is a plain sell out.

  Only suppresses the stock line. An earlier version also hid the buy button
  and was reverted: it took the Selleasy add-on upsell with it.
{%- endcomment -%}

{%- liquid
  assign v = variant | default: product.selected_or_first_available_variant
  assign state = ''

  if v and v.inventory_management == 'shopify' and v.inventory_quantity <= 0 and v.inventory_policy == 'continue'
    assign state = 'pre'
  endif

  echo state
-%}
