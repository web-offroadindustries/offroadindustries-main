{%- comment -%}
  BreadcrumbList JSON-LD.

  Pass crumbs: a 'Label|/url' list split on commas, or pass product and
  collection on a product page and it builds the crumbs itself.
{%- endcomment -%}

{%- liquid
  assign bc_items = ''
  assign bc_pos   = 1
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": {{ shop.url | json }}
    }
    {%- if collection != blank -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ collection.title | json }},
      "item": {{ shop.url | append: collection.url | json }}
    }
      {%- if product != blank -%}
      ,{
        "@type": "ListItem",
        "position": 3,
        "name": {{ product.title | json }},
        "item": {{ shop.url | append: product.url | json }}
      }
      {%- endif -%}
    {%- elsif product != blank -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ product.title | json }},
      "item": {{ shop.url | append: product.url | json }}
    }
    {%- elsif page != blank -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ page.title | json }},
      "item": {{ shop.url | append: page.url | json }}
    }
    {%- elsif crumbs != blank -%}
    {%- assign crumb_arr = crumbs | split: ',' -%}
    {%- for crumb in crumb_arr -%}
      {%- assign crumb_parts = crumb | split: '|' -%}
      ,{
        "@type": "ListItem",
        "position": {{ forloop.index | plus: 1 }},
        "name": {{ crumb_parts[0] | strip | json }},
        "item": {{ shop.url | append: crumb_parts[1] | strip | json }}
      }
    {%- endfor -%}
    {%- endif -%}
  ]
}
</script>
