{%- comment -%}
  AutomotiveBusiness / LocalBusiness JSON-LD. Render once per page, on the
  GVM/GCM hub pages only.

  TODO: confirm address, phone and opening hours with the client, and add the
  real VTA approval numbers to hasCredential.
{%- endcomment -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["AutomotiveBusiness", "LocalBusiness"],
  "name": "ORI Offroad Industries",
  "url": {{ shop.url | json }},
  "logo": {{ shop.url | append: '/cdn/shop/files/ori-logo.png' | json }},
  "description": "Australia's supplier of federally approved GVM and GCM upgrade packages for American trucks and 4WDs. SSM-certified, ADR-tested, with a national installer network.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "TBC — confirm with client",
    "addressLocality": "Melbourne",
    "addressRegion": "VIC",
    "postalCode": "TBC",
    "addressCountry": "AU"
  },
  "telephone": "TBC — confirm with client",
  "areaServed": {
    "@type": "Country",
    "name": "Australia"
  },
  "serviceType": [
    "GVM Upgrades",
    "GCM Upgrades",
    "Payload Capacity Upgrades",
    "SSM Certification",
    "Suspension Upgrades"
  ],
  "hasCredential": [
    {
      "@type": "EducationalOccupationalCredential",
      "credentialCategory": "SSM Certification",
      "name": "Second Stage of Manufacture — Federal Certification",
      "description": "All ORI GVM/GCM packages carry full SSM certification under Australian Design Rules (ADR). VTA approval numbers available on request per vehicle platform."
    }
  ],
  "sameAs": [
    "https://www.instagram.com/orioffroad",
    "https://www.facebook.com/orioffroad"
  ]
}
</script>
