{%- liquid
  assign b2b_user = false
  if customer
    if customer.b2b? or customer.tags contains 'b2b'
      assign b2b_user = true
    endif
  endif

  assign inventory_visible = false
  assign show_progress = block.settings.show_as_progress
  assign is_show_progress = false
  if current_variant.inventory_management == 'shopify'
    if b2b_user
      if current_variant.inventory_quantity >= 0
        assign inventory_visible = true
      endif
    elsif current_variant.inventory_quantity <= block.settings.inventory_threshold and current_variant.inventory_quantity >= 0
      assign inventory_visible = true
    endif
  endif

  if current_variant.inventory_quantity <= 0 or current_variant.inventory_policy == 'continue'
    unless b2b_user
      assign inventory_visible = false
    endunless
  endif

  assign show_incoming = false
  if current_variant.incoming and current_variant.inventory_quantity <= block.settings.inventory_threshold
    assign show_incoming = true
  endif

  if show_progress and inventory_visible
    assign is_show_progress = true
  endif
-%}

{%- comment -%}
  The stock line is suppressed on pre-orders, where "In stock, ready to ship"
  sitting next to a Pre-Order button contradicts it. A product can be a
  pre-order in two ways and both have to be covered:

  - Timesact holds a selling plan on it. That app renders nothing server side,
    so the selling plan group is the only trace Liquid can see.
  - The variant has run out under "Sell when out of stock", which is what
    ori-preorder-state answers. This one matters because such a variant still
    reports .available == true, so the available check further down does not
    catch it, and the block would otherwise promise ready to ship with nothing
    on the shelf.

  B2B users are exempt and keep their counts either way.

  Only those two cases are suppressed. An ordinary product, in stock or sold
  out, keeps its stock line. Switching it off for everything is the regression
  this guard exists to avoid, so the default has to stay "show it".
{%- endcomment -%}
{%- capture ori_preorder_state -%}
  {%- render 'ori-preorder-state', product: product, variant: current_variant -%}
{%- endcapture -%}
{%- liquid
  assign ori_preorder_state = ori_preorder_state | strip

  assign is_preorder = false
  if product.selling_plan_groups.size > 0
    assign is_preorder = true
  endif
  if ori_preorder_state == 'pre'
    assign is_preorder = true
  endif
-%}
{%- if b2b_user or is_preorder == false -%}
<div
  class="f-product-single__block-inventory-status"
  data-product-id="{{ product.id }}"
  {{ block.shopify_attributes }}
  id="Inventory-{{ section.id }}"
>
  <ul class="f-inventory-status">
    <li class="f-inventory--point">
      <span class="f-inventory--icon-text{% if inventory_visible == true %} f-inventory--low{% endif %}{% unless current_variant.available %} hidden{% endunless %}">
        <span class="f-inventory--icon{% if is_show_progress %} hidden{% endif %}"></span>
        <span data-product-inventory data-threshold="{{ block.settings.inventory_threshold }}">
          {%- if inventory_visible -%}
            {{ 'products.product.stock_label' | t: count: current_variant.inventory_quantity }}
          {%- else -%}
            {{ 'products.product.in_stock_label' | t }}
          {%- endif -%}
        </span>
      </span>
      <f-progress-bar
        data-quantity="{{ current_variant.inventory_quantity }}"
        data-show="{{ show_progress }}"
        {% if is_show_progress %}
          style="display: block;"
        {% endif %}
      ></f-progress-bar>
    </li>
    {%- if block.settings.enable_inventory_transfer -%}
      <li
        data-incoming-inventory
        data-show="{{ show_incoming }}"
        class="f-inventory--point{% unless show_incoming %} hidden{% endunless %}"
      >
        <span class="f-inventory--icon-text">
          <span class="f-inventory--icon"></span>
          <span class="f-inventory--incoming-text f-js-incoming-text">
            {%- if current_variant.next_incoming_date -%}
              {%- assign date = current_variant.next_incoming_date | date: format: 'date' -%}
              {%- if current_variant.available -%}
                {{ 'products.product.will_not_ship_until' | t: date: date }}
              {%- else -%}
                {{ 'products.product.will_be_in_stock_after' | t: date: date }}
              {%- endif -%}
            {%- else -%}
              {{ 'products.product.waiting_for_stock' | t }}
            {%- endif -%}
          </span>
        </span>
      </li>
    {%- endif -%}
  </ul>
</div>

{%- assign variants_with_inventory_tracking = product.variants | where: 'inventory_management', 'shopify' -%}

<script>
  window.FoxInventories = window.FoxInventories || {}
  window.FoxInventories['{{ product.id }}'] = {}
  {% for variant in variants_with_inventory_tracking %}
    window.FoxInventories['{{ product.id }}'][{{ variant.id }}] = {
      'quantity': {{ variant.inventory_quantity | default: 0 }},
      'policy': '{{ variant.inventory_policy | default: false }}',
      'incoming': '{{ variant.incoming | default: false }}',
      'next_incoming_date': {{ variant.next_incoming_date | date: format: 'date' | json }}
    };
  {% endfor %}
</script>
{%- endif -%}
