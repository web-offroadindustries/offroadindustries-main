{%- comment -%}
  ORI GVM Approved. Shows a section that lives on another page, so the
  installer list is edited in one place and every page carrying this follows.

  Liquid cannot reach another page's section blocks, so assets/
  ori-gvm-approved.js lifts it in the browser. Falls back to a link.
{%- endcomment -%}

{{ 'ori-gvm-approved.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  The injected markup arrives without its stylesheet, so the source section's
  CSS is enqueued here too. Both are small and Shopify serves them cached.
{%- endcomment -%}
{{ 'dealer-locator.css' | asset_url | stylesheet_tag }}
{{ 'ori-installer-network.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ori-gvm-approved.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign section_id = section.settings.custom_id | default: section.id
  assign container = section.settings.container | default: 'container'
  assign source_page = section.settings.source_page

  assign selector = section.settings.source_section
  if selector == 'custom'
    assign selector = section.settings.custom_selector
  endif

  # Full width drops this section's own container and band padding so the
  # pulled section reaches the screen edges. The pulled section keeps its own
  # internal spacing, which is what stops the heading sitting against the top
  # edge; adjust that on the source page rather than here.
  assign full_width = section.settings.full_width
  assign pad_top = section.settings.padding_top
  assign pad_bottom = section.settings.padding_bottom
  # Data only is the exception: the section is drawing its own heading and
  # background now, and the script strips the padding off the pulled markup,
  # so zeroing this too would leave the band with no vertical space at all.
  if full_width and section.settings.data_only != true
    assign pad_top = 0
    assign pad_bottom = 0
  endif
-%}

<div
  id="{{ section_id }}"
  class="ori-gvm-product ori-gvm-product--{{ section.settings.layout | default: 'classic' }} color-{{ section.settings.color_schema }}"
  data-section-type="ori-gvm-approved"
  style="--gvm-tint: {{ section.settings.tint_color | default: '#f3f6f7' }};"
>
  <div
    class="ori-gvm-product__band{% if section.settings.alt_background %} ori-gvm-product__band--alt{% endif %}{% if full_width %} ori-gvm-approved__band--bleed{% endif %}{% if full_width and section.settings.flush_top_bottom %} ori-gvm-approved__band--flush{% endif %}"
    style="padding-top: {{ pad_top }}px; padding-bottom: {{ pad_bottom }}px; --approved-gutter: {{ section.settings.content_gutter | default: 24 }}px;{% if section.settings.bg_color != blank %} background: {{ section.settings.bg_color }};{% endif %}"
  >
    {%- comment -%}
      A plain full-width div in place of the container, so the pulled section's
      own background runs edge to edge instead of sitting in a letterbox.
    {%- endcomment -%}
    <div class="{% if full_width %}ori-gvm-approved__full{% else %}{{ container }}{% endif %}">
      {%- if section.settings.heading != blank or section.settings.description != blank -%}
        <div class="ori-gvm-approved__intro">
          {%- if section.settings.heading != blank -%}
            <h2 class="ori-gvm-product__block-title h3">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.description != blank -%}
            <p class="ori-gvm-approved__intro-text">{{ section.settings.description }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if source_page == blank or selector == blank -%}
        {%- comment -%}
          Nothing chosen yet. Say so in the editor rather than rendering an
          empty band, and stay silent on the storefront.
        {%- endcomment -%}
        {%- if request.design_mode -%}
          <p class="ori-gvm-approved__fallback">
            Pick a source page in the theme editor to show its installer list here.
          </p>
        {%- endif -%}
      {%- else -%}
        <ori-gvm-approved
          class="ori-gvm-approved"
          data-source-url="{{ source_page.url }}"
          data-source-selector="{{ selector | escape }}"
          {% if section.settings.data_only %}data-data-only="1"{% endif %}
        >
          <div class="ori-gvm-approved__placeholder" data-approved-target>
            <span class="ori-gvm-approved__spinner" aria-hidden="true"></span>
          </div>

          {%- comment -%}
            Rendered up front, not injected on failure, so it is in the HTML
            for search engines and for anyone the script never reaches.
          {%- endcomment -%}
          <p class="ori-gvm-approved__fallback">
            <a href="{{ source_page.url }}">
              {{- section.settings.fallback_text | default: 'View our approved installers' -}}
            </a>
          </p>
        </ori-gvm-approved>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ORI GVM Approved",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows a section from another page, so the installer list is only ever edited in one place. Point this at ORI GVM Upgrades."
    },
    { "type": "page", "id": "source_page", "label": "Source page" },
    {
      "type": "select",
      "id": "source_section",
      "label": "Which section to pull",
      "options": [
        { "value": ".dealer-locator", "label": "Dealer locator" },
        { "value": "[data-section-type=\"ori-installer-network\"]", "label": "Installer network" },
        { "value": "custom", "label": "Custom (advanced)" }
      ],
      "default": ".dealer-locator"
    },
    {
      "type": "text",
      "id": "custom_selector",
      "label": "Custom CSS selector",
      "info": "Only used when the option above is set to Custom."
    },
    {
      "type": "checkbox",
      "id": "data_only",
      "label": "Use my own heading and background",
      "info": "Pulls just the installer cards and drops the source page heading, so the heading, description and background below are the ones that show.",
      "default": false
    },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Used when the option above is ticked. Left empty, no heading is drawn." },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "info": "Sits under the heading. Left empty, nothing is drawn."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "info": "Left empty the band keeps whatever background it had."
    },
    {
      "type": "text",
      "id": "fallback_text",
      "label": "Fallback link text",
      "info": "Shown until the list loads, and kept if it cannot be reached.",
      "default": "View our approved installers"
    },
    { "type": "header", "content": "Appearance" },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width, no outer padding",
      "info": "Runs the pulled section edge to edge, overriding the container it brings with it.",
      "default": false
    },
    {
      "type": "range",
      "id": "content_gutter",
      "label": "Side gutter",
      "info": "Space between the screen edge and the content when Full width is on. Set 0 for true edge to edge.",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "flush_top_bottom",
      "label": "Also remove the pulled section's top and bottom padding",
      "info": "Only applies with Full width on. Leave off to keep the spacing set on the source page, which is what keeps the heading off the top edge.",
      "default": false
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout style",
      "info": "Match this to the other ORI GVM sections on the page.",
      "options": [
        { "value": "classic", "label": "Classic (light, centred)" },
        { "value": "editorial", "label": "Technical (engineering plate)" }
      ],
      "default": "classic"
    },
    { "type": "checkbox", "id": "alt_background", "label": "Use tinted background", "default": false },
    { "type": "color", "id": "tint_color", "label": "Tint colour", "default": "#f3f6f7" },
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "options": [
        { "value": "container", "label": "Fixed (1200px)" },
        { "value": "container-narrow", "label": "Narrow" },
        { "value": "container-full", "label": "Full width" }
      ],
      "default": "container"
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "text", "id": "custom_id", "label": "Custom HTML ID" },
    { "type": "text", "id": "color_schema", "label": "Color scheme class" }
  ],
  "presets": [{ "name": "ORI GVM Approved" }]
}
{% endschema %}
