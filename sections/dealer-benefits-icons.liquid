{% liquid
  assign section_id = section.id
%}

<section id="DealerBenefitsIcons-{{ section_id }}" class="dealer-benefits-icons-section">
  <div class="dealer-benefits-icons__container">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank %}
      <div class="dealer-benefits-icons__header text-{{ section.settings.text_alignment }}">
        {% if section.settings.eyebrow != blank %}
          <p class="dealer-benefits-icons__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="dealer-benefits-icons__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <div class="dealer-benefits-icons__text rte">{{ section.settings.text }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="dealer-benefits-icons__grid dealer-benefits-icons__grid--{{ section.blocks.size }}">
      {% for block in section.blocks %}
        <div class="dealer-benefits-icons__card" {{ block.shopify_attributes }}>
          <div class="dealer-benefits-icons__icon-wrap">
            <span class="dealer-benefits-icons__icon dealer-benefits-icons__icon--{{ block.settings.icon }}">
              {% case block.settings.icon %}
                {% when 'truck' %}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h10v8h2.5l2-3H21v3h-1.1a2.9 2.9 0 0 1 .1.75A3.25 3.25 0 1 1 13.5 14H10a3.25 3.25 0 1 1-6.25.75V6Zm12 2v3h1.4l1.2-1.8V8H15Zm-8 8a1.25 1.25 0 1 0 .001 2.499A1.25 1.25 0 0 0 7 16Zm9.5 0a1.25 1.25 0 1 0 .001 2.499A1.25 1.25 0 0 0 16.5 16Z" fill="currentColor"/></svg>
                {% when 'shield' %}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 4 5v6c0 5.55 3.84 10.74 8 12 4.16-1.26 8-6.45 8-12V5l-8-3Zm0 4.2 4 1.5V11c0 3.53-2.2 6.96-4 8.12-1.8-1.16-4-4.59-4-8.12V7.7l4-1.5Z" fill="currentColor"/></svg>
                {% when 'wrench' %}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 7.5a5.5 5.5 0 0 1-7.68 5.06l-7.26 7.26a2 2 0 1 1-2.83-2.83l7.26-7.26A5.5 5.5 0 0 1 16.5 2l-3 3 1.5 1.5 3-3A5.48 5.48 0 0 1 21 7.5Z" fill="currentColor"/></svg>
                {% when 'support' %}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a8 8 0 0 0-8 8v2a3 3 0 0 0 3 3h1v-5H6v-1a6 6 0 1 1 12 0v1h-2v5h1a3 3 0 0 0 3-3v-2a8 8 0 0 0-8-8Zm-2 10h4v2a2 2 0 0 1-4 0v-2Z" fill="currentColor"/></svg>
                {% when 'map' %}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 4.82 7 13 7 13s7-8.18 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z" fill="currentColor"/></svg>
                {% else %}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 2 7l10 5 10-5-10-5Zm-8 8 8 4 8-4v7l-8 4-8-4v-7Z" fill="currentColor"/></svg>
              {% endcase %}
            </span>
          </div>
          {% if block.settings.title != blank %}
            <h3 class="dealer-benefits-icons__card-title">{{ block.settings.title }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <div class="dealer-benefits-icons__card-text rte">{{ block.settings.text }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

  <style>
    #DealerBenefitsIcons-{{ section_id }} {
      background: {{ section.settings.section_bg_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    #DealerBenefitsIcons-{{ section_id }} .dealer-benefits-icons__container {
      max-width: {{ section.settings.container_width }}px;
      margin: 0 auto;
      padding: 0 20px;
    }
    #DealerBenefitsIcons-{{ section_id }} .dealer-benefits-icons__header {
      max-width: {{ section.settings.header_width }}px;
      margin: 0 auto 34px;
    }
    #DealerBenefitsIcons-{{ section_id }} .text-left { text-align: left; }
    #DealerBenefitsIcons-{{ section_id }} .text-center { text-align: center; }
    #DealerBenefitsIcons-{{ section_id }} .text-right { text-align: right; }
    #DealerBenefitsIcons-{{ section_id }} .dealer-benefits-icons__eyebrow {
      margin: 0 0 10px;
      font-family: "Geomanist", sans-serif;
      font-size: 13px;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: {{ section.settings.eyebrow_color }};
    }
    #DealerBenefitsIcons-{{ section_id }} .dealer-benefits-icons__heading {
      margin: 0 0 14px;
      font-family: "Evogria", sans-serif;
      font-size: {{ section.settings.heading_size }}px;
      line-height: 1.06;
      text-transform: uppercase;
      color: {{ section.settings.heading_color }};
    }
    #DealerBenefitsIcons-{{ section_id }} .dealer-benefits-icons__text,
    #DealerBenefitsIcons-{{ section_id }} .dealer-benefits-icons__card-text {
      font-family: "Geomanist", sans-serif;
      font-size: 16px;
      line-height: 1.7;
      color: {{ section.settings.text_color }};
    }
    #DealerBenefitsIcons-{{ section_id }} .dealer-benefits-icons__text > *:first-child,
    #DealerBenefitsIcons-{{ section_id }} .dealer-benefits-icons__card-text > *:first-child {
      margin-top: 0;
    }
    #DealerBenefitsIcons-{{ section_id }} .dealer-benefits-icons__grid {
      display: grid;
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
      gap: {{ section.settings.column_gap }}px;
    }
    #DealerBenefitsIcons-{{ section_id }} .dealer-benefits-icons__card {
      height: 100%;
      padding: 28px 24px;
      border: 1px solid {{ section.settings.card_border_color }};
      border-radius: {{ section.settings.card_radius }}px;
      background: {{ section.settings.card_bg_color }};
      box-shadow: 0 12px 30px rgba(0,0,0,.05);
    }
    #DealerBenefitsIcons-{{ section_id }} .dealer-benefits-icons__icon-wrap {
      margin-bottom: 18px;
    }
    #DealerBenefitsIcons-{{ section_id }} .dealer-benefits-icons__icon {
      display: inline-flex;
      width: {{ section.settings.icon_size }}px;
      height: {{ section.settings.icon_size }}px;
      align-items: center;
      justify-content: center;
      color: {{ section.settings.icon_color }};
    }
    #DealerBenefitsIcons-{{ section_id }} .dealer-benefits-icons__icon svg {
      width: 100%;
      height: 100%;
      display: block;
    }
    #DealerBenefitsIcons-{{ section_id }} .dealer-benefits-icons__card-title {
      margin: 0 0 10px;
      font-family: "Evogria", sans-serif;
      font-size: {{ section.settings.card_heading_size }}px;
      line-height: 1.12;
      text-transform: uppercase;
      color: {{ section.settings.card_heading_color }};
    }
    @media (max-width: 989px) {
      #DealerBenefitsIcons-{{ section_id }} .dealer-benefits-icons__heading {
        font-size: {{ section.settings.heading_size_mobile }}px;
      }
      #DealerBenefitsIcons-{{ section_id }} .dealer-benefits-icons__grid {
        grid-template-columns: repeat({{ section.settings.columns_tablet }}, minmax(0, 1fr));
      }
    }
    @media (max-width: 749px) {
      #DealerBenefitsIcons-{{ section_id }} .dealer-benefits-icons__container {
        padding: 0 16px;
      }
      #DealerBenefitsIcons-{{ section_id }} .dealer-benefits-icons__grid {
        grid-template-columns: 1fr;
      }
      #DealerBenefitsIcons-{{ section_id }} .dealer-benefits-icons__card {
        padding: 24px 20px;
      }
    }
  </style>
</section>

{% schema %}
{
  "name": "Dealer benefits icons",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why partner with us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for specialist 4x4 and suspension dealers" },
    { "type": "richtext", "id": "text", "label": "Content", "default": "<p>Use this section to highlight the strongest reasons dealers should work with Offroad Industries.</p>" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center" },
    { "type": "range", "id": "heading_size", "label": "Heading size desktop", "min": 28, "max": 68, "step": 2, "default": 44 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size mobile", "min": 24, "max": 44, "step": 2, "default": 32 },
    { "type": "range", "id": "header_width", "label": "Header width", "min": 480, "max": 980, "step": 20, "default": 760 },
    { "type": "range", "id": "container_width", "label": "Container width", "min": 980, "max": 1600, "step": 20, "default": 1240 },
    { "type": "range", "id": "columns_desktop", "label": "Columns desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_tablet", "label": "Columns tablet", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 12, "max": 40, "step": 2, "default": 24 },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 28, "max": 80, "step": 2, "default": 46 },
    { "type": "range", "id": "card_heading_size", "label": "Card heading size", "min": 18, "max": 34, "step": 2, "default": 24 },
    { "type": "color", "id": "section_bg_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#56bdc2" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#101820" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#4a4a4a" },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#56bdc2" },
    { "type": "color", "id": "card_bg_color", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "card_border_color", "label": "Card border", "default": "#d9d9d9" },
    { "type": "color", "id": "card_heading_color", "label": "Card heading color", "default": "#101820" },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 30, "step": 1, "default": 14 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "default": 72 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          {"value":"truck","label":"Truck"},
          {"value":"shield","label":"Shield"},
          {"value":"wrench","label":"Wrench"},
          {"value":"support","label":"Support"},
          {"value":"map","label":"Map pin"},
          {"value":"badge","label":"Badge"}
        ], "default": "truck" },
        { "type": "text", "id": "title", "label": "Title", "default": "Specialist product range" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add a short and clear benefit for prospective dealers.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dealer benefits icons",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "truck", "title": "Premium product mix", "text": "<p>Position your dealership with proven suspension, GVM and 4x4 upgrade categories.</p>" } },
        { "type": "benefit", "settings": { "icon": "wrench", "title": "Technical fitment support", "text": "<p>Help customers confidently choose the right upgrade with expert guidance from our team.</p>" } },
        { "type": "benefit", "settings": { "icon": "support", "title": "Responsive dealer service", "text": "<p>Get assistance for account setup, product selection and ongoing trade enquiries.</p>" } }
      ]
    }
  ]
}
{% endschema %}
