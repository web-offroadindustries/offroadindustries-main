{% comment %}
  Product Tabs (Guidelines)
  - Tabs are blocks so you can add/remove/reorder easily
  - Per-product content via metafields (namespace + key)
{% endcomment %}

<section id="Tabs-{{ section.id }}" class="pc-tabs">
  <div class="pc-tabs__wrap">
    <div class="pc-tabs__nav" role="tablist" aria-label="Product tabs">
      {% for block in section.blocks %}
        {% assign tab_id = 'tab-' | append: section.id | append: '-' | append: block.id %}
        {% assign panel_id = 'panel-' | append: section.id | append: '-' | append: block.id %}
        <button
          id="{{ tab_id }}"
          class="pc-tabs__tab{% if forloop.first %} is-active{% endif %}"
          type="button"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-controls="{{ panel_id }}"
          data-panel="{{ panel_id }}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.title | escape }}
        </button>
      {% endfor %}
    </div>

    <div class="pc-tabs__panels">
      {% for block in section.blocks %}
        {% assign panel_id = 'panel-' | append: section.id | append: '-' | append: block.id %}

        <div
          id="{{ panel_id }}"
          class="pc-tabs__panel rte{% if forloop.first %} is-active{% endif %}"
          role="tabpanel"
          aria-labelledby="{{ 'tab-' | append: section.id | append: '-' | append: block.id }}"
          {% unless forloop.first %}hidden{% endunless %}
        >
          {% case block.settings.content_type %}
            {% when 'product_description' %}
              {{ product.description }}

            {% when 'metafield' %}
              {% assign ns = block.settings.metafield_namespace | strip %}
              {% assign key = block.settings.metafield_key | strip %}
              {% assign mf = blank %}
              {% if ns != blank and key != blank %}
                {% assign mf = product.metafields[ns][key] %}
              {% endif %}

              {% if mf != blank %}
                {{ mf | metafield_tag }}
              {% else %}
                {% if request.design_mode %}
                  <p><strong>Metafield not found.</strong> Set namespace + key in this tab block.</p>
                  <p>Example: namespace <code>custom</code>, key <code>important_notes</code></p>
                {% endif %}
              {% endif %}

            {% when 'page' %}
              {% if block.settings.page != blank %}
                {{ pages[block.settings.page].content }}
              {% endif %}

            {% when 'custom' %}
              {{ block.settings.custom_richtext }}

            {% when 'reviews_anchor' %}
              {% if request.design_mode %}
                <p>This tab scrolls to your reviews section.</p>
              {% endif %}
          {% endcase %}
        </div>
      {% endfor %}
    </div>
  </div>

  <style>
    #Tabs-{{ section.id }} .pc-tabs__wrap{
      border: 2px solid #000;
      padding: 26px 28px;
      background: #fff;
    }

    #Tabs-{{ section.id }} .pc-tabs__nav{
      display: flex;
      gap: 34px;
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border-bottom: 0;
      padding-bottom: 10px;
    }
    #Tabs-{{ section.id }} .pc-tabs__nav::-webkit-scrollbar{ display:none; }
    #Tabs-{{ section.id }} .pc-tabs__nav{ scrollbar-width:none; }

    #Tabs-{{ section.id }} .pc-tabs__tab{
      appearance: none;
      background: transparent;
      border: 0;
      padding: 0 0 10px;
      cursor: pointer;

      /* subhead look */
      font-family: "Geomanist", sans-serif;
      font-weight: 500;
      font-size: 16px;
      text-transform: uppercase;
      letter-spacing: .06em;

      color: #000;
      position: relative;
      white-space: nowrap;
    }

    #Tabs-{{ section.id }} .pc-tabs__tab.is-active::after{
      content:"";
      position:absolute;
      left:0;
      bottom:0;
      height: 3px;
      width: 100%;
      background: #000;
    }

    #Tabs-{{ section.id }} .pc-tabs__panels{
      padding-top: 18px;
    }

    #Tabs-{{ section.id }} .pc-tabs__panel{
      font-family: "Geomanist", sans-serif;
      font-weight: 400;
      color: #000;
    }

    /* simple spacing for rich text */
    #Tabs-{{ section.id }} .pc-tabs__panel p{ margin: 0 0 12px; }
    #Tabs-{{ section.id }} .pc-tabs__panel ul{ margin: 0 0 12px 20px; }

    @media (max-width: 768px){
      #Tabs-{{ section.id }} .pc-tabs__wrap{ padding: 18px 16px; }
      #Tabs-{{ section.id }} .pc-tabs__tab{ font-size: 14px; }
      #Tabs-{{ section.id }} .pc-tabs__nav{ gap: 22px; }
    }
  </style>

  <script>
    (function() {
      var root = document.getElementById("Tabs-{{ section.id }}");
      if (!root) return;

      var tabs = root.querySelectorAll('[role="tab"]');
      var panels = root.querySelectorAll('[role="tabpanel"]');

      function activateTab(tabEl) {
        var panelId = tabEl.getAttribute('data-panel');

        tabs.forEach(function(t){
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
          t.setAttribute('tabindex', '-1');
        });

        panels.forEach(function(p){
          p.classList.remove('is-active');
          p.hidden = true;
        });

        tabEl.classList.add('is-active');
        tabEl.setAttribute('aria-selected', 'true');
        tabEl.setAttribute('tabindex', '0');

        var panel = root.querySelector('#' + CSS.escape(panelId));
        if (panel) {
          panel.classList.add('is-active');
          panel.hidden = false;
        }

        // Optional: reviews scroll behavior for tabs set as "reviews_anchor"
        if (tabEl.dataset.scrollSelector) {
          var target = document.querySelector(tabEl.dataset.scrollSelector);
          if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      tabs.forEach(function(tab){
        tab.addEventListener('click', function(){
          // If this is a "reviews_anchor" tab, the panel is intentionally empty.
          // You can set data-scroll-selector via theme editor using custom liquid if needed.
          activateTab(tab);
        });

        tab.addEventListener('keydown', function(e){
          var idx = Array.prototype.indexOf.call(tabs, tab);
          if (e.key === 'ArrowRight') {
            e.preventDefault();
            var next = tabs[idx + 1] || tabs[0];
            next.focus(); activateTab(next);
          }
          if (e.key === 'ArrowLeft') {
            e.preventDefault();
            var prev = tabs[idx - 1] || tabs[tabs.length - 1];
            prev.focus(); activateTab(prev);
          }
        });
      });

      // Ensure first is active
      if (tabs[0]) {
        tabs[0].setAttribute('tabindex', '0');
      }
    })();
  </script>
</section>

{% schema %}
{
  "name": "Product tabs (Guidelines)",
  "settings": [],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "title", "label": "Tab title", "default": "Overview" },
        {
          "type": "select",
          "id": "content_type",
          "label": "Content source",
          "default": "product_description",
          "options": [
            { "value": "product_description", "label": "Product description" },
            { "value": "metafield", "label": "Metafield (per product)" },
            { "value": "page", "label": "Page content" },
            { "value": "custom", "label": "Custom rich text" },
            { "value": "reviews_anchor", "label": "Reviews (scroll to reviews section)" }
          ]
        },
        { "type": "text", "id": "metafield_namespace", "label": "Metafield namespace (e.g. custom)", "default": "custom" },
        { "type": "text", "id": "metafield_key", "label": "Metafield key (e.g. important_notes)" },
        { "type": "page", "id": "page", "label": "Select page" },
        { "type": "richtext", "id": "custom_richtext", "label": "Custom content" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Product tabs (Guidelines)",
      "blocks": [
        { "type": "tab", "settings": { "title": "Overview", "content_type": "product_description" } },
        { "type": "tab", "settings": { "title": "Important Notes", "content_type": "metafield", "metafield_namespace": "custom", "metafield_key": "important_notes" } },
        { "type": "tab", "settings": { "title": "Installation", "content_type": "metafield", "metafield_namespace": "custom", "metafield_key": "installation" } },
        { "type": "tab", "settings": { "title": "Specification", "content_type": "metafield", "metafield_namespace": "custom", "metafield_key": "specification" } },
        { "type": "tab", "settings": { "title": "Fitment", "content_type": "metafield", "metafield_namespace": "custom", "metafield_key": "fitment" } },
        { "type": "tab", "settings": { "title": "Reviews", "content_type": "reviews_anchor" } }
      ]
    }
  ]
}
{% endschema %}
