{% liquid
  assign sid = section.id
  assign columns = section.blocks | where: 'type', 'column'
  assign rows = section.blocks | where: 'type', 'row'
  assign col_count = columns.size

  assign layout_width = section.settings.layout_width
  assign cw = section.settings.container_width | default: '1200' | strip
  assign container_style = '100%'

  if layout_width == 'fixed'
    assign has_unit = false
    if cw contains 'px' or cw contains '%' or cw contains 'rem' or cw contains 'em' or cw contains 'vw'
      assign has_unit = true
    endif
    if has_unit
      assign container_style = cw
    else
      assign container_style = cw | append: 'px'
    endif
  endif

  assign bg_opacity = section.settings.bg_opacity | default: 70
  assign bg_alpha = bg_opacity | times: 0.01
  assign anchor_id = section.settings.anchor_id | default: '' | strip
%}

<section
  class="jl-compare jl-compare--{{ sid }}"
  {% if anchor_id != blank %}id="{{ anchor_id }}"{% endif %}
  style="
    --jl-maxw: {{ container_style }};
    --jl-text: {{ section.settings.text_color }};
    --jl-border: {{ section.settings.border_color }};
    --jl-head-bg: {{ section.settings.header_bg_color }};
    --jl-head-text: {{ section.settings.header_text_color }};
    --jl-row-bg: {{ section.settings.row_bg_color }};
    --jl-row-alt-bg: {{ section.settings.row_alt_bg_color }};
    --jl-radius: {{ section.settings.radius }}px;
  "
>
  <div class="jl-compare__bg" style="background: {{ section.settings.bg_color }}; opacity: {{ bg_alpha }};"></div>

  <div class="jl-compare__inner">
    {% if section.settings.heading != blank %}
      <h2 class="jl-compare__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="jl-compare__scroller" role="region" aria-label="{{ section.settings.heading | escape }}">
      {% if col_count == 0 or rows.size == 0 %}
        <div class="jl-compare__empty">
          Add at least 1 <strong>Column</strong> and 1 <strong>Row</strong> block in the theme editor.
        </div>
      {% else %}
        <table class="jl-compare__table">
          <thead>
            <tr>
              <th class="jl-sticky-col jl-sticky-head jl-compare__th jl-compare__th--first">
                {{ section.settings.details_heading }}
              </th>

              {% for col in columns %}
                <th class="jl-sticky-head jl-compare__th">
                  {{ col.settings.title }}
                </th>
              {% endfor %}
            </tr>
          </thead>

          <tbody>
            {% for row in rows %}
              <tr class="jl-compare__tr">
                <th class="jl-sticky-col jl-compare__th jl-compare__th--row">
                  {{ row.settings.label }}
                </th>

                {% for i in (1..6) %}
                  {% if i <= col_count %}
                    {% assign key = 'value_' | append: i %}
                    {% assign val = row.settings[key] | default: '' | strip %}
                    {% assign val_down = val | downcase %}

                    <td class="jl-compare__td">
                      {% if val_down == 'yes' or val_down == 'true' or val_down == 'check' or val == '✓' %}
                        <span class="jl-icon jl-icon--check" aria-label="Yes">✓</span>
                      {% elsif val_down == 'no' or val_down == 'false' or val_down == 'x' or val == '✗' %}
                        <span class="jl-icon jl-icon--x" aria-label="No">✗</span>
                      {% else %}
                        {{ val }}
                      {% endif %}
                    </td>
                  {% endif %}
                {% endfor %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}
    </div>
  </div>

  <style>
    .jl-compare--{{ sid }}{
      position: relative;
      color: var(--jl-text);
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
    .jl-compare--{{ sid }} .jl-compare__bg{
      position:absolute; inset:0;
      pointer-events:none;
      z-index:0;
    }
    .jl-compare--{{ sid }} .jl-compare__inner{
      position:relative; z-index:1;
      max-width: var(--jl-maxw);
      margin: 0 auto;
      padding: 0 16px;
    }
    .jl-compare--{{ sid }} .jl-compare__heading{
      margin: 0 0 18px;
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    .jl-compare--{{ sid }} .jl-compare__scroller{
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border: 1px solid var(--jl-border);
      border-radius: var(--jl-radius);
      background: transparent;
    }

    .jl-compare--{{ sid }} .jl-compare__table{
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      min-width: 900px; /* makes mobile swipe feel like the reference */
    }

    .jl-compare--{{ sid }} .jl-compare__th,
    .jl-compare--{{ sid }} .jl-compare__td{
      padding: 14px 16px;
      text-align: left;
      border-bottom: 1px solid var(--jl-border);
      vertical-align: top;
      white-space: normal;
    }

    .jl-compare--{{ sid }} thead .jl-compare__th{
      background: var(--jl-head-bg);
      color: var(--jl-head-text);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-size: 12px;
    }

    .jl-compare--{{ sid }} tbody .jl-compare__tr:nth-child(odd) .jl-compare__td,
    .jl-compare--{{ sid }} tbody .jl-compare__tr:nth-child(odd) .jl-compare__th--row{
      background: var(--jl-row-bg);
    }
    .jl-compare--{{ sid }} tbody .jl-compare__tr:nth-child(even) .jl-compare__td,
    .jl-compare--{{ sid }} tbody .jl-compare__tr:nth-child(even) .jl-compare__th--row{
      background: var(--jl-row-alt-bg);
    }

    /* Sticky header row */
    .jl-compare--{{ sid }} .jl-sticky-head{
      position: sticky;
      top: 0;
      z-index: 5;
    }

    /* Sticky first column ("Details") */
    .jl-compare--{{ sid }} .jl-sticky-col{
      position: sticky;
      left: 0;
      z-index: 6;
    }
    .jl-compare--{{ sid }} thead .jl-sticky-col{
      z-index: 7; /* above other sticky cells */
    }

    .jl-compare--{{ sid }} .jl-compare__th--first{
      min-width: 210px;
    }
    .jl-compare--{{ sid }} .jl-compare__td{
      min-width: 160px;
    }

    .jl-compare--{{ sid }} .jl-icon{
      display: inline-flex;
      font-weight: 800;
      font-size: 18px;
      line-height: 1;
    }

    /* Mobile tweaks */
    @media (max-width: 767px){
      .jl-compare--{{ sid }} .jl-compare__inner{ padding: 0 12px; }
      .jl-compare--{{ sid }} .jl-compare__table{ min-width: 820px; }
      .jl-compare--{{ sid }} .jl-compare__th,
      .jl-compare--{{ sid }} .jl-compare__td{ padding: 12px 12px; }
    }

    /* Rounded corners */
    .jl-compare--{{ sid }} thead tr th:first-child{ border-top-left-radius: var(--jl-radius); }
    .jl-compare--{{ sid }} thead tr th:last-child{ border-top-right-radius: var(--jl-radius); }
    .jl-compare--{{ sid }} tbody tr:last-child th:first-child{ border-bottom-left-radius: var(--jl-radius); }
    .jl-compare--{{ sid }} tbody tr:last-child td:last-child{ border-bottom-right-radius: var(--jl-radius); }
    .jl-compare--{{ sid }} tbody tr:last-child th,
    .jl-compare--{{ sid }} tbody tr:last-child td{ border-bottom: 0; }

    .jl-compare--{{ sid }} .jl-compare__empty{
      padding: 18px;
    }
  </style>
</section>

{% schema %}
{
  "name": "Compare / Specification",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "GVM Upgrade Comparison" },
    { "type": "text", "id": "details_heading", "label": "Left column heading", "default": "Details" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID (optional)", "default": "compare-Ranger" },

    {
      "type": "select",
      "id": "layout_width",
      "label": "Layout width",
      "default": "fixed",
      "options": [
        { "value": "fixed", "label": "Fixed (centered)" },
        { "value": "full", "label": "Full width" }
      ]
    },
    {
      "type": "text",
      "id": "container_width",
      "label": "Container width (px) when fixed",
      "default": "1200",
      "info": "Number only (example: 1200). You can also type 100% or 1200px."
    },

    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" },
    { "type": "color", "id": "border_color", "label": "Border color", "default": "#dddddd" },

    { "type": "color", "id": "bg_color", "label": "Section background color", "default": "#ffffff" },
    { "type": "range", "id": "bg_opacity", "label": "Background opacity", "min": 0, "max": 100, "step": 1, "default": 0 },

    { "type": "color", "id": "header_bg_color", "label": "Header background", "default": "#ffffff" },
    { "type": "color", "id": "header_text_color", "label": "Header text color", "default": "#111111" },

    { "type": "color", "id": "row_bg_color", "label": "Row background (odd)", "default": "#ffffff" },
    { "type": "color", "id": "row_alt_bg_color", "label": "Row background (even)", "default": "#ffffff" },

    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 30, "step": 1, "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 20 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 20 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "text", "id": "title", "label": "Column title", "default": "Factory" }
      ]
    },
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "label", "label": "Row label", "default": "GVM" },

        { "type": "text", "id": "value_1", "label": "Value (Column 1)", "default": "3,300kg" },
        { "type": "text", "id": "value_2", "label": "Value (Column 2)", "default": "3,650kg" },
        { "type": "text", "id": "value_3", "label": "Value (Column 3)", "default": "3,650kg" },
        { "type": "text", "id": "value_4", "label": "Value (Column 4)", "default": "3,850kg" },
        { "type": "text", "id": "value_5", "label": "Value (Column 5)" },
        { "type": "text", "id": "value_6", "label": "Value (Column 6)" },

        { "type": "paragraph", "content": "Tip: Use ✓ / ✗ (or type check / x) for checkmark/cross." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Compare / Specification",
      "blocks": [
        { "type": "column", "settings": { "title": "Factory" } },
        { "type": "column", "settings": { "title": "3.65T LTZ" } },
        { "type": "column", "settings": { "title": "3.65T ZR2" } },
        { "type": "column", "settings": { "title": "3.85T" } },

        { "type": "row", "settings": { "label": "GVM", "value_1": "3,300kg", "value_2": "3,650kg", "value_3": "3,650kg", "value_4": "3,850kg" } },
        { "type": "row", "settings": { "label": "Payload", "value_1": "757kg", "value_2": "1,107kg", "value_3": "1,067kg", "value_4": "1,294kg" } },
        { "type": "row", "settings": { "label": "Requires Wheel/Tyre Upgrade", "value_1": "✗", "value_2": "✗", "value_3": "✗", "value_4": "✗" } }
      ]
    }
  ]
}
{% endschema %}
