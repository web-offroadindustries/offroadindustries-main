{{ 'header.css' | asset_url | stylesheet_tag }}
{{ 'site-nav.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign layout = section.settings.layout
  assign sticky_type = section.settings.sticky_type | default: 'on-scroll-up'
  assign transparent_header = section.settings.transparent_header
  assign logo_mobile_position = section.settings.logo_mobile_position

  unless template.name == 'index'
    assign transparent_header = false
  endunless
-%}
<header
  data-section-id="{{ section.id }}"
  data-section-type="header"
  class="header site-header site-header--{{ section.settings.layout }}{% if transparent_header %} site-header--transparent{% endif %} color-{{ section.settings.color_schema }} show-dropdown-menu-on-{{ section.settings.dropdown_menu_trigger }}"
  data-header-color-scheme="color-{{ section.settings.color_schema }}"
  data-dropdown-color-scheme="color-{{ section.settings.menu_dropdown_color_schema }}"
  data-header-transparent="{{ transparent_header }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;--logo-width: {{ section.settings.logo_width }}px; --logo-mobile-width: {{ section.settings.logo_mobile_width }}px;"
  {% if section.settings.sticky_header %}
    is="sticky-header"
    data-sticky-type="{{ sticky_type }}"
  {% else %}
    is="basic-header"
  {% endif %}
>
  <div class="f-header__dropdown-backdrop">
    <div class="f-header__dropdown-overlay"></div>
    <div
      class="f-header__dropdown-bg color-{{ section.settings.menu_dropdown_color_schema }}"
    ></div>
  </div>
  <div class="{{ section.settings.container | default: "container" }}">
    {%- case layout -%}
      {%- when 'design-2' -%}
        <div class="site-header__inner flex site-header__mobile-logo--{{ logo_mobile_position | default: 'left' }}">
          <drawer-opener
            class="mobile-nav-toggle hidden lg-down:flex no-js-hidden"
            data-drawer="#Drawer-MobileNav"
          >
            <button
              class="btn btn--plain focus-inset"
              aria-haspopup="dialog"
              aria-label="{{ 'layout.navigation.expand' | t }}"
            >
              {% comment %} theme-check-disable {% endcomment %}
              {{ 'icon-hamburger.svg' | inline_asset_content }}
              {% comment %} theme-check-enable {% endcomment %}
            </button>
          </drawer-opener>
          <div class="site-header__left site-header__menu hidden lg:flex">
            {% render 'site-nav', section: section %}
          </div>
          <div class="site-header__center site-header__center--max flex items-center md:justify-center">
            {% render 'site-logo', section: section %}
          </div>
          <div class="site-header__right">
            {% render 'header__promo-badge', section: section %}
            {% render 'header__addons',
              section: section,
              color_schema: section.settings.color_schema
            %}
          </div>
        </div>
      {%- when 'design-3' -%}
        <div class="site-header__inner flex site-header__mobile-logo--{{ logo_mobile_position | default: 'left' }}">
          <drawer-opener
            class="mobile-nav-toggle hidden lg-down:flex no-js-hidden"
            data-drawer="#Drawer-MobileNav"
          >
            <button
              class="btn btn--plain focus-inset"
              aria-haspopup="dialog"
              aria-label="{{ 'layout.navigation.expand' | t }}"
            >
              {% comment %} theme-check-disable {% endcomment %}
              {{ 'icon-hamburger.svg' | inline_asset_content }}
              {% comment %} theme-check-enable {% endcomment %}
            </button>
          </drawer-opener>
          <div class="site-header__left site-header__menu hidden lg:flex">
            {% render 'header__search',
              section: section,
              color_schema: section.settings.color_schema
            %}
            {% render 'site-nav', section: section, menu_part: 'first' %}
          </div>
          <div class="site-header__center site-header__center--max flex items-center md:justify-center">
            {% render 'site-logo', section: section %}
          </div>
          <div class="site-header__right">
            {% render 'site-nav', section: section, menu_part: 'last' %}
            {% render 'header__promo-badge', section: section %}
            {% render 'header__addons',
              section: section,
              color_schema: section.settings.color_schema
            %}
          </div>
        </div>
      {%- when 'design-4' -%}
        <div class="site-header__inner flex site-header__mobile-logo--{{ logo_mobile_position | default: 'left' }}">
          <drawer-opener
            class="mobile-nav-toggle hidden lg-down:flex no-js-hidden"
            data-drawer="#Drawer-MobileNav"
          >
            <button
              class="btn btn--plain focus-inset"
              aria-haspopup="dialog"
              aria-label="{{ 'layout.navigation.expand' | t }}"
            >
              {% comment %} theme-check-disable {% endcomment %}
              {{ 'icon-hamburger.svg' | inline_asset_content }}
              {% comment %} theme-check-enable {% endcomment %}
            </button>
          </drawer-opener>
          <div class="site-header__left flex items-center">
            {% render 'site-logo', section: section %}
          </div>
          <div class="site-header__center site-header__menu hidden lg:flex">
            {% render 'site-nav', section: section %}
          </div>
          <div class="site-header__right">
            {% render 'header__promo-badge', section: section %}
            {% render 'header__addons',
              section: section,
              color_schema: section.settings.color_schema
            %}
          </div>
        </div>
      {%- when 'design-5' -%}
        <div class="site-header__inner flex site-header__mobile-logo--{{ logo_mobile_position | default: 'left' }}">
          <drawer-opener
            class="mobile-nav-toggle hidden lg-down:flex no-js-hidden"
            data-drawer="#Drawer-MobileNav"
          >
            <button
              class="btn btn--plain focus-inset"
              aria-haspopup="dialog"
              aria-label="{{ 'layout.navigation.expand' | t }}"
            >
              {% comment %} theme-check-disable {% endcomment %}
              {{ 'icon-hamburger.svg' | inline_asset_content }}
              {% comment %} theme-check-enable {% endcomment %}
            </button>
          </drawer-opener>
          <div class="site-header__left site-header__menu hidden lg:flex">
            {% render 'site-nav', section: section, menu_part: 'first' %}
          </div>
          <div class="site-header__center site-header__center--max flex items-center md:justify-center">
            {% render 'site-logo', section: section %}
          </div>
          <div class="site-header__right flex-wrap">
            {% render 'site-nav', section: section, menu_part: 'last' %}
            {% render 'header__promo-badge', section: section %}
            {% render 'header__addons',
              section: section,
              color_schema: section.settings.color_schema
            %}
          </div>
        </div>
      {%- when 'design-6' -%}
        <div
          class="site-header__inner site-header__inner--v6 site-header__mobile-logo--{{ logo_mobile_position | default: 'left' }}"
          style="
            --v6-search-max: {{ section.settings.v6_search_max_width }}px;
            --v6-search-height: {{ section.settings.v6_search_height }}px;
            --v6-search-font: {{ section.settings.v6_search_font_size }}px;
            --v6-help-label: {{ section.settings.v6_help_label_size }}px;
            --v6-help-phone: {{ section.settings.v6_help_phone_size }}px;
          "
        >
          <div class="site-header__top-v6">
            <drawer-opener
              class="mobile-nav-toggle hidden lg-down:flex no-js-hidden"
              data-drawer="#Drawer-MobileNav"
            >
              <button
                class="btn btn--plain focus-inset"
                aria-haspopup="dialog"
                aria-label="{{ 'layout.navigation.expand' | t }}"
              >
                {% comment %} theme-check-disable {% endcomment %}
                {{ 'icon-hamburger.svg' | inline_asset_content }}
                {% comment %} theme-check-enable {% endcomment %}
              </button>
            </drawer-opener>

            <div class="site-header__top-left-v6">
              {% render 'site-logo', section: section %}
            </div>

            <div class="site-header__top-nav-v6 hidden lg:flex">
              {% render 'site-nav', section: section %}
            </div>

            {% render 'header__promo-badge', section: section %}

            {% if section.settings.show_v6_search %}
            <div class="site-header__top-search-v6 hidden lg:block">
              <form action="{{ routes.search_url }}" method="get" role="search" class="header-v6-search">
                <label class="visually-hidden" for="HeaderSearch-{{ section.id }}">
                  {{ 'general.search.search' | t }}
                </label>

                <input
                  id="HeaderSearch-{{ section.id }}"
                  class="header-v6-search__input snize-exclude-input"
                  type="search"
                  name="q"
                  placeholder="{{ 'general.search.placeholder' | t }}"
                >
                <input type="hidden" name="options[prefix]" value="last">

                <button type="submit" class="header-v6-search__btn" aria-label="{{ 'general.search.search' | t }}">
                  <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" role="presentation" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                </button>
              </form>
            </div>
            {% endif %}

            <div class="site-header__top-right-v6">
              {% if section.settings.show_help_block %}
                {% assign phone_raw = section.settings.help_phone | strip %}
                {% assign phone_href = phone_raw | replace: " ", "" | replace: "(", "" | replace: ")", "" | replace: "-", "" %}
                <div class="header-v6-help hidden lg:flex">
                  <div class="header-v6-help__label">{{ section.settings.help_label }}</div>
                  <a class="header-v6-help__phone" href="tel:{{ phone_href }}">{{ phone_raw }}</a>
                </div>
              {% endif %}

              {% render 'header__addons',
                section: section,
                color_schema: section.settings.color_schema,
                hide_desktop_search: true
              %}
            </div>
          </div>

        </div>
      {%- else -%}
        <div class="site-header__inner flex site-header__mobile-logo--{{ logo_mobile_position | default: 'left' }}">
          <drawer-opener
            class="mobile-nav-toggle hidden lg-down:flex no-js-hidden"
            data-drawer="#Drawer-MobileNav"
          >
            <button
              class="btn btn--plain focus-inset"
              aria-haspopup="dialog"
              aria-label="{{ 'layout.navigation.expand' | t }}"
            >
              {% comment %} theme-check-disable {% endcomment %}
              {{ 'icon-hamburger.svg' | inline_asset_content }}
              {% comment %} theme-check-enable {% endcomment %}
            </button>
          </drawer-opener>
          <div class="site-header__left flex items-center">
            {% render 'site-logo', section: section %}
          </div>
          <div class="site-header__center site-header__menu hidden lg:flex">
            {% render 'site-nav',
              section: section,
              split: true,
              split_part: 'first'
            %}
          </div>
          <div class="site-header__right">
            {% render 'header__promo-badge', section: section %}
            {% render 'header__addons',
              section: section,
              color_schema: section.settings.color_schema
            %}
          </div>
        </div>
    {%- endcase -%}
  </div>
</header>
{%- liquid
  assign form_id = section.id | append: '_mobile-nav'
  assign mobile_menu = section.settings.mobile_menu | default: section.settings.main_menu
  assign menu_links = linklists[mobile_menu].links
  assign show_language_selector = section.settings.show_language_selector
  assign show_country_selector = section.settings.show_country_selector
  assign show_social = section.settings.mobile_show_social
  assign show_addons_switcher = false
  if show_language_selector or show_country_selector
    assign show_addons_switcher = true
  endif

  assign account_url = routes.account_login_url | append: '?return_to=/pages/b2b-catalog'
  assign account_text = 'layout.customer.log_in' | t

  if customer
    assign account_url = routes.account_url
    assign account_text = 'layout.customer.account' | t
  endif
-%}
{%- unless mobile_menu and menu_links.size == 0 -%}
  <script src="{{ 'mobile-nav.js' | asset_url }}" defer="defer"></script>
  <div class="hidden no-js-hidden xl-down:block">
    <drawer-component
      id="Drawer-MobileNav"
      class="f-drawer f-drawer--left f-drawer-mobile-nav"
      hidden
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'layout.navigation.menu' | t }}"
      style="--f-drawer-width: 460px;"
    >
      <div class="f-drawer__overlay" data-drawer-overlay=""></div>
      <div class="f-drawer__content focus-inset" tabindex="-1">
        <div class="scroll-container">
          <div id="Mobile-Nav" class="f-mobile-nav" role="navigation">
            <button
              id="DrawerClose-Mobile-Nav"
              class="f-drawer__close btn btn--plain"
              aria-label="{{ 'accessibility.close' | t }}"
            >
              {% comment %} theme-check-disable {% endcomment %}
              {{ 'icon-close.svg' | inline_asset_content }}
              {% comment %} theme-check-enable {% endcomment %}
            </button>
            {% render 'site-logo', section: section, h1_tag: false %}
            {% render 'header__promo-badge', section: section, mobile_mode: true %}
            <div class="f-mobile-nav__inner">
              <ul class="list-none">
                {% for link in menu_links %}
                  {% liquid
                    assign li_class = 'f-mobile-nav__item'
                    if link.links != blank
                      if link.levels == 2
                      endif
                    endif

                    if link.active
                      assign li_class = li_class | append: ' f-mobile-nav__item--current'
                    endif
                    if link.links != blank
                      assign li_class = li_class | append: ' f-mobile-nav__item--has-child'
                    endif
                  %}
                  <li
                    class="{{ li_class }}"
                    {% if link.links != blank %}
                      data-menu-toggle-item
                    {% endif %}
                    data-collapsible-parent
                  >
                    <a href="{{ link.url }}" class="f-mobile-nav__link">
                      {{ link.title }}
                    </a>
                    {% if link.links != blank %}
                      <collapsible-tab>
                        <span class="f-mobile-nav__arrow" data-trigger>
                          <span class="no-js-hidden f-mobile-nav__arrow-icon">
                            <svg
                              width="2"
                              height="12"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path d="M1 1.333v9.334" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <svg
                              width="2"
                              height="12"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path d="M1 1.333v9.334" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </span>
                        </span>
                        <div class="f-mobile-nav__dropdown" data-content>
                          <ul class="list-none w-full">
                            {% for childlink in link.links %}
                              <li
                                class="f-mobile-nav__subitem{% if childlink.links != blank %} f-mobile-nav__sub-item--has-child{% endif %}"
                                {% if childlink.links != blank %}
                                  data-menu-toggle-item
                                {% endif %}
                                data-collapsible-parent
                              >
                                <a
                                  href="{{ childlink.url }}"
                                  class="f-mobile-nav__sub-link"
                                >
                                  {{- childlink.title -}}
                                </a>
                                {% if childlink.links != blank %}
                                  <collapsible-tab>
                                    <span
                                      class="f-mobile-nav__arrow"
                                      data-trigger
                                    >
                                      <span class="no-js-hidden f-mobile-nav__arrow-icon">
                                        <svg
                                          width="2"
                                          height="12"
                                          fill="none"
                                          xmlns="http://www.w3.org/2000/svg"
                                        >
                                          <path d="M1 1.333v9.334" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        <svg
                                          width="2"
                                          height="12"
                                          fill="none"
                                          xmlns="http://www.w3.org/2000/svg"
                                        >
                                          <path d="M1 1.333v9.334" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                      </span>
                                    </span>
                                    <div
                                      class="f-mobile-nav__dropdown f-mobile-nav__dropdown--level3"
                                      data-content
                                    >
                                      <ul class="list-none">
                                        {% for grandlink in childlink.links %}
                                          <li class="f-mobile-nav__sub-item f-mobile-nav__sub-item--level3">
                                            <a
                                              href="{{ grandlink.url }}"
                                              class="f-mobile-nav__sub-link"
                                            >
                                              {{- grandlink.title -}}
                                            </a>
                                          </li>
                                        {% endfor %}
                                      </ul>
                                    </div>
                                  </collapsible-tab>
                                {% endif %}
                              </li>
                            {% endfor %}
                          </ul>
                        </div>
                      </collapsible-tab>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </div>
            <div class="f-mobile-nav__addons">
              {% if show_addons_switcher %}
                <div class="f-mobile-nav__addons-switcher">
                  {% if show_language_selector %}
                    {% render 'language-selector',
                      position: 'up',
                      form_id: form_id,
                      class: 'addon-switcher__item w-full',
                      plain: true
                    %}
                  {% endif %}
                  {% if show_country_selector %}
                    {% render 'country-selector',
                      position: 'up',
                      form_id: form_id,
                      class: 'addon-switcher__item w-full',
                      plain: true
                    %}
                  {% endif %}
                </div>
              {% endif %}
              {% if shop.customer_accounts_enabled %}
                <a
                  class="f-mobile-nav__addons-user-link btn btn--primary w-full"
                  href="{{ account_url }}"
                >
                  <span>{{ account_text }}</span>
                </a>
              {% endif %}
              {%- if customer -%}
                <a
                  class="f-mobile-nav__addons-user-link btn btn--outline w-full"
                  href="{{ routes.account_logout_url }}"
                >
                  <span>Log Out</span>
                </a>
              {%- endif -%}
              {% if show_social %}
                {% render 'social-links' %}
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </drawer-component>
  </div>
{%- endunless -%}
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if section.settings.logo %}
      {% assign image_size = section.settings.logo.width %}
      "logo": {{ section.settings.logo | image_url: width: image_size | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ shop.url | append: page.url | json }}
  }
</script>
<script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = shop.url
    | append: routes.search_url
    | append: '?q={search_term_string}'
  %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ shop.url | append: page.url | json }}
    }
  </script>
{%- endif -%}
{% schema %}
{
  "name": "t:sections.header.name",
  "class": "f-section-header",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.header.settings.tutorial.content"
    },
    {
      "type": "color_scheme",
      "id": "color_schema",
      "label": "t:sections.common.color_schema.label",
      "default": "background-1"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "design-1",
          "label": "t:sections.header.settings.layout.options__1.label"
        },
        {
          "value": "design-2",
          "label": "t:sections.header.settings.layout.options__2.label"
        },
        {
          "value": "design-3",
          "label": "t:sections.header.settings.layout.options__3.label"
        },
        {
          "value": "design-4",
          "label": "t:sections.header.settings.layout.options__4.label"
        },
        {
          "value": "design-5",
          "label": "t:sections.header.settings.layout.options__5.label"
        },
        {
          "value": "design-6",
          "label": "Design 6 (Logo + Search + Help row, Menu below)"
        }
      ],
      "default": "design-1",
      "label": "t:sections.header.settings.layout.label"
    },
    {
      "type": "select",
      "id": "container",
      "options": [
        {
          "value": "container",
          "label": "t:sections.common.container.fixed"
        },
        {
          "value": "container-fluid",
          "label": "t:sections.common.container.stretched"
        },
        {
          "value": "container-full",
          "label": "t:sections.common.container.fullwidth"
        }
      ],
      "default": "container",
      "label": "t:sections.common.container.label"
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "t:sections.header.settings.layout.sticky_header.label",
      "default": true
    },
    {
      "type": "select",
      "id": "sticky_type",
      "options": [
        {
          "value": "on-scroll-up",
          "label": "t:sections.header.settings.sticky_type.options__1.label"
        },
        {
          "value": "always",
          "label": "t:sections.header.settings.sticky_type.options__2.label"
        }
      ],
      "default": "on-scroll-up",
      "label": "t:sections.header.settings.sticky_type.label",
      "visible_if": "{{ section.settings.sticky_header == true }}"
    },
    {
      "type": "checkbox",
      "id": "transparent_header",
      "label": "t:sections.header.settings.layout.transparent_header.label",
      "default": false,
      "info": "t:sections.header.settings.layout.transparent_header.info"
    },
    {
      "type": "header",
      "content": "t:sections.header.settings.logo.header"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.header.settings.logo.label"
    },
    {
      "type": "image_picker",
      "id": "logo_transparent",
      "label": "t:sections.header.settings.logo.label_transparent"
    },
    {
      "type": "image_picker",
      "id": "logo_mobile",
      "label": "t:sections.header.settings.logo.label_mobile"
    },
    {
      "type": "image_picker",
      "id": "logo_on_dropdown_menu",
      "label": "t:sections.header.settings.logo.label_on_dropdown"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 5,
      "default": 125,
      "unit": "t:sections.header.settings.logo_width.unit",
      "label": "t:sections.header.settings.logo_width.label"
    },
    {
      "type": "range",
      "id": "logo_mobile_width",
      "min": 30,
      "max": 150,
      "step": 2,
      "default": 110,
      "unit": "t:sections.header.settings.logo_width.unit",
      "label": "t:sections.header.settings.logo_width.label_mobile"
    },
    {
      "type": "header",
      "content": "t:sections.header.settings.menu.header"
    },
