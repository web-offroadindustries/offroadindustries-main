{%- comment -%}
  ORI GVM Key Benefits.

  Split out of the ORI GVM Product section so merchants can edit, reorder and
  remove it on its own. The markup is deliberately identical to the band it
  replaces: every rule in ori-gvm-product.css is scoped as
  `.ori-gvm-product--<layout> .ori-gvm-product__band--benefits ...`, so the
  wrapper below has to keep both the layout class and the band class for the
  styling to apply.

  Keep the Layout style setting matching the ORI GVM Product section above it,
  otherwise the two halves of the page will not look related.
{%- endcomment -%}

{{ 'ori-gvm-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_id = section.settings.custom_id | default: section.id
  assign container = section.settings.container | default: 'container'
  assign cards_per_row = section.settings.cards_per_row | default: 3
  assign benefits = section.blocks | where: 'type', 'benefit'
-%}

{%- if benefits.size > 0 -%}
  <div
    id="{{ section_id }}"
    class="ori-gvm-product ori-gvm-product--{{ section.settings.layout | default: 'classic' }} color-{{ section.settings.color_schema }}{% if section.settings.mobile_slider %} ori-gvm-product--swipe{% endif %}"
    data-section-type="ori-gvm-benefits"
    style="--gvm-tint: {{ section.settings.tint_color | default: '#f3f6f7' }};"
  >
    <div
      class="ori-gvm-product__band ori-gvm-product__band--benefits{% if section.settings.alt_background %} ori-gvm-product__band--alt{% endif %}"
      style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
    >
      <div class="{{ container }}">
        <div class="ori-gvm-product__block ori-gvm-product__block--wide">
          {%- if section.settings.heading != blank -%}
            <h2 class="ori-gvm-product__block-title h3">{{ section.settings.heading }}</h2>
          {%- endif -%}
          <ul class="ori-gvm-product__cards" style="--gvm-cards: {{ cards_per_row }};" role="list">
            {%- for block in benefits -%}
              <li class="ori-gvm-product__card" {{ block.shopify_attributes }}>
                <span class="ori-gvm-product__card-media">
                  <span class="ori-gvm-product__badge" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                </span>
                <span class="ori-gvm-product__card-body">
                  <span class="ori-gvm-product__card-title">{{ block.settings.text }}</span>
                  {%- if block.settings.note != blank -%}
                    <span class="ori-gvm-product__card-note">{{ block.settings.note }}</span>
                  {%- endif -%}
                </span>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "ORI GVM Key Benefits",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Key benefits" },
    { "type": "header", "content": "Layout style" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout style",
      "info": "Match this to the ORI GVM Product section on the same page.",
      "options": [
        { "value": "classic", "label": "Classic (light, centred)" },
        { "value": "editorial", "label": "Technical (engineering plate)" }
      ],
      "default": "classic"
    },
    {
      "type": "checkbox",
      "id": "mobile_slider",
      "label": "Swipe rows on mobile",
      "info": "Turns the row into a swipeable slider on phones instead of stacking it.",
      "default": false
    },
    {
      "type": "range",
      "id": "cards_per_row",
      "label": "Cards per row (desktop)",
      "info": "Ignored on the Technical layout, which always runs one benefit per row.",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    { "type": "header", "content": "Appearance" },
    { "type": "checkbox", "id": "alt_background", "label": "Use tinted background", "default": true },
    { "type": "color", "id": "tint_color", "label": "Tint colour", "default": "#f3f6f7" },
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "options": [
        { "value": "container", "label": "Fixed (1200px)" },
        { "value": "container-narrow", "label": "Narrow" },
        { "value": "container-full", "label": "Full width" }
      ],
      "default": "container"
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "text", "id": "custom_id", "label": "Custom HTML ID" },
    { "type": "text", "id": "color_schema", "label": "Color scheme class" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Key benefit",
      "settings": [
        { "type": "text", "id": "text", "label": "Benefit", "default": "Increased legal payload" },
        { "type": "text", "id": "note", "label": "Supporting line", "info": "Optional smaller line under the benefit." }
      ]
    }
  ],
  "presets": [
    {
      "name": "ORI GVM Key Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "text": "Increased legal payload capacity" } },
        { "type": "benefit", "settings": { "text": "Upgraded Fox / BDS suspension" } },
        { "type": "benefit", "settings": { "text": "Federal engineering approval" } }
      ]
    }
  ]
}
{% endschema %}
