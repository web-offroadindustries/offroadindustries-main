{%- liquid
  assign container = section.settings.container | default: 'container'
  assign authorized = false
  if customer.b2b?
    assign authorized = true
  endif

  assign catalog_collection = collections[section.settings.catalog_collection]
  if catalog_collection == blank
    assign catalog_collection = collections.all
  endif
-%}

<div
  class="b2b-catalog-page f-section-padding"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="{{ container }}">

    {%- if authorized -%}

      {%- comment -%} ── Page header ───────────────────────────────────────────── {%- endcomment -%}
      <div class="b2b-catalog__page-header">
        <div class="b2b-catalog__page-header-text">
          <h1 class="b2b-catalog__page-title">{{ section.settings.heading }}</h1>
          {%- if section.settings.subheading != blank -%}
            <p class="b2b-catalog__page-sub">{{ section.settings.subheading }}</p>
          {%- endif -%}
          {%- if customer.current_company != blank -%}
            <p class="b2b-catalog__company-info">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              <span>{{ customer.current_company.name }}</span>
              {%- if customer.current_location != blank and customer.current_location.name != customer.current_company.name -%}
                <span class="b2b-catalog__company-sep">·</span>
                <span>{{ customer.current_location.name }}</span>
              {%- endif -%}
            </p>
          {%- endif -%}
        </div>
        <div class="b2b-catalog__legend">
          <span class="b2b-stock-badge">In Stock</span>
          <span class="b2b-stock-badge b2b-stock-badge--low">Low Stock</span>
          <span class="b2b-stock-badge b2b-stock-badge--out">Out of Stock</span>
        </div>
      </div>

      {%- paginate catalog_collection.products by section.settings.per_page -%}

        {%- comment -%} ── Stats bar ────────────────────────────────────────────── {%- endcomment -%}
        <div class="b2b-catalog__stats">
          <span>{{ catalog_collection.products_count }} product{{ catalog_collection.products_count | plural: '', 's' }}</span>
          {%- if paginate.pages > 1 -%}
            <span class="b2b-catalog__stats-sep">·</span>
            <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {%- endif -%}
        </div>

        {%- comment -%} ── Product table ─────────────────────────────────────────── {%- endcomment -%}
        {%- if catalog_collection.products_count > 0 -%}
          <div class="b2b-catalog__table-wrap">
            <table class="b2b-catalog__table">
              <thead>
                <tr>
                  <th class="b2b-catalog__th b2b-catalog__th--product">Product</th>
                  <th class="b2b-catalog__th">Variant</th>
                  <th class="b2b-catalog__th b2b-catalog__th--sku">SKU</th>
                  <th class="b2b-catalog__th b2b-catalog__th--stock">Stock</th>
                  <th class="b2b-catalog__th b2b-catalog__th--price">Retail Price</th>
                  <th class="b2b-catalog__th b2b-catalog__th--price">Your Price</th>
                </tr>
              </thead>
              <tbody>
                {%- for product in catalog_collection.products -%}
                  {%- for variant in product.variants -%}
                    {%- liquid
                      assign qty = variant.inventory_quantity | default: 0

                      if variant.inventory_management != 'shopify' or variant.inventory_policy == 'continue'
                        assign stock_class = 'b2b-stock-badge'
                        assign stock_label = 'Available'
                        assign stock_show_qty = false
                      elsif qty > 10
                        assign stock_class = 'b2b-stock-badge'
                        assign stock_label = 'In Stock'
                        assign stock_show_qty = true
                      elsif qty > 0
                        assign stock_class = 'b2b-stock-badge b2b-stock-badge--low'
                        assign stock_label = 'Low Stock'
                        assign stock_show_qty = true
                      else
                        assign stock_class = 'b2b-stock-badge b2b-stock-badge--out'
                        assign stock_label = 'Out of Stock'
                        assign stock_show_qty = false
                      endif

                      assign has_retail = false
                      if variant.compare_at_price > variant.price
                        assign has_retail = true
                      endif
                    -%}
                    <tr class="b2b-catalog__row{% if forloop.first %} b2b-catalog__row--first{% endif %}">

                      {%- if forloop.first -%}
                        <td class="b2b-catalog__product-cell" rowspan="{{ product.variants.size }}">
                          <a href="{{ product.url }}" class="b2b-catalog__product-link" target="_blank" rel="noopener">
                            {%- if product.featured_image -%}
                              <img
                                src="{{ product.featured_image | image_url: width: 100 }}"
                                alt="{{ product.featured_image.alt | escape }}"
                                width="44"
                                height="44"
                                class="b2b-catalog__thumb"
                                loading="lazy"
                                decoding="async"
                              >
                            {%- else -%}
                              <span class="b2b-catalog__thumb b2b-catalog__thumb--placeholder" aria-hidden="true"></span>
                            {%- endif -%}
                            <span class="b2b-catalog__product-name">{{ product.title }}</span>
                          </a>
                        </td>
                      {%- endif -%}

                      <td class="b2b-catalog__td b2b-catalog__td--variant">
                        {%- if variant.title == 'Default Title' -%}
                          <span class="b2b-catalog__muted">—</span>
                        {%- else -%}
                          {{ variant.title }}
                        {%- endif -%}
                      </td>

                      <td class="b2b-catalog__td b2b-catalog__td--sku">
                        {{ variant.sku | default: '—' }}
                      </td>

                      <td class="b2b-catalog__td b2b-catalog__td--stock">
                        <span class="{{ stock_class }}">
                          {{ stock_label }}{% if stock_show_qty %}&nbsp;({{ qty }}){% endif %}
                        </span>
                      </td>

                      <td class="b2b-catalog__td b2b-catalog__td--price">
                        {%- if has_retail -%}
                          {{ variant.compare_at_price | money }}
                        {%- else -%}
                          {{ variant.price | money }}
                        {%- endif -%}
                      </td>

                      <td class="b2b-catalog__td b2b-catalog__td--price b2b-catalog__td--member">
                        {{ variant.price | money }}
                      </td>

                    </tr>
                  {%- endfor -%}
                {%- endfor -%}
              </tbody>
            </table>
          </div>

          {%- comment -%} ── Pagination ────────────────────────────────────────── {%- endcomment -%}
          {%- if paginate.pages > 1 -%}
            <nav class="b2b-catalog__pagination" aria-label="Product catalog pages">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" class="btn btn--outline b2b-catalog__page-btn">
                  ← Previous
                </a>
              {%- else -%}
                <span class="btn btn--outline b2b-catalog__page-btn b2b-catalog__page-btn--disabled" aria-disabled="true">← Previous</span>
              {%- endif -%}

              <span class="b2b-catalog__page-info">
                {{ paginate.current_page }} / {{ paginate.pages }}
              </span>

              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" class="btn btn--outline b2b-catalog__page-btn">
                  Next →
                </a>
              {%- else -%}
                <span class="btn btn--outline b2b-catalog__page-btn b2b-catalog__page-btn--disabled" aria-disabled="true">Next →</span>
              {%- endif -%}
            </nav>
          {%- endif -%}

        {%- else -%}
          <p class="b2b-catalog__empty">No products available at this time. Please check back later.</p>
        {%- endif -%}

      {%- endpaginate -%}

      {%- comment -%} ── Footer CTA ───────────────────────────────────────────── {%- endcomment -%}
      {%- if section.settings.show_cta -%}
        <div class="b2b-catalog__footer-cta">
          <p>{{ section.settings.cta_text }}</p>
          <a href="{{ section.settings.cta_link }}" class="btn btn--primary">
            {{ section.settings.cta_label }}
          </a>
        </div>
      {%- endif -%}

    {%- elsif customer -%}

      {%- comment -%} Logged in but not a B2B company contact {%- endcomment -%}
      <div class="b2b-pending">
        <h1 class="b2b-pending__title">Access Restricted</h1>
        <p class="b2b-pending__body">
          This catalog is only available to approved wholesale accounts.
          Contact us to apply for a wholesale account.
        </p>
        <a href="{{ section.settings.cta_link | default: '/pages/contact' }}" class="btn btn--primary">Contact Us</a>
      </div>

    {%- else -%}

      {%- comment -%} Not logged in {%- endcomment -%}
      <div class="b2b-pending">
        <h1 class="b2b-pending__title">{{ section.settings.gate_heading }}</h1>
        <p class="b2b-pending__body">{{ section.settings.gate_body }}</p>
        <a
          href="{{ routes.account_login_url }}?return_url=/pages/b2b-catalog"
          class="btn btn--primary"
          onclick="try{localStorage.setItem('b2b_redirect',JSON.stringify({url:'/pages/b2b-catalog',ts:Date.now()}))}catch(e){}"
        >{{ section.settings.gate_btn_label }}</a>
        <div class="b2b-pending__login-tip">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="b2b-pending__tip-icon"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          <p>After logging in, click the <strong>ORI Offroad Industries logo</strong> at the top of the Shopify portal to return to the store and view the product catalog.</p>
        </div>
        {%- if section.settings.cta_link != blank -%}
          <a href="{{ section.settings.cta_link }}" class="b2b-pending__link">Not a wholesale customer? Contact us to apply.</a>
        {%- endif -%}
      </div>
      <script>
        try { localStorage.setItem('b2b_redirect', JSON.stringify({ url: '/pages/b2b-catalog', ts: Date.now() })); } catch (e) {}
      </script>

    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "B2B Product Catalog",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "options": [
        { "value": "container", "label": "Fixed" },
        { "value": "container-fluid", "label": "Stretched" }
      ],
      "default": "container-fluid"
    },
    {
      "type": "header",
      "content": "Catalog (shown to B2B contacts)"
    },
    {
      "type": "collection",
      "id": "catalog_collection",
      "label": "Catalog collection",
      "info": "Choose a specific collection to display. Leave blank to show all products."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Page heading",
      "default": "Product Catalog"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Stock availability and pricing shown below. Contact us to place an order."
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 10,
      "max": 50,
      "step": 5,
      "default": 25
    },
    {
      "type": "header",
      "content": "Login Gate (shown to guests)"
    },
    {
      "type": "text",
      "id": "gate_heading",
      "label": "Gate heading",
      "default": "Wholesale Portal"
    },
    {
      "type": "textarea",
      "id": "gate_body",
      "label": "Gate description",
      "default": "Log in with your wholesale account to access pricing, stock availability, and the full product catalog."
    },
    {
      "type": "text",
      "id": "gate_btn_label",
      "label": "Login button label",
      "default": "Log In to View Catalog"
    },
    {
      "type": "header",
      "content": "Contact CTA"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show contact CTA (catalog footer)",
      "default": true
    },
    {
      "type": "textarea",
      "id": "cta_text",
      "label": "CTA description",
      "default": "Ready to place an order? Get in touch with our team."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Contact Us to Order"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 60,
      "unit": "px"
    }
  ],
  "presets": [
    { "name": "B2B Product Catalog" }
  ]
}
{% endschema %}