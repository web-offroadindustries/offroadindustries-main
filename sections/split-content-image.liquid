{% comment %}
  Section: Split Content & Image
  - Desktop: two-column layout — content + image (or swapped)
  - Mobile: stacked — image on top by default (switchable)
{% endcomment %}

{%- liquid
  assign anchor_id       = section.settings.anchor_id | strip
  assign layout          = section.settings.layout | default: 'content_left'
  assign mobile_layout   = section.settings.mobile_layout | default: 'image_top'
  assign container_width = section.settings.container_width | default: '1200px'

  assign desktop_dir = 'row'
  if layout == 'image_left'
    assign desktop_dir = 'row-reverse'
  endif

  assign mobile_dir = 'column-reverse'
  if mobile_layout == 'content_top'
    assign mobile_dir = 'column'
  endif
-%}

<section
  class="split-ci split-ci--{{ section.id }}"
  {% if anchor_id != blank %}id="{{ anchor_id | escape }}"{% endif %}
  style="
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    --sci-text:        {{ section.settings.text_color }};
    --sci-heading:     {{ section.settings.heading_color }};
    --sci-btn-bg:      {{ section.settings.btn_bg_color }};
    --sci-btn-text:    {{ section.settings.btn_text_color }};
    --sci-btn-border:  {{ section.settings.btn_border_color }};
    --sci-img-radius:  {{ section.settings.img_radius }}px;
    --sci-heading-sz:  {{ section.settings.heading_size }}px;
    --sci-body-sz:     {{ section.settings.body_size }}px;
    --sci-gap:         {{ section.settings.column_gap }}px;
    --sci-max-width:   {{ container_width }};
    --sci-desk-dir:    {{ desktop_dir }};
    --sci-mob-dir:     {{ mobile_dir }};
  "
>
  <div class="split-ci__container">
    <div class="split-ci__inner">

      <!-- Content column -->
      <div class="split-ci__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="split-ci__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="split-ci__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="split-ci__body">{{ section.settings.body }}</div>
        {%- endif -%}

        {%- if section.settings.btn_label != blank -%}
          <a
            href="{{ section.settings.btn_url | default: '#' }}"
            class="split-ci__btn split-ci__btn--{{ section.settings.btn_style }}"
          >{{ section.settings.btn_label }}</a>
        {%- endif -%}
      </div>

      <!-- Image column -->
      <div class="split-ci__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              class: 'split-ci__image',
              alt: section.settings.image.alt | escape
          }}
        {%- else -%}
          <div class="split-ci__placeholder">
            {{ 'image' | placeholder_svg_tag: 'split-ci__placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% style %}
  /* ── Wrapper ─────────────────────────────────────────────────────────────── */
  .split-ci--{{ section.id }} {
    color: var(--sci-text);
  }

  .split-ci--{{ section.id }} .split-ci__container {
    max-width: var(--sci-max-width);
    margin: 0 auto;
    padding: 0 20px;
  }

  /* ── Two-column inner ────────────────────────────────────────────────────── */
  .split-ci--{{ section.id }} .split-ci__inner {
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-orient: horizontal;
    -webkit-box-direction: normal;
    -webkit-flex-direction: var(--sci-desk-dir);
    -ms-flex-direction: var(--sci-desk-dir);
    flex-direction: var(--sci-desk-dir);
    -webkit-box-align: center;
    -ms-flex-align: center;
    align-items: center;
    gap: var(--sci-gap);
  }

  .split-ci--{{ section.id }} .split-ci__text,
  .split-ci--{{ section.id }} .split-ci__media {
    -webkit-box-flex: 1;
    -ms-flex: 1;
    flex: 1;
    min-width: 0;
  }

  /* ── Eyebrow ─────────────────────────────────────────────────────────────── */
  .split-ci--{{ section.id }} .split-ci__eyebrow {
    margin: 0 0 12px;
    font-family: var(--brand-body-font, sans-serif);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  /* ── Heading ─────────────────────────────────────────────────────────────── */
  .split-ci--{{ section.id }} .split-ci__heading {
    margin: 0 0 20px;
    font-family: var(--brand-display-font, sans-serif);
    font-size: var(--sci-heading-sz);
    color: var(--sci-heading);
    text-transform: uppercase;
    line-height: 1.1;
  }

  /* ── Body ────────────────────────────────────────────────────────────────── */
  .split-ci--{{ section.id }} .split-ci__body {
    font-family: var(--brand-body-font, sans-serif);
    font-size: var(--sci-body-sz);
    line-height: 1.65;
  }
  .split-ci--{{ section.id }} .split-ci__body p {
    margin: 0 0 16px;
  }
  .split-ci--{{ section.id }} .split-ci__body p:last-child {
    margin-bottom: 0;
  }

  /* ── Button ──────────────────────────────────────────────────────────────── */
  .split-ci--{{ section.id }} .split-ci__btn {
    display: inline-block;
    margin-top: 28px;
    padding: 13px 30px;
    font-family: var(--brand-body-font, sans-serif);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    -webkit-box-sizing: border-box;
    box-sizing: border-box;
    -webkit-appearance: none;
    appearance: none;
    -webkit-transition: opacity 0.15s;
    transition: opacity 0.15s;
  }
  .split-ci--{{ section.id }} .split-ci__btn--solid {
    background: var(--sci-btn-bg);
    color: var(--sci-btn-text);
    border: 2px solid var(--sci-btn-bg);
  }
  .split-ci--{{ section.id }} .split-ci__btn--outline {
    background: transparent;
    color: var(--sci-btn-border);
    border: 2px solid var(--sci-btn-border);
  }
  @media (hover: hover) {
    .split-ci--{{ section.id }} .split-ci__btn:hover { opacity: 0.8; }
  }

  /* ── Image ───────────────────────────────────────────────────────────────── */
  .split-ci--{{ section.id }} .split-ci__image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--sci-img-radius);
    object-fit: cover;
  }

  /* ── Placeholder ─────────────────────────────────────────────────────────── */
  .split-ci--{{ section.id }} .split-ci__placeholder {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: rgba(0,0,0,0.06);
    border-radius: var(--sci-img-radius);
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-align: center;
    -ms-flex-align: center;
    align-items: center;
    -webkit-box-pack: center;
    -ms-flex-pack: center;
    justify-content: center;
  }
  .split-ci--{{ section.id }} .split-ci__placeholder-svg {
    width: 64px;
    height: 64px;
    opacity: 0.25;
  }

  /* ── Mobile ──────────────────────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .split-ci--{{ section.id }} .split-ci__container {
      padding: 0 16px;
    }
    .split-ci--{{ section.id }} .split-ci__inner {
      -webkit-flex-direction: var(--sci-mob-dir);
      -ms-flex-direction: var(--sci-mob-dir);
      flex-direction: var(--sci-mob-dir);
      gap: 24px;
    }
    .split-ci--{{ section.id }} .split-ci__heading {
      font-size: clamp(26px, 7vw, var(--sci-heading-sz));
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Split Content & Image",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID (optional)" },

    { "type": "header", "content": "Content" },
    { "type": "text",     "id": "eyebrow",   "label": "Eyebrow text (optional)" },
    { "type": "text",     "id": "heading",   "label": "Heading" },
    { "type": "richtext", "id": "body",      "label": "Body text" },

    { "type": "header", "content": "Button" },
    { "type": "text", "id": "btn_label", "label": "Button label (leave blank to hide)" },
    { "type": "url",  "id": "btn_url",   "label": "Button URL" },
    {
      "type": "select",
      "id": "btn_style",
      "label": "Button style",
      "default": "solid",
      "options": [
        { "value": "solid",   "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ]
    },

    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "range",
      "id": "img_radius",
      "label": "Image corner radius (px)",
      "min": 0, "max": 32, "step": 2, "default": 12
    },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop — column order",
      "default": "content_left",
      "options": [
        { "value": "content_left", "label": "Content left, image right" },
        { "value": "image_left",   "label": "Image left, content right" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile — stack order",
      "default": "image_top",
      "options": [
        { "value": "image_top",   "label": "Image on top, content below" },
        { "value": "content_top", "label": "Content on top, image below" }
      ]
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between columns (px)",
      "min": 16, "max": 120, "step": 4, "default": 60
    },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color",       "label": "Background",            "default": "#e8edf2" },
    { "type": "color", "id": "text_color",     "label": "Body text",             "default": "#111111" },
    { "type": "color", "id": "heading_color",  "label": "Heading",               "default": "#111111" },
    { "type": "color", "id": "btn_bg_color",   "label": "Button background",     "default": "#111111" },
    { "type": "color", "id": "btn_text_color", "label": "Button text",           "default": "#ffffff" },
    { "type": "color", "id": "btn_border_color","label": "Button border (outline style)", "default": "#111111" },

    { "type": "header", "content": "Typography" },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading font size (px)",
      "min": 24, "max": 72, "step": 2, "default": 44
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body font size (px)",
      "min": 13, "max": 24, "step": 1, "default": 16
    },

    { "type": "header", "content": "Spacing" },
    { "type": "text", "id": "container_width", "label": "Container max-width", "default": "1200px" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0, "max": 120, "step": 4, "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0, "max": 120, "step": 4, "default": 64
    }
  ],
  "presets": [
    {
      "name": "Split Content & Image",
      "settings": {
        "heading": "Your Heading Here",
        "body": "<p>Add your body text here. Describe your product, service, or key message.</p>"
      }
    }
  ]
}
{% endschema %}
