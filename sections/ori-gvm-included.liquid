{%- comment -%}
  ORI GVM What's Included.

  Split out of the ORI GVM Product section so merchants can edit, reorder and
  remove it on its own. The markup mirrors the band it replaces: the rules in
  ori-gvm-product.css are scoped as
  `.ori-gvm-product--<layout> .ori-gvm-product__band--included ...`, so the
  wrapper has to keep both the layout class and the band class.

  Brand logo blocks drive the optional "Built with" strip under the list. No
  brand logo blocks means no strip at all.
{%- endcomment -%}

{{ 'ori-gvm-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_id = section.settings.custom_id | default: section.id
  assign container = section.settings.container | default: 'container'
  assign cards_per_row = section.settings.cards_per_row | default: 3
  assign included = section.blocks | where: 'type', 'included'
  assign brand_logos = section.blocks | where: 'type', 'brand_logo'
-%}

{%- if included.size > 0 or brand_logos.size > 0 -%}
  <div
    id="{{ section_id }}"
    class="ori-gvm-product ori-gvm-product--{{ section.settings.layout | default: 'classic' }} color-{{ section.settings.color_schema }}{% if section.settings.mobile_slider %} ori-gvm-product--swipe{% endif %}"
    data-section-type="ori-gvm-included"
    style="--gvm-tint: {{ section.settings.tint_color | default: '#f3f6f7' }}; --gvm-item-logo-h: {{ section.settings.item_logo_height | default: 40 }}px; --gvm-brand-logo-h: {{ section.settings.brand_logo_height | default: 72 }}px;"
  >
    <div
      class="ori-gvm-product__band ori-gvm-product__band--included{% if section.settings.alt_background %} ori-gvm-product__band--alt{% endif %}"
      style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
    >
      <div class="{{ container }}">
        <div class="ori-gvm-product__block ori-gvm-product__block--wide ori-gvm-product__block--split">
          {%- if section.settings.heading != blank -%}
            <h2 class="ori-gvm-product__block-title h3">{{ section.settings.heading }}</h2>
          {%- endif -%}

          {%- if included.size > 0 -%}
            <ul class="ori-gvm-product__cards" style="--gvm-cards: {{ cards_per_row }};" role="list">
              {%- for block in included -%}
                <li class="ori-gvm-product__card" {{ block.shopify_attributes }}>
                  <span class="ori-gvm-product__card-media">
                    {%- if block.settings.logo != blank -%}
                      {{-
                        block.settings.logo
                        | image_url: width: 240
                        | image_tag:
                          loading: 'lazy',
                          class: 'ori-gvm-product__card-logo',
                          widths: '120,180,240',
                          sizes: '120px',
                          alt: block.settings.brand | default: block.settings.text | escape
                      -}}
                    {%- else -%}
                      <span class="ori-gvm-product__badge" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                      </span>
                    {%- endif -%}
                  </span>
                  <span class="ori-gvm-product__card-body">
                    {%- if block.settings.brand != blank -%}
                      <span class="ori-gvm-product__card-eyebrow">{{ block.settings.brand }}</span>
                    {%- endif -%}
                    <span class="ori-gvm-product__card-title">{{ block.settings.text }}</span>
                    {%- if block.settings.note != blank -%}
                      <span class="ori-gvm-product__card-note">{{ block.settings.note }}</span>
                    {%- endif -%}
                  </span>
                  {%- if block.settings.sku != blank -%}
                    <span class="ori-gvm-product__card-sku">{{ block.settings.sku }}</span>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if brand_logos.size > 0 -%}
            <div class="ori-gvm-product__brands">
              {%- if section.settings.brands_heading != blank -%}
                <p class="ori-gvm-product__brands-title">{{ section.settings.brands_heading }}</p>
              {%- endif -%}
              <ul class="ori-gvm-product__brands-row" role="list">
                {%- for block in brand_logos -%}
                  <li class="ori-gvm-product__brand" {{ block.shopify_attributes }}>
                    {%- if block.settings.logo != blank -%}
                      {%- capture brand_img -%}
                        {{-
                          block.settings.logo
                          | image_url: width: 320
                          | image_tag:
                            loading: 'lazy',
                            class: 'ori-gvm-product__brand-img',
                            widths: '160,240,320',
                            sizes: '150px',
                            alt: block.settings.name | default: 'Brand' | escape
                        -}}
                      {%- endcapture -%}
                      {%- if block.settings.link_url != blank -%}
                        <a href="{{ block.settings.link_url }}" class="ori-gvm-product__brand-link">{{ brand_img }}</a>
                      {%- else -%}
                        {{ brand_img }}
                      {%- endif -%}
                    {%- elsif block.settings.name != blank -%}
                      <span class="ori-gvm-product__brand-text">{{ block.settings.name }}</span>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "ORI GVM Included",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's included" },
    { "type": "header", "content": "Layout style" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout style",
      "info": "Match this to the ORI GVM Product section on the same page.",
      "options": [
        { "value": "classic", "label": "Classic (light, centred)" },
        { "value": "editorial", "label": "Technical (engineering plate)" }
      ],
      "default": "classic"
    },
    {
      "type": "checkbox",
      "id": "mobile_slider",
      "label": "Swipe rows on mobile",
      "info": "Turns the row into a swipeable slider on phones instead of stacking it.",
      "default": false
    },
    {
      "type": "range",
      "id": "cards_per_row",
      "label": "Cards per row (desktop)",
      "info": "Ignored on the Technical layout, which always runs two items per row.",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    { "type": "header", "content": "Logo sizes" },
    {
      "type": "range",
      "id": "item_logo_height",
      "label": "Item logo height",
      "info": "Brand logos shown beside each included item.",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "brand_logo_height",
      "label": "Partner logo height",
      "info": "Logos in the brand strip. Scales down proportionally on mobile so the row still fits.",
      "min": 30,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    { "type": "header", "content": "Brand strip" },
    { "type": "text", "id": "brands_heading", "label": "Brand strip heading", "info": "Shown above the logo row. Add Brand logo blocks to populate it.", "default": "Built with" },
    { "type": "header", "content": "Appearance" },
    { "type": "checkbox", "id": "alt_background", "label": "Use tinted background", "default": false },
    { "type": "color", "id": "tint_color", "label": "Tint colour", "default": "#f3f6f7" },
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "options": [
        { "value": "container", "label": "Fixed (1200px)" },
        { "value": "container-narrow", "label": "Narrow" },
        { "value": "container-full", "label": "Full width" }
      ],
      "default": "container"
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "text", "id": "custom_id", "label": "Custom HTML ID" },
    { "type": "text", "id": "color_schema", "label": "Color scheme class" }
  ],
  "blocks": [
    {
      "type": "included",
      "name": "Included item",
      "settings": [
        { "type": "text", "id": "text", "label": "Item", "default": "Fox shocks" },
        { "type": "image_picker", "id": "logo", "label": "Brand logo", "info": "Optional. Replaces the tick. PNG or WebP with a transparent background (Shopify's picker will not accept an SVG)." },
        { "type": "text", "id": "brand", "label": "Brand name", "info": "Optional small line above the item, e.g. FOX." },
        { "type": "text", "id": "note", "label": "Supporting line", "info": "Optional smaller line under the item." },
        { "type": "text", "id": "sku", "label": "Part number", "info": "Optional. Shown right-aligned on the Technical layout, e.g. CS-F45-PT25." }
      ]
    },
    {
      "type": "brand_logo",
      "name": "Brand logo",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo", "info": "PNG or WebP with a transparent background. SVG is not accepted by Shopify's image picker." },
        { "type": "text", "id": "name", "label": "Brand name", "info": "Used as the image alt text, and shown as text if no logo is set." },
        { "type": "url", "id": "link_url", "label": "Links to", "info": "Optional." }
      ]
    }
  ],
  "presets": [
    {
      "name": "ORI GVM Included",
      "blocks": [
        { "type": "included", "settings": { "text": "Fox shocks" } },
        { "type": "included", "settings": { "text": "BDS components" } },
        { "type": "included", "settings": { "text": "ORI springs" } },
        { "type": "included", "settings": { "text": "Engineering certification" } }
      ]
    }
  ]
}
{% endschema %}
