{%- if uploads_enabled -%}
<script>






  (function () {
    if (customElements.get('photo-uploader')) return;
    class PhotoUploader extends HTMLElement {
      connectedCallback() {
        this.cloudName = this.dataset.cloudName;
        this.preset = this.dataset.uploadPreset;
        this.maxFiles = parseInt(this.dataset.maxFiles || '8', 10);
        this.maxSize = (parseFloat(this.dataset.maxSizeMb || '10') || 10) * 1024 * 1024;
        this.required = this.dataset.require === 'true';

        this.input = this.querySelector('[data-uploader-input]');
        this.dropzone = this.querySelector('[data-uploader-dropzone]');
        this.list = this.querySelector('[data-uploader-list]');
        this.status = this.querySelector('[data-uploader-status]');
        this.form = this.closest('form');

        this.seq = 0;
        this.inFlight = 0;
        this.uploads = {};

        if (!this.input || !this.cloudName || !this.preset) return;



        this.linksField = document.createElement('input');
        this.linksField.type = 'hidden';
        this.linksField.name = 'contact[Photo Links]';
        (this.form || this).appendChild(this.linksField);

        this._onChange = this._onChange.bind(this);
        this._onDragOver = this._onDragOver.bind(this);
        this._onDragLeave = this._onDragLeave.bind(this);
        this._onDrop = this._onDrop.bind(this);
        this._onSubmit = this._onSubmit.bind(this);

        this.input.addEventListener('change', this._onChange);
        if (this.dropzone) {
          this.dropzone.addEventListener('dragover', this._onDragOver);
          this.dropzone.addEventListener('dragleave', this._onDragLeave);
          this.dropzone.addEventListener('drop', this._onDrop);
        }
        if (this.form) this.form.addEventListener('submit', this._onSubmit, true);
      }

      _onChange(e) {
        this._addFiles(e.target.files);
        this.input.value = '';
      }
      _onDragOver(e) {
        e.preventDefault();
        this.dropzone.classList.add('is-dragover');
      }
      _onDragLeave() {
        this.dropzone.classList.remove('is-dragover');
      }
      _onDrop(e) {
        e.preventDefault();
        this.dropzone.classList.remove('is-dragover');
        if (e.dataTransfer && e.dataTransfer.files) this._addFiles(e.dataTransfer.files);
      }
      _currentCount() {
        return this.list ? this.list.querySelectorAll('.f-wc-upload__item').length : 0;
      }
      _addFiles(fileList) {
        var files = Array.prototype.slice.call(fileList || []);
        for (var i = 0; i < files.length; i++) {
          if (this._currentCount() >= this.maxFiles) {
            this._setStatus('You can upload up to ' + this.maxFiles + ' files.', true);
            break;
          }
          var file = files[i];
          if (file.size > this.maxSize) {
            this._setStatus('"' + file.name + '" is larger than ' + (this.maxSize / 1048576) + 'MB.', true);
            continue;
          }
          this._uploadFile(file);
        }
      }
      _uploadFile(file) {
        var self = this;
        var id = 'wc-photo-' + (++this.seq);
        var item = document.createElement('li');
        item.className = 'f-wc-upload__item';
        item.dataset.itemId = id;

        var thumb = document.createElement('span');
        thumb.className = 'f-wc-upload__thumb';
        if (file.type && file.type.indexOf('image/') === 0) {
          var objUrl = URL.createObjectURL(file);
          var img = document.createElement('img');
          img.src = objUrl;
          img.alt = '';
          img.onload = function () { URL.revokeObjectURL(objUrl); };
          thumb.appendChild(img);
        } else {
          thumb.classList.add('f-wc-upload__thumb--file');
          thumb.textContent = (file.name.split('.').pop() || 'file').toUpperCase();
        }

        var meta = document.createElement('span');
        meta.className = 'f-wc-upload__name';
        meta.textContent = file.name;

        var bar = document.createElement('span');
        bar.className = 'f-wc-upload__progress';
        var barFill = document.createElement('span');
        barFill.className = 'f-wc-upload__progress-fill';
        bar.appendChild(barFill);

        var remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'f-wc-upload__remove';
        remove.setAttribute('aria-label', 'Remove ' + file.name);
        remove.innerHTML = '&times;';

        item.appendChild(thumb);
        item.appendChild(meta);
        item.appendChild(bar);
        item.appendChild(remove);
        this.list.appendChild(item);

        this.inFlight++;
        this._setStatus('Uploading ' + this.inFlight + ' file(s)...');

        var xhr = new XMLHttpRequest();
        xhr.open('POST', 'https://api.cloudinary.com/v1_1/' + this.cloudName + '/auto/upload');
        xhr.timeout = 180000;
        xhr.upload.onprogress = function (evt) {
          if (evt.lengthComputable) {
            barFill.style.width = Math.round((evt.loaded / evt.total) * 90) + '%';
          }
        };
        xhr.upload.onload = function () {

          barFill.style.width = '95%';
          item.classList.add('is-processing');
          if (self.inFlight > 0) self._setStatus('Processing ' + self.inFlight + ' file(s)...');
        };
        xhr.onload = function () {
          self.inFlight--;
          item.classList.remove('is-processing');
          var ok = false, errMsg = '';
          try {
            var res = JSON.parse(xhr.responseText);
            if (xhr.status >= 200 && xhr.status < 300 && res.secure_url) {
              ok = true;
              self._register(id, res.secure_url);
              item.classList.add('is-done');
              barFill.style.width = '100%';
            } else if (res && res.error && res.error.message) {
              errMsg = res.error.message;
            }
          } catch (err) {}
          if (!ok) {
            item.classList.add('is-error');
            meta.textContent = file.name + (errMsg ? ' - ' + errMsg : ' - upload failed (' + xhr.status + ')');
          }
          self._finishStatus();
        };
        xhr.onerror = function () {
          self.inFlight--;
          item.classList.remove('is-processing');
          item.classList.add('is-error');
          meta.textContent = file.name + ' - upload failed (network or blocked)';
          self._finishStatus();
        };
        xhr.ontimeout = function () {
          self.inFlight--;
          item.classList.remove('is-processing');
          item.classList.add('is-error');
          meta.textContent = file.name + ' - upload timed out';
          self._finishStatus();
        };
        remove.addEventListener('click', function () {
          try { xhr.abort(); } catch (e) {}
          self._unregister(id);
          if (item.parentNode) item.parentNode.removeChild(item);
          self._finishStatus();
        });

        var data = new FormData();
        data.append('file', file);
        data.append('upload_preset', this.preset);
        xhr.send(data);
      }
      _register(id, url) {
        this.uploads[id] = url;
        this._sync();
      }
      _unregister(id) {
        delete this.uploads[id];
        this._sync();
      }
      _urls() {
        var self = this;
        return Object.keys(this.uploads).map(function (k) { return self.uploads[k]; });
      }
      _sync() {
        if (this.linksField) this.linksField.value = this._urls().join('\n');
      }
      _setStatus(msg, isError) {
        if (!this.status) return;
        this.status.textContent = msg || '';
        this.status.classList.toggle('is-error', !!isError);
      }
      _finishStatus() {
        if (this.inFlight > 0) {
          this._setStatus('Uploading ' + this.inFlight + ' file(s)...');
        } else {
          var n = this._uploadedCount();
          this._setStatus(n ? n + ' photo(s) attached.' : '');
        }
      }
      _uploadedCount() {
        return this._urls().length;
      }
      _onSubmit(e) {
        if (this.inFlight > 0) {
          e.preventDefault();
          e.stopImmediatePropagation();
          this._setStatus('Please wait for your photos to finish uploading.', true);
          this.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
        if (this.required && this._uploadedCount() === 0) {
          e.preventDefault();
          e.stopImmediatePropagation();
          this._setStatus('Please attach at least one photo before submitting.', true);
          this.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }


        var urls = this._urls();
        if (this.form && urls.length) {
          var body = this.form.querySelector('[name="contact[body]"]');
          if (body && body.value.indexOf(urls[0]) === -1) {
            var prefix = body.value ? body.value.replace(/\s+$/, '') + '\n\n' : '';
            body.value = prefix + 'Attached photos:\n' + urls.join('\n');
          }
        }
      }
    }
    customElements.define('photo-uploader', PhotoUploader);
  })();
</script>
{%- endif -%}

{%- if section.settings.layout_mode == 'wizard' -%}
<script>



  (function () {
    var P = 'f-warranty-claim';
    var root = document.getElementById('{{ section_id }}');
    if (!root) return;
    var form = root.querySelector('form');
    var stepsWrap = root.querySelector('.' + P + '__steps');
    var footer = root.querySelector('.' + P + '__footer');
    if (!form || !stepsWrap || !footer) return;
    var steps = [].slice.call(stepsWrap.querySelectorAll('.' + P + '__step'));
    if (steps.length < 2) return;
    var submitBtn = footer.querySelector('[type="submit"]');
    var submitLabel = submitBtn ? (submitBtn.textContent || 'Submit').trim() : 'Submit';
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;


    [].slice.call(form.querySelectorAll('[required]')).forEach(function (c) {
      c.setAttribute('data-wizard-req', '1');
    });

    var current = 0, furthest = 0;

    var prog = document.createElement('ol');
    prog.className = P + '__progress';
    var items = steps.map(function (step, i) {
      var t = step.querySelector('.' + P + '__group-title');
      var label = t ? t.textContent.trim() : ('Step ' + (i + 1));
      var li = document.createElement('li');
      li.className = P + '__pstep';
      var dot = document.createElement('span');
      dot.className = P + '__pdot';
      dot.textContent = String(i + 1);
      var lab = document.createElement('span');
      lab.className = P + '__plabel';
      lab.textContent = label;
      li.appendChild(dot);
      li.appendChild(lab);
      li.addEventListener('click', function () { if (i <= furthest) goTo(i); });
      prog.appendChild(li);
      return { li: li, dot: dot, label: label };
    });

    var caption = document.createElement('p');
    caption.className = P + '__pcaption';

    var nav = document.createElement('div');
    nav.className = P + '__wnav';
    var back = document.createElement('button');
    back.type = 'button';
    back.className = 'btn btn--secondary ' + P + '__back';
    back.textContent = 'Back';
    var next = document.createElement('button');
    next.type = 'button';
    next.className = 'btn btn--primary ' + P + '__next';
    next.textContent = 'Next';
    nav.appendChild(back);
    nav.appendChild(next);

    var note = document.createElement('p');
    note.className = P + '__wnote';
    note.innerHTML = 'Fields marked <span aria-hidden="true" style="color:#dc2626;">*</span> are required.';

    stepsWrap.parentNode.insertBefore(prog, stepsWrap);
    stepsWrap.parentNode.insertBefore(caption, stepsWrap);
    footer.parentNode.insertBefore(nav, footer);
    footer.parentNode.insertBefore(note, footer);

    root.classList.add('is-wizard');

    back.addEventListener('click', function () { goTo(current - 1); });
    next.addEventListener('click', function () {
      if (!validateStep(steps[current])) return;
      if (current === steps.length - 1) {
        if (form.requestSubmit) form.requestSubmit(submitBtn || undefined);
        else if (submitBtn) submitBtn.click();
        else form.submit();
        return;
      }
      goTo(current + 1);
    });

    function validateStep(step) {
      var cs = [].slice.call(step.querySelectorAll('input, select, textarea'));
      for (var i = 0; i < cs.length; i++) {
        if (cs[i].willValidate && !cs[i].checkValidity()) {
          cs[i].reportValidity();
          return false;
        }
      }
      return true;
    }

    function goTo(index, initial) {
      if (index < 0 || index >= steps.length) return;
      current = index;
      if (index > furthest) furthest = index;
      steps.forEach(function (s, i) {
        var active = i === index;
        s.classList.toggle('is-active', active);
        [].slice.call(s.querySelectorAll('[data-wizard-req]')).forEach(function (c) {
          if (active) c.setAttribute('required', ''); else c.removeAttribute('required');
        });
      });
      items.forEach(function (p, i) {
        p.li.classList.toggle('is-active', i === index);
        p.li.classList.toggle('is-done', i < index);
        p.li.classList.toggle('is-clickable', i <= furthest);
        p.dot.innerHTML = (i < index) ? '&#10003;' : String(i + 1);
      });
      back.hidden = index === 0;
      next.textContent = (index === steps.length - 1) ? submitLabel : 'Next';
      caption.textContent = 'Step ' + (index + 1) + ' of ' + steps.length + ' — ' + items[index].label;
      if (!initial) {
        var f = steps[index].querySelector('input, select, textarea');
        if (f) { try { f.focus({ preventScroll: true }); } catch (e) { f.focus(); } }
        try { prog.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest' }); } catch (e) {}
      }
    }

    goTo(0, true);
  })();
</script>
{%- endif -%}

