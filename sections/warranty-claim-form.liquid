    },
    {
      "type": "text",
      "id": "label_claim_type",
      "label": "Claim type label",
      "default": "Claim Type"
    },
    {
      "type": "text",
      "id": "placeholder_claim_type",
      "label": "Claim type placeholder",
      "default": "Select a claim type"
    },
    {
      "type": "text",
      "id": "label_description",
      "label": "Description label",
      "default": "Description of Issue"
    },
    {
      "type": "text",
      "id": "placeholder_description",
      "label": "Description placeholder",
      "default": "Please describe the issue in detail, including when it occurred and any relevant conditions."
    },
    {
      "type": "text",
      "id": "label_photo_link",
      "label": "Photo link label",
      "default": "Photo / Evidence Link (optional)"
    },
    {
      "type": "text",
      "id": "placeholder_photo_link",
      "label": "Photo link placeholder",
      "default": "https://drive.google.com/..."
    },
    {
      "type": "text",
      "id": "photo_link_hint",
      "label": "Photo link hint text",
      "default": "Upload photos to Google Drive or Dropbox and paste the shared link here."
    },
    {
      "type": "header",
      "content": "Submit button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Submit Claim"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "btn--primary", "label": "Primary" },
        { "value": "btn--secondary", "label": "Secondary" },
        { "value": "btn--white", "label": "White" },
        { "value": "btn--underline", "label": "Underline" }
      ],
      "default": "btn--primary"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "default": 60,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 80,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
