{%- comment -%}
  ORI GVM Installation Process.

  Split out of the ORI GVM Product section so merchants can edit, reorder and
  remove it on its own. The markup mirrors the band it replaces: the rules in
  ori-gvm-product.css are scoped as
  `.ori-gvm-product--<layout> .ori-gvm-product__band--steps ...`, so the
  wrapper has to keep both the layout class and the band class.

  --gvm-step-count drives the desktop column count, and the --few modifier
  promotes three or fewer steps to a horizontal row earlier (750px instead of
  990px) so short sequences do not sit in a tall vertical rail on tablets.
{%- endcomment -%}

{{ 'ori-gvm-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_id = section.settings.custom_id | default: section.id
  assign container = section.settings.container | default: 'container'
  assign steps = section.blocks | where: 'type', 'step'
-%}

{%- if steps.size > 0 -%}
  <div
    id="{{ section_id }}"
    class="ori-gvm-product ori-gvm-product--{{ section.settings.layout | default: 'classic' }} color-{{ section.settings.color_schema }}{% if section.settings.mobile_slider %} ori-gvm-product--swipe{% endif %}"
    data-section-type="ori-gvm-steps"
    style="--gvm-tint: {{ section.settings.tint_color | default: '#f3f6f7' }};"
  >
    <div
      class="ori-gvm-product__band ori-gvm-product__band--steps{% if section.settings.alt_background %} ori-gvm-product__band--alt{% endif %}"
      style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
    >
      <div class="{{ container }}">
        <div class="ori-gvm-product__block ori-gvm-product__block--wide">
          {%- if section.settings.heading != blank -%}
            <h2 class="ori-gvm-product__block-title h3">{{ section.settings.heading }}</h2>
          {%- endif -%}
          <ol
            class="ori-gvm-product__steps{% if steps.size < 4 %} ori-gvm-product__steps--few{% endif %}"
            style="--gvm-step-count: {{ steps.size }};"
          >
            {%- for block in steps -%}
              <li class="ori-gvm-product__step" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h3 class="ori-gvm-product__step-title">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="ori-gvm-product__step-text">{{ block.settings.text }}</p>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ol>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "ORI GVM Install Steps",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Installation process" },
    { "type": "header", "content": "Layout style" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout style",
      "info": "Match this to the ORI GVM Product section on the same page.",
      "options": [
        { "value": "classic", "label": "Classic (light, centred)" },
        { "value": "editorial", "label": "Technical (engineering plate)" }
      ],
      "default": "classic"
    },
    {
      "type": "checkbox",
      "id": "mobile_slider",
      "label": "Swipe steps on mobile",
      "info": "Turns the steps into a swipeable slider on phones instead of stacking them.",
      "default": false
    },
    { "type": "header", "content": "Appearance" },
    { "type": "checkbox", "id": "alt_background", "label": "Use tinted background", "info": "Ignored on the Technical layout, which gives the steps their own paper tone.", "default": false },
    { "type": "color", "id": "tint_color", "label": "Tint colour", "default": "#f3f6f7" },
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "options": [
        { "value": "container", "label": "Fixed (1200px)" },
        { "value": "container-narrow", "label": "Narrow" },
        { "value": "container-full", "label": "Full width" }
      ],
      "default": "container"
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "text", "id": "custom_id", "label": "Custom HTML ID" },
    { "type": "text", "id": "color_schema", "label": "Color scheme class" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Installation step",
      "settings": [
        { "type": "text", "id": "heading", "label": "Step heading", "default": "Book your install" },
        { "type": "textarea", "id": "text", "label": "Step description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ORI GVM Install Steps",
      "blocks": [
        { "type": "step", "settings": { "heading": "Request a quote", "text": "Send us your vehicle details and we prepare a package quote." } },
        { "type": "step", "settings": { "heading": "Book your install", "text": "Choose an approved installer near you and book a date." } },
        { "type": "step", "settings": { "heading": "Get certified", "text": "We complete the upgrade and issue engineering certification." } }
      ]
    }
  ]
}
{% endschema %}
