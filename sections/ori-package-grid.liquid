{{ 'ori-package-grid.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign section_id = section.settings.custom_id | default: section.id
  assign container  = section.settings.container
  assign cols       = section.settings.columns | default: 3
  assign source     = section.settings.source | default: 'products'
  assign products_limit = section.settings.products_limit | default: 12

  # Products source: use the current collection, or an explicitly chosen one.
  assign pkg_collection = collection
  if section.settings.collection != blank
    assign pkg_collection = collections[section.settings.collection]
  endif

  # Metafield keys (namespace.key) for the figures shown on each product card.
  assign gvm_mf = section.settings.gvm_metafield | default: 'custom.gvm' | split: '.'
  assign gcm_mf = section.settings.gcm_metafield | default: 'custom.upgraded_gcm' | split: '.'
  assign payload_mf = section.settings.payload_metafield | default: 'custom.payload_gain' | split: '.'
  assign stage_mf = section.settings.stage_metafield | default: 'custom.stage' | split: '.'
  assign product_btn_text = section.settings.product_btn_text | default: 'View Package'

  # Manual Package card blocks always take priority when present, so cards the
  # merchant adds show immediately without having to flip the Card source toggle.
  # With no blocks added, cards are pulled from the collection (products source).
  assign use_manual = false
  if section.blocks.size > 0
    assign use_manual = true
  endif
  if source == 'manual'
    assign use_manual = true
  endif
-%}

<div
  id="{{ section_id }}"
  class="ori-package-grid f-section-padding color-{{ section.settings.color_schema }}"
  data-section-type="ori-package-grid"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --pkg-grid-cols: {{ cols }};
  "
>
  <div class="{{ container }}">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="ori-package-grid__header f-section-header">
        {%- if section.settings.heading != blank -%}
          <h2 class="ori-package-grid__heading {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="ori-package-grid__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if use_manual -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="ori-package-grid__list" role="list">
          {%- for block in section.blocks -%}
            {%- case block.type -%}

              {%- when 'package_card' -%}
                <li class="ori-package-grid__item" {{ block.shopify_attributes }}>
                  <div class="ori-package-card">

                    {%- if block.settings.image != blank -%}
                      <div class="ori-package-card__image-wrap">
                        {{-
                          block.settings.image
                          | image_url: width: 800
                          | image_tag:
                            loading: 'lazy',
                            class: 'ori-package-card__image',
                            widths: '400,600,800',
                            sizes: '(max-width: 749px) calc(100vw - 32px), (max-width: 989px) calc(50vw - 40px), calc(33.3vw - 48px)'
                        -}}
                      </div>
                    {%- endif -%}

                    <div class="ori-package-card__body">

                      {%- if block.settings.vehicle_label != blank -%}
                        <span class="ori-package-card__vehicle">{{ block.settings.vehicle_label }}</span>
                      {%- endif -%}

                      {%- if block.settings.title != blank -%}
                        <h3 class="ori-package-card__title h4">{{ block.settings.title }}</h3>
                      {%- endif -%}

                      <dl class="ori-package-card__specs">
                        {%- if block.settings.gvm_figure != blank -%}
                          <div class="ori-package-card__spec-row">
                            <dt>GVM</dt>
                            <dd>{{ block.settings.gvm_figure }}</dd>
                          </div>
                        {%- endif -%}
                        {%- if block.settings.gcm_figure != blank -%}
                          <div class="ori-package-card__spec-row">
                            <dt>GCM</dt>
                            <dd>{{ block.settings.gcm_figure }}</dd>
                          </div>
                        {%- endif -%}
                        {%- if block.settings.payload_gain != blank -%}
                          <div class="ori-package-card__spec-row ori-package-card__spec-row--highlight">
                            <dt>Payload gain</dt>
                            <dd>{{ block.settings.payload_gain }}</dd>
                          </div>
                        {%- endif -%}
                        {%- if block.settings.stage_label != blank -%}
                          <div class="ori-package-card__spec-row">
                            <dt>Stage</dt>
                            <dd>{{ block.settings.stage_label }}</dd>
                          </div>
                        {%- endif -%}
                      </dl>

                      {%- if block.settings.badge != blank -%}
                        <span class="ori-package-card__badge">{{ block.settings.badge }}</span>
                      {%- endif -%}

                      {%- if block.settings.btn_text != blank and block.settings.btn_url != blank -%}
                        <a
                          href="{{ block.settings.btn_url }}"
                          class="btn {{ block.settings.btn_style }} ori-package-card__cta"
                        >
                          {{- block.settings.btn_text -}}
                        </a>
                      {%- endif -%}

                    </div>
                  </div>
                </li>

            {%- endcase -%}
          {%- endfor -%}
        </ul>
      {%- elsif request.design_mode -%}
        <p class="ori-package-grid__empty">Manual cards mode is on. Click "Add Package card" to add a card. This note only appears in the theme editor.</p>
      {%- endif -%}

    {%- else -%}
      {%- if pkg_collection != blank and pkg_collection.products.size > 0 -%}
        <ul class="ori-package-grid__list" role="list">
          {%- for product in pkg_collection.products limit: products_limit -%}
            {%- liquid
              assign gvm_val = product.metafields[gvm_mf[0]][gvm_mf[1]]
              assign gcm_val = product.metafields[gcm_mf[0]][gcm_mf[1]]
              assign payload_val = product.metafields[payload_mf[0]][payload_mf[1]]
              assign stage_val = product.metafields[stage_mf[0]][stage_mf[1]]
            -%}
            <li class="ori-package-grid__item">
              <div class="ori-package-card">
                {%- if product.featured_image != blank -%}
                  <div class="ori-package-card__image-wrap">
                    {{-
                      product.featured_image
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        class: 'ori-package-card__image',
                        widths: '400,600,800',
                        sizes: '(max-width: 749px) calc(100vw - 32px), (max-width: 989px) calc(50vw - 40px), calc(33.3vw - 48px)'
                    -}}
                  </div>
                {%- endif -%}
                <div class="ori-package-card__body">
                  {%- if product.vendor != blank -%}
                    <span class="ori-package-card__vehicle">{{ product.vendor }}</span>
                  {%- endif -%}
                  <h3 class="ori-package-card__title h4">{{ product.title }}</h3>
                  <dl class="ori-package-card__specs">
                    {%- if gvm_val != blank -%}
                      <div class="ori-package-card__spec-row"><dt>GVM</dt><dd>{{ gvm_val }}</dd></div>
                    {%- endif -%}
                    {%- if gcm_val != blank -%}
                      <div class="ori-package-card__spec-row"><dt>GCM</dt><dd>{{ gcm_val }}</dd></div>
                    {%- endif -%}
                    {%- if payload_val != blank -%}
                      <div class="ori-package-card__spec-row ori-package-card__spec-row--highlight"><dt>Payload gain</dt><dd>{{ payload_val }}</dd></div>
                    {%- endif -%}
                    {%- if stage_val != blank -%}
                      <div class="ori-package-card__spec-row"><dt>Stage</dt><dd>{{ stage_val }}</dd></div>
                    {%- endif -%}
                  </dl>
                  <a href="{{ product.url }}" class="btn {{ section.settings.product_btn_style }} ori-package-card__cta">
                    {{- product_btn_text -}}
                  </a>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- elsif request.design_mode -%}
        <p class="ori-package-grid__empty">No products to show yet. Either add Package card blocks below for manual cards, or point this section at a collection that holds the GVM and GCM packages (Collection setting above). This note only appears in the theme editor.</p>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.view_all_text != blank and section.settings.view_all_url != blank -%}
      <div class="ori-package-grid__footer">
        <a href="{{ section.settings.view_all_url }}" class="btn {{ section.settings.view_all_style }}">
          {{ section.settings.view_all_text }}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "ORI Package Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "GVM & GCM Upgrade Packages"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Card source",
      "info": "If you add Package card blocks below, they always show. With no blocks added, cards are pulled from the collection.",
      "options": [
        { "value": "products", "label": "Products from a collection" },
        { "value": "manual", "label": "Manual cards (blocks)" }
      ],
      "default": "manual"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Used when there are no manual cards. Leave blank to use the collection this page belongs to."
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Max products",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "text",
      "id": "gvm_metafield",
      "label": "GVM metafield",
      "info": "Product metafield (namespace.key) holding the GVM figure.",
      "default": "custom.gvm"
    },
    {
      "type": "text",
      "id": "gcm_metafield",
      "label": "GCM metafield",
      "info": "Product metafield (namespace.key) holding the GCM figure.",
      "default": "custom.upgraded_gcm"
    },
    {
      "type": "text",
      "id": "payload_metafield",
      "label": "Payload gain metafield",
      "default": "custom.payload_gain"
    },
    {
      "type": "text",
      "id": "stage_metafield",
      "label": "Stage metafield",
      "default": "custom.stage"
    },
    {
      "type": "text",
      "id": "product_btn_text",
      "label": "Product button label",
      "default": "View Package"
    },
    {
      "type": "select",
      "id": "product_btn_style",
      "label": "Product button style",
      "options": [
        { "value": "btn--primary", "label": "Primary" },
        { "value": "btn--secondary", "label": "Secondary" },
        { "value": "btn--outline", "label": "Outline" }
      ],
      "default": "btn--primary"
    },
    {
      "type": "header",
      "content": "View all button"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all label"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all URL"
    },
    {
      "type": "select",
      "id": "view_all_style",
      "label": "View all button style",
      "options": [
        { "value": "btn--primary", "label": "Primary" },
        { "value": "btn--secondary", "label": "Secondary" },
        { "value": "btn--outline", "label": "Outline" }
      ],
      "default": "btn--outline"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "options": [
        { "value": "container-full", "label": "Full width" },
        { "value": "container", "label": "Fixed (1200px)" },
        { "value": "container-narrow", "label": "Narrow" }
      ],
      "default": "container"
    },
    {
      "type": "select",
      "id": "color_schema",
      "label": "Color scheme",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "accent", "label": "Accent" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom HTML ID"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class"
    }
  ],
  "blocks": [
    {
      "type": "package_card",
      "name": "Package card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "text",
          "id": "vehicle_label",
          "label": "Vehicle label (eyebrow)",
          "info": "e.g. Toyota Tundra"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Package title",
          "default": "Stage 1 GVM Upgrade"
        },
        {
          "type": "text",
          "id": "gvm_figure",
          "label": "GVM figure",
          "info": "e.g. 4,200 kg",
          "default": "4,200 kg"
        },
        {
          "type": "text",
          "id": "gcm_figure",
          "label": "GCM figure",
          "info": "e.g. 8,200 kg"
        },
        {
          "type": "text",
          "id": "payload_gain",
          "label": "Payload gain",
          "info": "e.g. +450 kg",
          "default": "+450 kg"
        },
        {
          "type": "text",
          "id": "stage_label",
          "label": "Stage",
          "default": "Stage 1"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge text (optional)",
          "info": "e.g. Most Popular"
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button label",
          "default": "View Package"
        },
        {
          "type": "url",
          "id": "btn_url",
          "label": "Button URL",
          "info": "Link this card to a collection, page, or product."
        },
        {
          "type": "select",
          "id": "btn_style",
          "label": "Button style",
          "options": [
            { "value": "btn--primary", "label": "Primary" },
            { "value": "btn--secondary", "label": "Secondary" },
            { "value": "btn--outline", "label": "Outline" }
          ],
          "default": "btn--primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ORI Package Grid",
      "blocks": [
        {
          "type": "package_card",
          "settings": {
            "vehicle_label": "Toyota Tundra",
            "title": "Stage 1 GVM Upgrade",
            "gvm_figure": "4,200 kg",
            "gcm_figure": "8,200 kg",
            "payload_gain": "+450 kg",
            "stage_label": "Stage 1",
            "btn_text": "View Package"
          }
        },
        {
          "type": "package_card",
          "settings": {
            "vehicle_label": "Chevrolet Silverado 1500",
            "title": "Stage 2 GVM Upgrade",
            "gvm_figure": "4,400 kg",
            "gcm_figure": "8,400 kg",
            "payload_gain": "+600 kg",
            "stage_label": "Stage 2",
            "badge": "Most Popular",
            "btn_text": "View Package"
          }
        },
        {
          "type": "package_card",
          "settings": {
            "vehicle_label": "Ford F150",
            "title": "Stage 1 GVM Upgrade",
            "gvm_figure": "4,100 kg",
            "gcm_figure": "8,100 kg",
            "payload_gain": "+400 kg",
            "stage_label": "Stage 1",
            "btn_text": "View Package"
          }
        }
      ]
    }
  ]
}
{% endschema %}
