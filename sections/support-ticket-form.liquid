      "label": "Heading color"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Need a hand? Submit a support ticket and our team will get back to you as soon as possible.</p>"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo position",
      "options": [
        { "value": "above", "label": "Above heading" },
        { "value": "left", "label": "Left of heading" },
        { "value": "right", "label": "Right of heading" }
      ],
      "default": "above"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 400,
      "step": 10,
      "default": 160,
      "unit": "px"
    },
    {
