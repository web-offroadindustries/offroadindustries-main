{%- liquid
  assign columns = section.settings.columns
  assign column_spacing = section.settings.column_spacing
  assign show_social = section.settings.show_social
  assign show_policy = section.settings.show_policy
  assign show_localization = section.settings.show_localization
  assign enable_follow_on_shop = section.settings.enable_follow_on_shop
  assign custom_class = section.settings.custom_class

  if show_social
    assign social_position = section.settings.social_position
  endif

  assign newsletter_block = section.blocks | where: 'type', 'newsletter' | first
  assign logo_block = section.blocks | where: 'type', 'logo' | first

  assign footer_bg_image = section.settings.footer_bg_image
  assign footer_bg_image_size = section.settings.footer_bg_image_size | default: 'cover'
  assign footer_bg_image_position = section.settings.footer_bg_image_position | default: 'center center'
  assign footer_bg_image_repeat = section.settings.footer_bg_image_repeat | default: 'no-repeat'

  unless custom_class == blank
    assign custom_class = custom_class | prepend: ' '
  endunless
-%}

{%- capture logo -%}
  <div class="site-footer__brand pt-sm">
    <a href="{{ routes.root_url }}" class="inline-block">
      {% if settings.logo != blank %}
        {% assign logo_alt = settings.logo.alt | default: shop.name | escape %}
        {% assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio %}
        {{
          settings.logo
          | image_url: width: 1000
          | image_tag:
            class: 'site-header__logo',
            widths: '200, 300, 400, 500, 600',
            height: logo_height,
            width: settings.logo_width,
            alt: logo_alt
        }}
      {% else %}
        <span class="h4 text-color-text">{{ shop.name }}</span>
      {% endif %}
    </a>
    {% if logo_block.settings.description != blank %}
      <div class="site-footer__brand-description text-left rte">
        {{ logo_block.settings.description }}
      </div>
    {% endif %}
  </div>
{%- endcapture -%}

<footer class="site-footer{{ custom_class }}">
  {% if section.settings.enable_help_bar and section.blocks.size > 0 %}
    {% assign help_bar = section.blocks | where: 'type', 'help_bar' %}
    {% if help_bar.size > 0 %}
      {% render 'footer-help-bar', help_bar: help_bar %}
    {% endif %}
  {% endif %}
  <div class="site-footer__top color-{{ section.settings.color_schema }}"{% if footer_bg_image != blank %} style="background-image: url({{ footer_bg_image | image_url: width: 3000 }}); background-size: {{ footer_bg_image_size }}; background-position: {{ footer_bg_image_position }}; background-repeat: {{ footer_bg_image_repeat }};"{% endif %}>
    <div class="{{ section.settings.container }}">
      {% if section.settings.show_divider %}
        <div class="site-footer__divider"></div>
      {% endif %}
      <div class="site-footer__content">
        <div class="site-footer__row flex">
          {% if logo_block != blank %}
            <div class="site-footer__logo site-footer__col f-column w-full sm:w-{{ section.settings.logo_col }} md:w-{{ section.settings.logo_col }} lg:w-{{ section.settings.logo_col }}">
              {{ logo }}
              {% if show_social and social_position == 'logo_column' %}
                {% render 'social-links', size: 'large', class: 'site-footer__social' %}
              {% endif %}
            </div>
          {% endif %}
          <div class="site-footer__links site-footer__col f-column w-full sm:w-{{ section.settings.links_col }} md:w-{{ section.settings.links_col }} lg:w-{{ section.settings.links_col }}">
            <div class="site-footer__links-wrapper f-grid f-grid-{{ columns }}-cols f-grid--gap-{{ column_spacing }}">
              {% for block in section.blocks %}
                {% case block.type %}
                  {% when 'menu' %}
                    <div class="site-footer__block">
                      {% render 'footer-menu-block', block: block %}
                    </div>
                  {% when 'text' %}
                    <div class="site-footer__block">
                      {% render 'footer-text-block', block: block %}
                    </div>
                  {% when 'social_links' %}
                    <div class="site-footer__block">
                      {% render 'footer-social-links-block', block: block %}
                    </div>
                  {% when 'image' %}
                    <div class="site-footer__block">
                      {% render 'footer-image-block', block: block %}
                    </div>
                  {% when 'newsletter' %}
                    <div class="site-footer__block">
                      {% render 'footer-newsletter-block', block: block %}
                    </div>
                {% endcase %}
              {% endfor %}
            </div>
          </div>
        </div>
        {% if show_social and social_position == 'footer_bottom' %}
          {% render 'social-links', size: 'large', class: 'site-footer__social site-footer__social--bottom' %}
        {% endif %}
      </div>
    </div>
  </div>

  <div class="site-footer__bottom color-{{ section.settings.color_schema }}"{% if footer_bg_image != blank %} style="background-image: url({{ footer_bg_image | image_url: width: 3000 }}); background-size: {{ footer_bg_image_size }}; background-position: {{ footer_bg_image_position }}; background-repeat: {{ footer_bg_image_repeat }};"{% endif %}>
    <div class="{{ section.settings.container }}">
      <div class="site-footer__bottom-content flex justify-between items-center">
        <div class="site-footer__bottom-left flex items-center">
          {% if show_policy %}
            <ul class="site-footer__policy list-none flex items-center">
              {% for policy in shop.policies %}
                {% if policy != blank %}
                  <li>
                    <a href="{{ policy.url }}">{{ policy.title }}</a>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}
        </div>
        <div class="site-footer__bottom-right flex items-center">
          {% if show_localization %}
            {% render 'localization-form', class: 'site-footer__localization' %}
          {% endif %}
          {% if enable_follow_on_shop %}
            <div class="site-footer__follow-on-shop">
              {{ shop | shopify_follow_button }}
            </div>
          {% endif %}
          {% if section.settings.show_payment_icons %}
            {% render 'payment-icons', class: 'site-footer__payment-icons' %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "section",
  "class": "section-footer",
  "max_blocks": 20,
  "blocks": [
    {
      "type": "help_bar",
      "name": "t:sections.footer.blocks.help_bar.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.footer.blocks.help_bar.settings.title.label",
          "default": "Help bar title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:sections.footer.blocks.help_bar.settings.description.label"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.footer.blocks.help_bar.settings.icon.label",
          "options": [
            { "value": "none", "label": "t:sections.footer.blocks.help_bar.settings.icon.options.none" },
            { "value": "truck", "label": "t:sections.footer.blocks.help_bar.settings.icon.options.truck" },
            { "value": "phone", "label": "t:sections.footer.blocks.help_bar.settings.icon.options.phone" },
            { "value": "email", "label": "t:sections.footer.blocks.help_bar.settings.icon.options.email" },
            { "value": "pin", "label": "t:sections.footer.blocks.help_bar.settings.icon.options.pin" }
          ],
          "default": "none"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.footer.blocks.help_bar.settings.link.label"
        }
      ]
    },
    {
      "type": "logo",
      "name": "t:sections.footer.blocks.logo.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "description",
          "label": "t:sections.footer.blocks.logo.settings.description.label",
          "default": "<p>Add your brand description here.</p>"
        }
      ]
    },
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        { "type": "text", "id": "title", "label": "t:sections.footer.blocks.menu.settings.title.label", "default": "Quick links" },
        { "type": "link_list", "id": "menu", "label": "t:sections.footer.blocks.menu.settings.menu.label" }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        { "type": "text", "id": "title", "label": "t:sections.footer.blocks.text.settings.title.label", "default": "Heading" },
        { "type": "richtext", "id": "text", "label": "t:sections.footer.blocks.text.settings.text.label", "default": "<p>Add your text here.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.footer.blocks.newsletter.name",
      "settings": [
        { "type": "text", "id": "title", "label": "t:sections.footer.blocks.newsletter.settings.title.label", "default": "Subscribe to our emails" },
        { "type": "textarea", "id": "description", "label": "t:sections.footer.blocks.newsletter.settings.description.label" }
      ]
    },
    {
      "type": "social_links",
      "name": "t:sections.footer.blocks.social_links.name",
      "settings": [
        { "type": "text", "id": "title", "label": "t:sections.footer.blocks.social_links.settings.title.label", "default": "Follow us" }
      ]
    },
    {
      "type": "image",
      "name": "t:sections.footer.blocks.image.name",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:sections.footer.blocks.image.settings.image.label" },
        { "type": "text", "id": "link", "label": "t:sections.footer.blocks.image.settings.link.label" }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:sections.common.general.name"
    },
    {
      "type": "select",
      "id": "container",
      "label": "t:sections.common.container.label",
      "default": "container",
      "options": [
        { "value": "container", "label": "t:sections.common.container.fixed" },
        { "value": "container-fluid", "label": "t:sections.common.container.stretched" },
        { "value": "container-full", "label": "t:sections.common.container.fullwidth" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_schema",
      "label": "t:sections.common.color_schema.label",
      "default": "background-1"
    },
{
  "type": "header",
  "content": "Background image"
},
{
  "type": "image_picker",
  "id": "footer_bg_image",
  "label": "Background image (overlays the footer color)"
},
{
  "type": "select",
  "id": "footer_bg_image_size",
  "label": "Background image size",
  "default": "cover",
  "options": [
    { "value": "cover", "label": "Cover" },
    { "value": "contain", "label": "Contain" },
    { "value": "auto", "label": "Original" }
  ],
  "visible_if": "{{ section.settings.footer_bg_image != blank }}"
},
{
  "type": "select",
  "id": "footer_bg_image_position",
  "label": "Background image position",
  "default": "center center",
  "options": [
    { "value": "left top", "label": "Left top" },
    { "value": "center top", "label": "Center top" },
    { "value": "right top", "label": "Right top" },
    { "value": "left center", "label": "Left center" },
    { "value": "center center", "label": "Center" },
    { "value": "right center", "label": "Right center" },
    { "value": "left bottom", "label": "Left bottom" },
    { "value": "center bottom", "label": "Center bottom" },
    { "value": "right bottom", "label": "Right bottom" }
  ],
  "visible_if": "{{ section.settings.footer_bg_image != blank }}"
},
{
  "type": "select",
  "id": "footer_bg_image_repeat",
  "label": "Background image repeat",
  "default": "no-repeat",
  "options": [
    { "value": "no-repeat", "label": "No repeat" },
    { "value": "repeat", "label": "Repeat" },
    { "value": "repeat-x", "label": "Repeat horizontally" },
    { "value": "repeat-y", "label": "Repeat vertically" }
  ],
  "visible_if": "{{ section.settings.footer_bg_image != blank }}"
},
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "t:sections.footer.settings.show_divider.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.help_bar_header.content"
    },
    {
      "type": "checkbox",
      "id": "enable_help_bar",
      "label": "t:sections.footer.settings.enable_help_bar.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.layout_header.content"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.footer.settings.columns.label",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "column_spacing",
      "label": "t:sections.footer.settings.column_spacing.label",
      "default": "medium",
      "options": [
        { "value": "none", "label": "t:sections.footer.settings.column_spacing.options.none" },
        { "value": "small", "label": "t:sections.footer.settings.column_spacing.options.small" },
        { "value": "medium", "label": "t:sections.footer.settings.column_spacing.options.medium" },
        { "value": "large", "label": "t:sections.footer.settings.column_spacing.options.large" }
      ]
    },
    {
      "type": "range",
      "id": "logo_col",
      "label": "t:sections.footer.settings.logo_col.label",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "links_col",
      "label": "t:sections.footer.settings.links_col.label",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.social_header.content"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:sections.footer.settings.show_social.label",
      "default": true
    },
    {
      "type": "select",
      "id": "social_position",
      "label": "t:sections.footer.settings.social_position.label",
      "default": "footer_bottom",
      "options": [
        { "value": "logo_column", "label": "t:sections.footer.settings.social_position.options.logo_column" },
        { "value": "footer_bottom", "label": "t:sections.footer.settings.social_position.options.footer_bottom" }
      ],
      "visible_if": "{{ section.settings.show_social == true }}"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.bottom_header.content"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "label": "t:sections.footer.settings.show_policy.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "t:sections.footer.settings.show_localization.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_follow_on_shop",
      "label": "t:sections.footer.settings.enable_follow_on_shop.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.footer.settings.show_payment_icons.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.common.custom_attr.header"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.custom_attr.custom_class"
    }
  ],
  "presets": [
    {
      "name": "t:sections.footer.name",
      "blocks": [
        { "type": "logo" },
        { "type": "newsletter" },
        { "type": "menu" }
      ]
    }
  ]
}
{% endschema %}