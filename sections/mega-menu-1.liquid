{% render 'mega-menu', section: section, section_type: 'mega-menu-1' %}

{% schema %}
{
  "name": "Mega menu 1",
  "tag": "section",
  "class": "shopify-section--mega-menu",
  "enabled_on": { "groups": ["header"] },
  "presets": [{ "name": "Mega menu 1" }],
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "parent", "label": "Link title", "info": "The mega menu will appear below this parent link" },
    {
      "type": "header",
      "content": "Mega menu background"
    },
    {
      "type": "color",
      "id": "mm_bg_color",
      "label": "Background overlay color",
      "default": "#0b0b0b"
    },
    {
      "type": "range",
      "id": "mm_bg_opacity",
      "label": "Background overlay opacity (%)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 85
    },
    {
      "type": "image_picker",
      "id": "mm_bg_image",
      "label": "Background image (optional)"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "header", "content": "Top content" },
        { "type": "richtext", "id": "richtext_top", "label": "Text area" },
        { "type": "image_picker", "id": "image_top", "label": "Image" },
        { "type": "text", "id": "image_caption_top", "label": "Image caption" },
        { "type": "url", "id": "image_link_top", "label": "Image link" },

        { "type": "header", "content": "Navigation" },
        { "type": "link_list", "id": "menu_1", "label": "Menu 1" },
        { "type": "url", "id": "menu_1_link", "label": "Menu 1 link", "info": "Add a link to the title of the menu." },
        { "type": "link_list", "id": "menu_2", "label": "Menu 2" },
        { "type": "url", "id": "menu_2_link", "label": "Menu 2 link", "info": "Add a link to the title of the menu." },
        { "type": "link_list", "id": "menu_3", "label": "Menu 3" },
        { "type": "url", "id": "menu_3_link", "label": "Menu 3 link", "info": "Add a link to the title of the menu." },
        { "type": "link_list", "id": "menu_4", "label": "Menu 4" },
        { "type": "url", "id": "menu_4_link", "label": "Menu 4 link", "info": "Add a link to the title of the menu." },

        { "type": "header", "content": "Bottom content" },
        { "type": "image_picker", "id": "image_bottom", "label": "Image" },
        { "type": "text", "id": "image_caption_bottom", "label": "Image caption" },
        { "type": "url", "id": "image_link_bottom", "label": "Image link" },
        { "type": "richtext", "id": "richtext_bottom", "label": "Text area" }
      ]
    }
  ]
}
{% endschema %}
