    {
      "type": "text",
      "name": "t:sections.image-with-text.blocks.text.name",
      "settings": [
        { "type": "richtext", "id": "text", "label": "t:sections.image-with-text.blocks.text.settings.text.label", "default": "<p>Add your content here.</p>" }
