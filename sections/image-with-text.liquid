{%- liquid
  assign section_id = section.settings.custom_id | default: section.id
  assign container = section.settings.container
  assign custom_class = section.settings.custom_class
  assign enable_lightbox = section.settings.enable_lightbox

  unless section.settings.show_image_padding
    assign custom_class = custom_class | append: ' image-with-text--image-out overflow-hidden'
    assign container = container | append: ' md:w-full'
  endunless

  unless custom_class == blank
    assign custom_class = custom_class | prepend: ' '
  endunless

  assign block_heading = section.blocks | where: 'type', 'heading' | first
  if block_heading
    assign alt = block_heading.settings.heading | escape
  endif

  case section.settings.image_width
    when '16%'
      assign image_width = 'w-full md:w-1/2 lg:w-2/12'
    when '20%'
      assign image_width = 'w-full md:w-1/2 lg:w-1/5'
    when '25%'
      assign image_width = 'w-full md:w-1/2 lg:w-1/4'
    when '33%'
      assign image_width = 'w-full md:w-1/2 lg:w-1/3'
    when '50%'
      assign image_width = 'w-full md:w-1/2 lg:w-1/2'
    when '66%'
      assign image_width = 'w-full md:w-1/2 lg:w-8/12'
    when '75%'
      assign image_width = 'w-full md:w-1/2 lg:w-9/12'
    when '83%'
      assign image_width = 'w-full md:w-1/2 lg:w-10/12'
    when '100%'
      assign image_width = 'w-full md:w-1/2 lg:w-full'
  endcase

  assign motion_delay = 0
  assign animation_effect = settings.animations
  if animation_effect != 'none' and section.settings.animations != 'inherit'
    assign animation_effect = section.settings.animations
  endif
-%}
<style>
  #{{ section_id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  }
</style>

<style>
  /* Lightbox (scoped) */
  #{{ section_id }} .iwt-lightbox__trigger{
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }
  #{{ section_id }} .iwt-lightbox{
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 24px;
  }
  #{{ section_id }} .iwt-lightbox[hidden]{ display: none !important; }
  #{{ section_id }} .iwt-lightbox__backdrop{
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,.72);
  }
  #{{ section_id }} .iwt-lightbox__dialog{
    position: relative;
    z-index: 1;
    max-width: min(1100px, 100%);
    max-height: min(85vh, 100%);
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,.35);
  }
  #{{ section_id }} .iwt-lightbox__media{
    display: block;
    max-height: 85vh;
    overflow: auto;
  }
  #{{ section_id }} .iwt-lightbox__img{
    display: block;
    width: 100%;
    height: auto;
  }
  #{{ section_id }} .iwt-lightbox__close{
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
  }
  html.iwt-lightbox-open, html.iwt-lightbox-open body{
    overflow: hidden !important;
  }

  @media (max-width: 768px){
    #{{ section_id }} .iwt-lightbox{ padding: 14px; }
    #{{ section_id }} .iwt-lightbox__dialog{ border-radius: 6px; }
  }
</style>

{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}
<div
  id="{{ section_id }}"
  class="image-with-text overflow-hidden {{ custom_class }} f-section-padding color-{{ section.settings.color_schema }}"
>
  <div class="{{ container }}">
    <div class="f-flex items-{{ section.settings.vertical_alignment }} f-grid--gap-{{ section.settings.column_gap }} f-grid--row-gap-{{ section.settings.row_gap }} flex-wrap{% if section.settings.image_position == 'right' %} flex-row-reverse image-with-text--reverse{% endif %}">
      <div class="block f-column {{ image_width }}">
        <motion-element
          data-motion="{{ animation_effect }}"
          class="image-with-text__media f-card block"
        >
          {%- if section.settings.image != blank -%}
            {%- if enable_lightbox -%}
              <button
                type="button"
                class="iwt-lightbox__trigger"
                aria-label="Open image"
                aria-expanded="false"
                data-iwt-open
              >
                {% render 'responsive-image',
                  image: section.settings.image,
                  alt: alt,
                  section_index: section.index,
                  index: 1
                %}
              </button>
            {%- else -%}
              {% render 'responsive-image',
                image: section.settings.image,
                alt: alt,
                section_index: section.index,
                index: 1
              %}
            {%- endif -%}
          {%- else -%}
            <div class="f-image" style="--aspect-ratio: 1/1">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </motion-element>
      </div>
      <div class="f-column f-column__image flex-1">
        <div
          class="image-with-text__content f-text-blocks f-blocks-padding f-align-content-container--{{ section.settings.align_content_container }}"
          style="--padding-left: {{ section.settings.padding_left }}px;--padding-right: {{ section.settings.padding_right }}px;--mobile-padding-left: {{ section.settings.mobile_padding_left }}px;--mobile-padding-right: {{ section.settings.mobile_padding_right }}px;"
        >
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'subheading' -%}
                {%- if block.settings.subheading != blank -%}
                  <motion-element
                    data-motion="{{ animation_effect }}"
                    data-motion-delay="{{ motion_delay }}"
                    class="block image-with-text__subheading {{ block.settings.subheading_size }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.subheading }}
                  </motion-element>
                  {%- assign motion_delay = motion_delay | plus: 50 -%}
                {%- endif -%}

              {%- when 'heading' -%}
                {%- if block.settings.heading != blank -%}
                  <motion-element
                    data-motion="{{ animation_effect }}"
                    data-motion-delay="{{ motion_delay }}"
                    class="block image-with-text__heading {{ block.settings.heading_size }}"
                    {{ block.shopify_attributes }}
                  >
                    {% render 'highlight-text',
                      hl_text: block.settings.heading,
                      hl_style: block.settings.highlight_style,
                      enable_hl_text_color: block.settings.enable_highlight_text_color
                    %}
                  </motion-element>
                  {%- assign motion_delay = motion_delay | plus: 50 -%}
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.text != blank -%}
                  <motion-element
                    data-motion="{{ animation_effect }}"
                    data-motion-delay="{{ motion_delay }}"
                    class="block image-with-text__text rte"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.text }}
                  </motion-element>
                  {%- assign motion_delay = motion_delay | plus: 50 -%}
                {%- endif -%}

              {%- when 'button' -%}
                {%- if block.settings.button_label != blank -%}
                  <motion-element
                    data-motion="{{ animation_effect }}"
                    data-motion-delay="{{ motion_delay }}"
                    class="block image-with-text__btn"
                  >
                    <a
                      {% if block.settings.button_link != blank %}
                        href="{{ block.settings.button_link }}"
                      {% else %}
                        role="link"
                        aria-disabled="true"
                      {% endif %}
                      class="btn f-text-blocks__btn {{ block.settings.button_style }} {{ block.settings.button_size }}"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.button_label | escape }}
                    </a>
                  </motion-element>
                  {%- assign motion_delay = motion_delay | plus: 50 -%}
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  {%- if enable_lightbox and section.settings.image != blank -%}
    <div class="iwt-lightbox" id="IWT-Lightbox-{{ section.id }}" hidden>
      <div class="iwt-lightbox__backdrop" data-iwt-close></div>
      <div class="iwt-lightbox__dialog" role="dialog" aria-modal="true" aria-label="Image preview">
        <button type="button" class="btn btn--plain iwt-lightbox__close" data-iwt-close aria-label="Close">
          {% comment %} theme-check-disable {% endcomment %}
          {{ 'icon-close.svg' | inline_asset_content }}
          {% comment %} theme-check-enable {% endcomment %}
        </button>
        <div class="iwt-lightbox__media">
          {{-
            section.settings.image
            | image_url: width: 2000
            | image_tag:
              widths: '600, 900, 1200, 1600, 2000',
              sizes: '100vw',
              alt: alt,
              class: 'iwt-lightbox__img',
              loading: 'lazy'
          -}}
        </div>
      </div>
    </div>

    <script>
      (function(){
        var root = document.getElementById({{ section_id | json }});
        if(!root) return;

        var openBtn = root.querySelector('[data-iwt-open]');
        var modal = document.getElementById('IWT-Lightbox-{{ section.id }}');
        if(!openBtn || !modal) return;

        var closeEls = modal.querySelectorAll('[data-iwt-close]');
        var dialog = modal.querySelector('.iwt-lightbox__dialog');

        function open(){
          modal.hidden = false;
          document.documentElement.classList.add('iwt-lightbox-open');
          openBtn.setAttribute('aria-expanded','true');
          if(dialog){
            dialog.setAttribute('tabindex','-1');
            dialog.focus({preventScroll:true});
          }
        }

        function close(){
          modal.hidden = true;
          document.documentElement.classList.remove('iwt-lightbox-open');
          openBtn.setAttribute('aria-expanded','false');
          openBtn.focus({preventScroll:true});
        }

        openBtn.addEventListener('click', function(e){
          e.preventDefault();
          open();
        });

        closeEls.forEach(function(el){
          el.addEventListener('click', function(e){
            e.preventDefault();
            close();
          });
        });

        modal.addEventListener('keydown', function(e){
          if(e.key === 'Escape'){
            e.preventDefault();
            close();
          }
        });
      })();
    </script>
  {%- endif -%}
</div>

{% schema %}
