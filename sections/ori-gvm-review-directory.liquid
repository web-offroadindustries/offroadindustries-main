{%- liquid
  assign section_id = section.settings.custom_id | default: section.id
  assign container = section.settings.container | default: 'container'
  assign directory_collection = section.settings.collection
  assign products_limit = section.settings.products_limit | default: 50

  if directory_collection == blank
    assign directory_collection = collections['gvm-upgrades']
  endif
-%}

<section
  id="{{ section_id }}"
  class="ori-gvm-directory f-section-padding color-{{ section.settings.color_schema }}"
  data-section-type="ori-gvm-review-directory"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --gvm-directory-bg: {{ section.settings.background_color }};
    --gvm-directory-line: {{ section.settings.line_color }};
    --gvm-directory-link: {{ section.settings.link_color }};
  "
>
  <div class="{{ container }}">
    <div class="ori-gvm-directory__document">
      <header class="ori-gvm-directory__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ori-gvm-directory__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ori-gvm-directory__heading h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="ori-gvm-directory__subheading rte">{{ section.settings.subheading }}</div>
        {%- endif -%}
        {%- if section.settings.show_count and directory_collection != blank -%}
          <p class="ori-gvm-directory__count">
            {{ directory_collection.products_count }}
            {%- if directory_collection.products_count == 1 %} package{% else %} packages{% endif -%}
          </p>
        {%- endif -%}
      </header>

      {%- if directory_collection != blank and directory_collection.products_count > 0 -%}
        <ol class="ori-gvm-directory__list">
          {%- for directory_product in directory_collection.products limit: products_limit -%}
            <li class="ori-gvm-directory__item">
              <div class="ori-gvm-directory__product-row">
                <span class="ori-gvm-directory__number" aria-hidden="true">{{ forloop.index }}</span>
                <div class="ori-gvm-directory__product-details">
                  <a class="ori-gvm-directory__product-link" href="{{ directory_product.url }}">
                    {{ directory_product.title | escape }}
                  </a>
                  {%- unless directory_product.available -%}
                    <span class="ori-gvm-directory__status">Currently unavailable</span>
                  {%- endunless -%}
                </div>
                <a class="ori-gvm-directory__review-link" href="{{ directory_product.url }}">
                  Review
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </div>

              {%- if section.settings.show_stage_links and directory_product.variants.size > 1 -%}
                <ul class="ori-gvm-directory__stages" aria-label="{{ directory_product.title | escape }} stages">
                  {%- for variant in directory_product.variants -%}
                    <li>
                      <a href="{{ directory_product.url }}?variant={{ variant.id }}">
                        <span class="ori-gvm-directory__stage-name">{{ variant.title | escape }}</span>
                        {%- if section.settings.show_skus and variant.sku != blank -%}
                          <span class="ori-gvm-directory__sku">SKU {{ variant.sku | escape }}</span>
                        {%- endif -%}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- elsif section.settings.show_skus and directory_product.selected_or_first_available_variant.sku != blank -%}
                <p class="ori-gvm-directory__single-sku">
                  SKU {{ directory_product.selected_or_first_available_variant.sku | escape }}
                </p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>

        {%- if directory_collection.products_count > products_limit -%}
          <p class="ori-gvm-directory__overflow-note">
            Showing the first {{ products_limit }} packages.
            <a href="{{ directory_collection.url }}">View the complete collection</a>.
          </p>
        {%- endif -%}
      {%- elsif request.design_mode -%}
        <p class="ori-gvm-directory__empty">
          Select the GVM collection to populate this review directory.
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  .ori-gvm-directory {
    background: var(--gvm-directory-bg);
  }

  .ori-gvm-directory__document {
    max-width: 980px;
    margin: 0 auto;
    padding: clamp(24px, 4vw, 48px);
    background: #fff;
    border: 1px solid var(--gvm-directory-line);
    border-radius: 12px;
    box-shadow: 0 8px 30px rgba(20, 42, 44, 0.06);
  }

  .ori-gvm-directory__header {
    padding-bottom: 24px;
    border-bottom: 2px solid var(--gvm-directory-link);
  }

  .ori-gvm-directory__eyebrow,
  .ori-gvm-directory__count,
  .ori-gvm-directory__single-sku,
  .ori-gvm-directory__overflow-note {
    margin: 0;
  }

  .ori-gvm-directory__eyebrow {
    color: #4d7477;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ori-gvm-directory__heading {
    margin: 6px 0 8px;
  }

  .ori-gvm-directory__subheading {
    max-width: 680px;
  }

  .ori-gvm-directory__subheading > :first-child {
    margin-top: 0;
  }

  .ori-gvm-directory__subheading > :last-child {
    margin-bottom: 0;
  }

  .ori-gvm-directory__count {
    margin-top: 12px;
    color: #596466;
    font-size: 13px;
    font-weight: 600;
  }

  .ori-gvm-directory__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ori-gvm-directory__item {
    padding: 22px 0;
    border-bottom: 1px solid var(--gvm-directory-line);
  }

  .ori-gvm-directory__product-row {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) auto;
    align-items: start;
    gap: 12px;
  }

  .ori-gvm-directory__number {
    color: #788486;
    font-size: 13px;
    line-height: 1.7;
  }

  .ori-gvm-directory__product-details {
    min-width: 0;
  }

  .ori-gvm-directory__product-link,
  .ori-gvm-directory__review-link,
  .ori-gvm-directory__stages a,
  .ori-gvm-directory__overflow-note a {
    color: var(--gvm-directory-link);
  }

  .ori-gvm-directory__product-link {
    font-size: clamp(17px, 2vw, 20px);
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
  }

  .ori-gvm-directory__product-link:hover,
  .ori-gvm-directory__product-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ori-gvm-directory__status {
    display: block;
    margin-top: 3px;
    color: #8a3d35;
    font-size: 12px;
  }

  .ori-gvm-directory__review-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 38px;
    padding: 0 14px;
    border: 1px solid var(--gvm-directory-line);
    border-radius: 999px;
    background: #fff;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .ori-gvm-directory__review-link:hover,
  .ori-gvm-directory__review-link:focus-visible {
    background: var(--gvm-directory-bg);
    border-color: var(--gvm-directory-link);
    transform: translateY(-1px);
  }

  .ori-gvm-directory__review-link:focus-visible,
  .ori-gvm-directory__stages a:focus-visible {
    outline: 2px solid var(--gvm-directory-link);
    outline-offset: 2px;
  }

  .ori-gvm-directory__stages {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 10px;
    max-width: 720px;
    margin: 16px 0 0 46px;
    padding: 0;
    list-style: none;
  }

  .ori-gvm-directory__stages li {
    display: flex;
    min-width: 0;
  }

  .ori-gvm-directory__stages a {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    min-height: 64px;
    padding: 12px 14px;
    border: 1px solid var(--gvm-directory-line);
    border-radius: 8px;
    background: #fff;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .ori-gvm-directory__stage-name {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.25;
  }

  .ori-gvm-directory__stages a:hover,
  .ori-gvm-directory__stages a:focus-visible {
    background: var(--gvm-directory-bg);
    border-color: var(--gvm-directory-link);
    box-shadow: 0 5px 14px rgba(20, 42, 44, 0.09);
    transform: translateY(-1px);
  }

  .ori-gvm-directory__sku,
  .ori-gvm-directory__single-sku {
    color: #697476;
    font-size: 11px;
    line-height: 1.35;
    letter-spacing: 0.03em;
  }

  .ori-gvm-directory__single-sku {
    margin: 8px 0 0 46px;
  }

  .ori-gvm-directory__overflow-note,
  .ori-gvm-directory__empty {
    padding-top: 20px;
    font-size: 13px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ori-gvm-directory__review-link,
    .ori-gvm-directory__stages a {
      transition: none;
    }

    .ori-gvm-directory__review-link:hover,
    .ori-gvm-directory__review-link:focus-visible,
    .ori-gvm-directory__stages a:hover,
    .ori-gvm-directory__stages a:focus-visible {
      transform: none;
    }
  }

  @media (max-width: 639px) {
    .ori-gvm-directory__document {
      padding: 22px 18px;
      border-radius: 8px;
    }

    .ori-gvm-directory__product-row {
      grid-template-columns: 26px minmax(0, 1fr);
      gap: 8px;
    }

    .ori-gvm-directory__review-link {
      grid-column: 2;
      justify-self: start;
      min-height: 32px;
    }

    .ori-gvm-directory__stages,
    .ori-gvm-directory__single-sku {
      margin-left: 34px;
    }

    .ori-gvm-directory__stages {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "ORI GVM review links",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Client review directory" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "All GVM Upgrade Packages" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Open any package or stage below to review its product page.</p>" },
    { "type": "collection", "id": "collection", "label": "GVM collection" },
    { "type": "checkbox", "id": "show_count", "label": "Show package count", "default": true },
    { "type": "checkbox", "id": "show_stage_links", "label": "Show direct stage links", "info": "Lists product variants as direct review links when a package has multiple stages.", "default": true },
    { "type": "checkbox", "id": "show_skus", "label": "Show SKUs", "default": true },
    { "type": "range", "id": "products_limit", "label": "Maximum packages", "min": 5, "max": 50, "step": 5, "default": 50 },
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "options": [
        { "value": "container-full", "label": "Full width" },
        { "value": "container", "label": "Fixed" },
        { "value": "container-narrow", "label": "Narrow" }
      ],
      "default": "container"
    },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#f4fbfb" },
    { "type": "color", "id": "line_color", "label": "Divider colour", "default": "#d8e6e7" },
    { "type": "color", "id": "link_color", "label": "Link colour", "default": "#1f1f1f" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "text", "id": "custom_id", "label": "Custom HTML ID" },
    { "type": "text", "id": "color_schema", "label": "Color scheme class" }
  ],
  "presets": [
    { "name": "ORI GVM review links" }
  ]
}
{% endschema %}
