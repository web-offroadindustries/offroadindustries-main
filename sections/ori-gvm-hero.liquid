{{ 'ori-gvm-hero.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign section_id   = section.settings.custom_id | default: section.id
  assign container    = section.settings.container
  assign has_bg_image = false
  if section.settings.bg_image != blank
    assign has_bg_image = true
  endif
-%}

<div
  id="{{ section_id }}"
  class="ori-gvm-hero f-section-padding color-{{ section.settings.color_schema }}{% if has_bg_image %} ori-gvm-hero--has-image{% endif %}"
  data-section-type="ori-gvm-hero"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- if has_bg_image -%}
      --hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    {%- endif -%}
  "
>
  {%- if has_bg_image -%}
    <div class="ori-gvm-hero__bg-wrap">
      {{-
        section.settings.bg_image
        | image_url: width: 2000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          class: 'ori-gvm-hero__bg-img',
          widths: '750,1000,1400,1800,2000',
          sizes: '100vw'
      -}}
      <div class="ori-gvm-hero__overlay"></div>
    </div>
  {%- endif -%}

  <div class="{{ container }}">
    <div class="ori-gvm-hero__inner">

      {%- if section.settings.badge_text != blank -%}
        <span class="ori-gvm-hero__badge">{{ section.settings.badge_text }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="ori-gvm-hero__heading {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="ori-gvm-hero__subheading rte">{{ section.settings.subheading }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="ori-gvm-hero__trust-list" role="list">
          {%- for block in section.blocks -%}
            {%- case block.type -%}

              {%- when 'trust_item' -%}
                {%- if block.settings.text != blank -%}
                  <li class="ori-gvm-hero__trust-item" {{ block.shopify_attributes }}>
                    {%- if block.settings.icon != blank -%}
                      <span class="ori-gvm-hero__trust-icon">{{ block.settings.icon }}</span>
                    {%- else -%}
                      <span class="ori-gvm-hero__trust-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                      </span>
                    {%- endif -%}
                    <span>{{ block.settings.text }}</span>
                  </li>
                {%- endif -%}

            {%- endcase -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="ori-gvm-hero__ctas">
        {%- comment -%}
          Primary call to action. With "opens the quote form" ticked it opens the
          contact-form-v4 popup already on the page instead of navigating away.
          Falls back to its URL if that section is ever removed.
        {%- endcomment -%}
        {%- if section.settings.btn_1_text != blank -%}
          {%- if section.settings.btn_1_opens_quote -%}
            <modal-opener data-modal="#PopupModal-{{ section.settings.quote_popup_id | handle }}">
              <button type="button" class="btn {{ section.settings.btn_1_style }}">
                {{- section.settings.btn_1_text -}}
              </button>
            </modal-opener>
          {%- else -%}
            <a
              href="{{ section.settings.btn_1_url | default: '#' }}"
              class="btn {{ section.settings.btn_1_style }}"
            >
              {{- section.settings.btn_1_text -}}
            </a>
          {%- endif -%}
        {%- endif -%}
        {%- if section.settings.btn_2_text != blank -%}
          <a
            href="{{ section.settings.btn_2_url | default: '#' }}"
            class="btn {{ section.settings.btn_2_style }}"
          >
            {{- section.settings.btn_2_text -}}
          </a>
        {%- endif -%}
      </div>

      {%- comment -%}
        Third call to action, through to the load calculator. Blank by default.
        In its own row because flex-basis 100% in the row above stretched it
        into a full width bar. Do not use btn--link: the theme paints its hover
        fill with .btn::before/::after and the :not() guard misses btn--link,
        so the fill shows as a solid block.
      {%- endcomment -%}
      {%- if section.settings.btn_3_text != blank -%}
        <div class="ori-gvm-hero__calc-cta">
          {%- comment -%}
            The quiet style deliberately drops the .btn class rather than adding
            a modifier to it. .btn paints its hover fill with ::before/::after
            and the :not() guard on that rule does not cover a custom modifier,
            so anything that stays a .btn ends up with the fill showing through.
            Leaving .btn off entirely sidesteps that completely.
          {%- endcomment -%}
          {%- if section.settings.btn_3_style == 'quiet' -%}
            {%- assign calc_class = 'ori-gvm-hero__calc-btn ori-gvm-hero__calc-btn--quiet' -%}
          {%- else -%}
            {%- assign calc_class = 'btn ' | append: section.settings.btn_3_style | append: ' ori-gvm-hero__calc-btn' -%}
          {%- endif -%}
          <a
            href="{{ section.settings.btn_3_url | default: '#' }}"
            class="{{ calc_class }}"
          >
            {%- if section.settings.btn_3_show_icon -%}
              <svg class="ori-gvm-hero__calc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="4" y="2" width="16" height="20" rx="2"/>
                <line x1="8" y1="6" x2="16" y2="6"/>
                <line x1="8" y1="11.5" x2="8" y2="11.5"/>
                <line x1="12" y1="11.5" x2="12" y2="11.5"/>
                <line x1="16" y1="11.5" x2="16" y2="11.5"/>
                <line x1="8" y1="15.5" x2="8" y2="15.5"/>
                <line x1="12" y1="15.5" x2="12" y2="15.5"/>
                <line x1="16" y1="15.5" x2="16" y2="18.5"/>
                <line x1="8" y1="18.5" x2="12" y2="18.5"/>
              </svg>
            {%- endif -%}
            <span>{{ section.settings.btn_3_text }}</span>
          </a>
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "ORI GVM Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge / eyebrow",
      "default": "Federally Approved | ADR-Tested | SSM Certified"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "H1 heading",
      "default": "GVM Upgrades Australia"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h0", "label": "XL (h0)" },
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Intro paragraph",
      "default": "<p>ORI Offroad Industries supplies federally approved GVM upgrade packages for American trucks and 4WDs across Australia. Every package is ADR-tested, SSM-certified, and installed by our national network of approved specialists — giving you more payload, legally.</p>"
    },
    {
      "type": "header",
      "content": "CTA buttons"
    },
    {
      "type": "text",
      "id": "btn_1_text",
      "label": "Button 1 label",
      "default": "Browse Vehicles"
    },
    {
      "type": "url",
      "id": "btn_1_url",
      "label": "Button 1 URL",
      "info": "Ignored when the button opens the quote form."
    },
    {
      "type": "checkbox",
      "id": "btn_1_opens_quote",
      "label": "Button 1 opens the quote form",
      "info": "Opens the Contact form v4 section on this page that is set to Popup, instead of following the URL.",
      "default": false
    },
    {
      "type": "text",
      "id": "quote_popup_id",
      "label": "Quote popup ID",
      "info": "Must match the Popup ID on that Contact form v4 section.",
      "default": "gvm-quote"
    },
    {
      "type": "select",
      "id": "btn_1_style",
      "label": "Button 1 style",
      "options": [
        { "value": "btn--primary", "label": "Primary" },
        { "value": "btn--secondary", "label": "Secondary" },
        { "value": "btn--outline", "label": "Outline" }
      ],
      "default": "btn--primary"
    },
    {
      "type": "text",
      "id": "btn_2_text",
      "label": "Button 2 label",
      "default": "Request a Quote"
    },
    {
      "type": "url",
      "id": "btn_2_url",
      "label": "Button 2 URL"
    },
    {
      "type": "select",
      "id": "btn_2_style",
      "label": "Button 2 style",
      "options": [
        { "value": "btn--primary", "label": "Primary" },
        { "value": "btn--secondary", "label": "Secondary" },
        { "value": "btn--outline", "label": "Outline" }
      ],
      "default": "btn--outline"
    },
    {
      "type": "text",
      "id": "btn_3_text",
      "label": "Button 3 label",
      "info": "Leave blank to hide. Use for a link through to the load calculator."
    },
    {
      "type": "url",
      "id": "btn_3_url",
      "label": "Button 3 URL"
    },
    {
      "type": "select",
      "id": "btn_3_style",
      "label": "Button 3 style",
      "options": [
        { "value": "btn--primary", "label": "Primary" },
        { "value": "btn--secondary", "label": "Secondary" },
        { "value": "btn--outline", "label": "Outline" },
        { "value": "quiet", "label": "Quiet link (keeps the two buttons above dominant)" }
      ],
      "default": "quiet"
    },
    {
      "type": "checkbox",
      "id": "btn_3_show_icon",
      "label": "Show calculator icon on button 3",
      "default": true
    },
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "options": [
        { "value": "container-full", "label": "Full width" },
        { "value": "container", "label": "Fixed (1200px)" },
        { "value": "container-narrow", "label": "Narrow" }
      ],
      "default": "container"
    },
    {
      "type": "select",
      "id": "color_schema",
      "label": "Color scheme",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "accent", "label": "Accent" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom HTML ID"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Federal / SSM Certification"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji or leave blank for checkmark)",
          "default": "✓"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ORI GVM Hero",
      "blocks": [
        { "type": "trust_item", "settings": { "text": "Federal / SSM Certification", "icon": "✓" } },
        { "type": "trust_item", "settings": { "text": "ADR-Tested & Approved", "icon": "✓" } },
        { "type": "trust_item", "settings": { "text": "Australia-Wide Installer Network", "icon": "✓" } }
      ]
    }
  ]
}
{% endschema %}
