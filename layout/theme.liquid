{%- comment -%} sync-nudge 2026-07-02b: re-trigger GitHub-Shopify pull for 7f5346f (collection hero eager fix). Liquid comment, no functional or visual effect. {%- endcomment -%}
{%- liquid
  assign enable_rtl = settings.enable_rtl
  assign language_support_rtl = settings.language_support_rtl
  if enable_rtl and language_support_rtl != blank
    assign shop_locale = localization.language.iso_code
    assign language_support_rtl_list = language_support_rtl | split: ','
    assign is_rtl = language_support_rtl_list | where: shop_locale
    if is_rtl.size > 0
      assign enable_rtl = true
    else
      assign enable_rtl = false
    endif
  endif
-%}
<!doctype html>
<html
  class="no-js"
  lang="{{ request.locale.iso_code }}"
  {% if enable_rtl %}
    dir="rtl"
  {% endif %}
>
  <head>
    {%- if customer.b2b? and template.name == 'index' -%}
      <script>window.location.replace('/pages/b2b-catalog');</script>
    {%- endif -%}
    {%- comment -%}
      /collections (the "list collections" page) has no collection of its own, so it
      can't mirror /collections/all's product grid + filters. Per merchant request,
      send /collections visitors to /collections/all so both URLs show the same page.
      Scoped to the list-collections template only, evaluated server-side in Liquid,
      and skipped inside the theme editor (request.design_mode) so the template stays
      editable. Shopify admin URL Redirects can't cover /collections (reserved route),
      so this is the theme-side equivalent. Delete this block to restore the default
      all-collections listing at /collections. /collections/all never redirects back,
      so there is no loop.
    {%- endcomment -%}
    {%- if template.name == 'list-collections' and request.design_mode == false -%}
      <script>window.location.replace('/collections/all?sort_by=best-selling');</script>
    {%- endif -%}
    {%- comment -%}
      Default the /collections/all sort order to "best selling". Shopify's built-in
      "all" collection has no admin sort setting, and this theme sorts server-side from
      the sort_by URL param (falling back to the collection default). So when a visitor
      lands on /collections/all with no sort chosen, add sort_by=best-selling (keeping
      any active filters), which the normal grid then honors. Scoped to the all
      collection; skipped in the theme editor; the JS guard on the existing sort_by
      param means it fires at most once (no loop) and never overrides a shopper's
      manual sort choice.
    {%- endcomment -%}
    {%- if template.name == 'collection' and collection.handle == 'all' and request.design_mode == false -%}
      <script>
        (function () {
          var s = window.location.search;
          if (s.indexOf('sort_by=') === -1) {
            window.location.replace(window.location.pathname + (s ? s + '&' : '?') + 'sort_by=best-selling');
          }
        })();
      </script>
    {%- endif -%}
    <!-- Google Tag Manager (interaction-deferred for performance) -->
    <script>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({'gtm.start': new Date().getTime(), event: 'gtm.js'});
      (function() {
        var gtmLoaded = false;
        var interactionEvents = ['wheel', 'pointerdown', 'touchstart', 'keydown'];

        function removeInteractionListeners() {
          interactionEvents.forEach(function(eventName) {
            window.removeEventListener(eventName, loadGTM);
          });
        }

        function loadGTM() {
          if (gtmLoaded) return;
          gtmLoaded = true;
          removeInteractionListeners();
          var f = document.getElementsByTagName('script')[0];
          var j = document.createElement('script');
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-PNBCJ3H';
          f.parentNode.insertBefore(j, f);
        }

        interactionEvents.forEach(function(eventName) {
          window.addEventListener(eventName, loadGTM, { passive: true });
        });
      })();
    </script>
    <!-- End Google Tag Manager -->
    <script>
      window.Store = window.Store || {};
      window.Store.id = {{ shop.id }};
    </script>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
