    {% comment %}theme-check-enable{% endcomment %}

    {% comment %} Custom metafield for head tag like GTag tracking {% endcomment %}
    {{ shop.metafields.foxtheme.code_head.value }}

    {{ 'Evogria.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'Geomanist-Regular.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    {%- comment -%}
      Stand-in faces, loaded on every page so the whole store shares one set.
      Evogria and Geomanist are declared in brand-guidelines.css.liquid but
      their .woff2 files are not on the theme, so text was falling through to
      the browser default. Saira Condensed and Barlow are the closest freely
      licensable match to the brand guidelines.

      They sit AFTER the brand names in --brand-display-font / --brand-body-font,
      so uploading the real files to Assets makes them take over with no change
      here. fonts.googleapis.com is already preconnected above.
    {%- endcomment -%}
    {% comment %}theme-check-disable{% endcomment %}
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet';"
    >
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&display=swap">
    </noscript>
    {% comment %}theme-check-enable{% endcomment %}

    {% comment %}theme-check-disable{% endcomment %}
    <link
      rel="preload"
      href="{{ 'brand-guidelines.css' | asset_url }}"
      as="style"
      onload="this.onload=null;this.rel='stylesheet';"
    >
    {% comment %}theme-check-enable{% endcomment %}
    <noscript>{{ 'brand-guidelines.css' | asset_url | stylesheet_tag }}</noscript>

    {% comment %}theme-check-disable{% endcomment %}
    {%- comment -%}
      Warms the header bundle before sections/header.liquid asks for it.
      Must name the same file the header section loads, or this preload is
      wasted and the browser fetches twice.
    {%- endcomment -%}
    <link rel="preload" href="{{ 'header-bundle.css' | asset_url }}" as="style">
    {%- if template.name == 'product' -%}
      <link rel="preconnect" href="https://options.shopapps.site" crossorigin>
      <link
        rel="preload"
        href="{{ 'bold-options.css' | asset_url }}"
        as="style"
        onload="this.onload=null;this.rel='stylesheet';"
      >
      <link rel="preload" href="https://options.shopapps.site/js/options.js" as="script" crossorigin>
      <link rel="preload" href="{{ 'bold-options-form-linker.js' | asset_url }}" as="script">
    {%- endif -%}
    <link rel="preload" href="{{ 'slideshow-component.css' | asset_url }}" as="style">
    {% comment %}theme-check-enable{% endcomment %}

  {% include 'pagefly-app-header' %}
  {%- liquid
    assign b2b_user = false
    if customer
      if customer.b2b? or customer.tags contains 'b2b'
        assign b2b_user = true
      endif
    endif
    assign is_auth_template = false
    if template contains 'customers/login' or template contains 'customers/activate_account' or template contains 'customers/reset_password'
      assign is_auth_template = true
    endif
  -%}
  {%- if b2b_user or template.suffix == 'b2b-catalog' -%}
    {{ 'b2b-portal.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  {%- if b2b_user and template contains 'customers/account' -%}
    <script>window.location.replace('/pages/b2b-catalog');</script>
  {%- endif -%}
  {%- if b2b_user and template.name == 'index' -%}
    <script>window.location.replace('/pages/b2b-catalog');</script>
  {%- endif -%}
</head>

  <body class="template-{{ template.name | handle }} {{ template.name }}-{{ template.suffix }}{% if b2b_user %} is-b2b{% endif %}" data-b2b-customer="{%- if customer -%}1{%- endif -%}">
    <script>
      (function () {
        try {
          var search = window.location.search;
          if (search.indexOf('sso=silent') !== -1 || search.indexOf('company_location_changed=') !== -1) {
            var raw = localStorage.getItem('b2b_redirect');
            if (raw) {
              try {
                var d = JSON.parse(raw);
                if (Date.now() - d.ts < 30 * 60 * 1000) {
                  localStorage.removeItem('b2b_redirect');
                  window.location.replace(d.url);
                  return;
                }
              } catch (e) {}
              localStorage.removeItem('b2b_redirect');
            }
            {%- if customer.b2b? -%}
              window.location.replace('/pages/b2b-catalog');
            {%- endif -%}
            return;
          }
          {%- comment -%}
            Non-SSO return-to-catalog. The b2b-catalog gate arms localStorage.b2b_redirect
            for LOGGED-OUT visitors; after they log in (email + code) and click back to the
            store, this consumes the key once and returns them to /pages/b2b-catalog.

            Emitted ONLY for logged-in customers ({% if customer %}), which is the guard the
            earlier version was missing: logged-out visitors never receive this script, so
            the old global trap (which bounced ALL traffic + 404s to the catalog) cannot
            recur. The key is preserved on /account pages, removed on use elsewhere, and the
            gate only arms it while logged out, so there is no loop.
          {%- endcomment -%}
          {%- if customer -%}
          var raw2 = localStorage.getItem('b2b_redirect');
          if (raw2 && window.location.pathname.indexOf('/account') !== 0) {
            localStorage.removeItem('b2b_redirect');
            try {
              var d2 = JSON.parse(raw2);
              if (Date.now() - d2.ts < 30 * 60 * 1000 && window.location.pathname !== d2.url) {
                window.location.replace(d2.url);
              }
            } catch (e) {}
          }
          {%- endif -%}
        } catch (e) {}
      })();
    </script>
    {% comment %} Custom metafield for body tag like GTag tracking {% endcomment %}
    {{ shop.metafields.foxtheme.code_body.value }}
    {%- if settings.page_transition -%}
      <div class="f-page-transition no-js-hidden">
        <div class="f-page-transition__spinner">
          <div class="f-page-transition__spinner-content">
            <div></div>
          </div>
        </div>
      </div>
    {%- endif -%}
    <a class="skip-to-content-link btn visually-hidden" href="#MainContent">
      {{- 'accessibility.skip_to_text' | t -}}
    </a>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PNBCJ3H"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <div class="site-wrapper">
      {%- if settings.show_scroll_top_button -%}
        {% render 'scroll-top-button' %}
      {%- endif -%}

      {% sections 'header-group' %}

      {%- liquid
        if settings.cart_type == 'drawer' and template != 'cart'
          render 'cart-drawer'
        endif
        render 'search-drawer'
      -%}

      <main
        id="MainContent"
        class="site-main focus-none"
        role="main"
        tabindex="-1"
      >
        {{ content_for_layout }}
      </main>
      {%- liquid
        if template.name == 'product'
          section 'sticky-atc-bar'
        endif
      -%}
      {% sections 'footer-group' %}
    </div>

    <ul hidden>
      <li id="a11y-refresh-page-message">
        {{ 'accessibility.refresh_page' | t }}
      </li>
    </ul>

    {% render 'theme-script' %}
    {% render 'cookie-banner' %}
    <script src="{{ 'collapsible-tab.js' | asset_url }}" defer="defer"></script>
    {%- if settings.pcard_show_quickview_button
      or settings.pcard_choose_options_actions == 'open_popup'
    -%}
      <script src="{{ 'quick-view.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    {%- if settings.pcard_show_color_swatch -%}
      <script src="{{ 'color-swatch.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    {%- if linklists['gift-wrapping'].links != blank
      and linklists['gift-wrapping'].links.first.type == 'product_link'
    -%}
      <script src="{{ 'gift-wrapping.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    {%- if request.design_mode -%}
      <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {% comment %} WebChat — load after first user interaction to avoid blocking initial render {% endcomment %}
    <script>
      (function() {
        var podiumLoaded = false;
        var interactionEvents = ['wheel', 'pointerdown', 'touchstart', 'keydown'];

        function removeInteractionListeners() {
          interactionEvents.forEach(function(eventName) {
            document.removeEventListener(eventName, loadPodium);
          });
        }

        function loadPodium() {
          if (podiumLoaded) return;
          podiumLoaded = true;
          removeInteractionListeners();
          var s = document.createElement('script');
          s.src = 'https://connect.podium.com/widget.js#ORG_TOKEN=211a92b8-ab89-45c7-ba01-acab8089df3d';
          s.id = 'podium-widget';
          s.setAttribute('data-organization-api-token', '211a92b8-ab89-45c7-ba01-acab8089df3d');
          document.body.appendChild(s);
        }

        interactionEvents.forEach(function(eventName) {
          document.addEventListener(eventName, loadPodium, { passive: true });
        });
      })();
    </script>

    {% comment %} Klaviyo Back in stock — product pages only, deferred after load {% endcomment %}
    {% if template contains 'product' %}
    <script>
      window.addEventListener('load', function() {
        var klaviyo = klaviyo || [];
        klaviyo.init({
          account: "TJhB3u",
          platform: "shopify"
        });
        klaviyo.enable("backinstock",{
          trigger: {
            product_page_text: "Notify Me When Available",
            product_page_class: "btn",
            product_page_text_align: "center",
            product_page_margin: "0px",
            replace_anchor: false
          },
          modal: {
            headline: "{product_name}",
            body_content: "Register to receive a notification when this item comes back in stock.",
            email_field_label: "Email",
            button_label: "Notify me when available",
            subscription_success_label: "You're in! We'll let you know when it's back.",
            footer_content: '',
            additional_styles: "@import url('https://fonts.googleapis.com/css?family=Helvetica+Neue');",
            drop_background_color: "#000",
            background_color: "#fff",
            text_color: "#222",
            button_text_color: "#fff",
            button_background_color: "#439fdb",
            close_button_color: "#ccc",
            error_background_color: "#fcd6d7",
            error_text_color: "#C72E2F",
            success_background_color: "#d3efcd",
            success_text_color: "#1B9500"
          }
        });
      });
    </script>
    {% endif %}

    {% comment %} Product Schema {% endcomment %}
    {% if template contains 'product' %}
      <script type="application/ld+json">
      {
        "@context":"http://schema.org",
        "@type":"Product",
        "@id":"{{ shop.url }}{{ product.url}}", 
        "name": {{ product.title | json }},
        "sku": {{ product.selected_or_first_available_variant.sku | json }},
        "description": {{ product.description | strip_html | truncatewords: 50 | json }},
        "url": {{ canonical_url | json }},
        "image": "{{ product.featured_image | image_url: width: 1024 }}",
        "brand": {
          "@type": "Brand",
          "name": {{ product.vendor | json }},
          "url": {{ jsonld_brand_url | json }}
        },
        "gtin": "{{ product.selected_or_first_available_variant.barcode }}",
        "offers": [{
          "@type": "Offer",
          "priceCurrency": "{{ cart.currency.iso_code }}",
          "price": "{{ product.selected_or_first_available_variant.price | money_without_currency | remove: ',' }}",
          "availability": "http://schema.org/{% if product.selected_or_first_available_variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "itemCondition": "http://schema.org/NewCondition",
          "seller": "{{ shop.name | escape }}",
          "url": "{{ shop.secure_url }}{{ product.selected_or_first_available_variant.url }}"
        }]
        
      }
      </script>
    {% endif %}

    {%- render 'bold-options-hybrid' -%}
    {%- render 'bold-common' -%}
    {%- render 'sc-includes' -%}
    <script src="{{ 'bold-options-form-linker.js' | asset_url }}" defer></script>
    {%- if customer -%}
    <script>
      (function() {
        try {
          var pending = localStorage.getItem('b2b_pending_redirect');
          if (pending && /^\/[^/]/.test(pending) && window.location.pathname !== pending) {
            localStorage.removeItem('b2b_pending_redirect');
            window.location.replace(pending);
          }
        } catch(e) {}
      })();
    </script>
    {%- endif -%}

    {%- comment -%} ORI GVM/GCM JSON-LD structured data — injected per template type {%- endcomment -%}
    {%- if template.suffix == 'gvm-package' or template.suffix == 'gcm-package' -%}
      {%- render 'ori-schema-product', product: product -%}
      {%- render 'ori-schema-breadcrumb', product: product, collection: collection -%}
    {%- endif -%}
    {%- if template.suffix == 'gvm-hub' or template.suffix == 'gcm-hub' -%}
      {%- render 'ori-schema-local-business' -%}
      {%- render 'ori-schema-breadcrumb', collection: collection -%}
    {%- elsif template.suffix == 'gvm-vehicle' or template.suffix == 'gcm-vehicle' -%}
      {%- render 'ori-schema-breadcrumb', collection: collection -%}
    {%- endif -%}
  </body>
</html>
