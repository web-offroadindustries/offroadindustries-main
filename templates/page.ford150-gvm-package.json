        "heading_f9G7kD": {
          "type": "heading",
          "settings": {
            "heading": "<strong>Stage 1: The Weekender Family Getaway</strong>",
            "highlight_style": "none",
            "enable_highlight_text_color": false,
            "heading_size": "h2"
          }
        },
        "text_fRRw7g": {
          "type": "text",
          "settings": {
            "text": "<p><em>The perfect entry point for a legal payload boost without the need for aftermarket wheels.</em></p><ul><li><strong>GVM Rating:</strong> 3700kg (Approx. 1224KG payload) | <strong>GCM:</strong> 8200kg</li><li><strong>Key Features:</strong> Fox 2.0 Performance Series shocks, ORI 200kg heavy-duty leaf packs, and heavy-duty BDS Control Arms.</li><li><strong>Best For:</strong> Daily drivers and light touring. Ideal for owners needing to clear the \"one-tonne\" mark for FBT Tax Compliance while keeping their factory wheels.</li><li><strong>The Benefit:</strong> Achieve a lifted, aggressive stance with premium USA-made shocks. This setup significantly improves stability under load without the added expense of new wheels and tyres.<br/><br/></li></ul>"
          }
        }
      },
      "block_order": [
        "subheading_JVKNjL",
        "heading_f9G7kD",
