      "type": "ori-faq",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "What is a GCM upgrade?",
            "answer": "<p>A GCM (Gross Combined Mass) upgrade increases the maximum legal combined weight of your vehicle and trailer. ORI's federally approved packages are SSM-certified and let you legally tow heavier loads.</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "Can I tow more after a GCM upgrade?",
            "answer": "<p>Yes. A GCM upgrade directly increases your legal towing limit. Combined with a GVM upgrade, you can carry more payload and tow a heavier trailer — legally and safely.</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "Which vehicles can receive a GCM upgrade?",
            "answer": "<p>ORI currently offers federally approved GCM upgrade packages for: Toyota Tundra, Chevrolet Silverado 1500, Chevrolet Silverado 2500HD/3500HD, Ford F-150, RAM 1500, Next-Gen Ford Ranger, and Toyota HiLux.</p>"
          }
        }
      },
