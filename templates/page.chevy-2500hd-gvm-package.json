    "rich_text_GbXVUF": {
      "type": "rich-text",
      "blocks": {
        "heading_XhCLHT": {
          "type": "heading",
          "settings": {
            "heading": "Chevrolet Silverado 2500HD LTZ GVM",
            "highlight_style": "none",
