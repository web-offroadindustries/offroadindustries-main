    "rich_text_GbXVUF": {
      "type": "rich-text",
      "blocks": {
        "heading_XhCLHT": {
          "type": "heading",
          "settings": {
            "heading": "Toyota Landcruiser LC300 GVM",
            "highlight_style": "none",
            "enable_highlight_text_color": true,
            "heading_size": "h1",
            "heading_color": "#56bdc2"
          }
        },
        "text_CfcJd4": {
          "type": "text",
          "settings": {
            "text": "<p>Own a Toyota Landcruiser LC300 and need a GVM upgrade? We've secured federal approval for 4200 GVM packages featuring Fox suspension options. Choose the Stage 1 upgrade with Fox 2.5 Performance Elite Suspension or go for the Stage 2 with Fox 3.0 Factory Race Suspension.</p><p>Both upgrades are federally approved under VTA-064924, ensuring reliable performance and enhanced capability for your LC300. Elevate your vehicle’s strength and suspension today with our trusted packages.</p>"
          }
        }
      },
      "block_order": [
        "heading_XhCLHT",
