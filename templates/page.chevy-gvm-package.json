        },
        "heading_f9G7kD": {
          "type": "heading",
          "settings": {
            "heading": "<strong>Stage 1: The Weekender Family Getaway (3650kg GVM + GCM 8150kg )</strong>",
            "highlight_style": "none",
            "enable_highlight_text_color": false,
            "heading_size": "h2"
          }
        },
        "text_fRRw7g": {
          "type": "text",
          "settings": {
            "text": "<p><em>The perfect entry point for those needing a legal payload boost without a major lift.</em></p><ul><li><strong>GVM Increase:</strong> Up to 3650kg (approx. 1077kg payload).</li><li><strong>Key Features:</strong> Fox 2.5 Performance Series shocks and ORI 200kg heavy-duty leaf packs matched with heavy duty BDS control arms.</li><li><strong>Best For:</strong> Daily drivers and light towing where you need to clear the \"one-tonne\" mark for tax purposes (FBT compliance) or carry extra tools/gear legally.</li><li><strong>Benefit:</strong> Maintains a lifted stance with premium usa made shocks,  while significantly improving stability under load without the need of purchasing load rated wheels.</li></ul>"
          }
        }
      },
      "block_order": [
        "subheading_JVKNjL",
        "heading_f9G7kD",
