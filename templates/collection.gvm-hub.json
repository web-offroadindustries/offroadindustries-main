    "faq": {
      "type": "ori-faq",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "What is a GVM upgrade?",
            "answer": "<p>A GVM (Gross Vehicle Mass) upgrade increases the maximum legal weight your vehicle can carry. ORI's federally approved packages use SSM (Second Stage of Manufacture) certification to reclassify your vehicle from NB1 to NB2, giving you more legal payload capacity.</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "How much payload can I legally gain?",
            "answer": "<p>Payload gains vary by vehicle and stage. Typical Stage 1 packages add 300–600 KG of legal payload. Contact ORI for vehicle-specific figures.</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "What is the difference between GVM and GCM?",
            "answer": "<p>GVM is the maximum legal weight of your vehicle fully loaded. GCM is the maximum legal combined weight of your vehicle plus a trailer. A GCM upgrade lets you legally tow more.</p>"
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "Which vehicles can be upgraded?",
            "answer": "<p>ORI currently offers federally approved packages for: Toyota Tundra, Chevrolet Silverado 1500, Chevrolet Silverado 2500HD/3500HD, Ford F-150, Ford F-250/F-350/F-450, RAM 1500, Next-Gen Ford Ranger, and Toyota HiLux.</p>"
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "question": "Will a GVM upgrade affect my warranty?",
            "answer": "<p>ORI's packages are engineered and federally approved under the SSM process. Warranty implications depend on your vehicle manufacturer — we recommend confirming with your dealer before proceeding.</p>"
          }
        },
        "faq_6": {
          "type": "faq_item",
          "settings": {
            "question": "Can I increase GVM after vehicle registration?",
            "answer": "<p>In most cases yes. ORI's SSM upgrades can be applied to already-registered vehicles, with the new GVM certified and recorded. Confirm the exact process for your state with our team.</p>"
          }
        },
        "faq_7": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need engineering certification?",
            "answer": "<p>ORI's federally approved packages are certified under the Second Stage of Manufacture process, so a separate individual engineering approval is not required. Compliance documentation is supplied with your upgrade.</p>"
          }
        },
        "faq_8": {
          "type": "faq_item",
          "settings": {
            "question": "Can I tow more after a GCM upgrade?",
            "answer": "<p>A GCM upgrade raises the maximum legal combined weight of your vehicle plus trailer, so in many cases you can legally tow more. Exact figures depend on your vehicle and the package chosen.</p>"
          }
        }
      },
