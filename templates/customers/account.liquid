{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign b2b_user = false
  if customer
    if customer.b2b? or customer.tags contains 'b2b'
      assign b2b_user = true
    endif
  endif
-%}

{%- if b2b_user -%}
  <script>window.location.replace('/pages/b2b-catalog');</script>
{%- endif -%}

<div class="f-section">
  <div class="f-customer f-customer__account">

    <div>
      <h1>{{ 'customer.account.title' | t }}</h1>
      <a href="{{ routes.account_logout_url }}" class="btn btn--underline">
        {% comment %} theme-check-disable {% endcomment %}
        {{ 'icon-logout.svg' | inline_asset_content }}
        {% comment %} theme-check-enable {% endcomment %}
        {{ 'customer.log_out' | t }}
      </a>
    </div>

    {%- if b2b_user -%}

      <div>
        {%- paginate collections.all.products by 25 -%}
          <div class="b2b-catalog">

            <div class="b2b-catalog__header">
              <div>
                <h2 class="b2b-catalog__title">Product Catalog</h2>
                <p class="b2b-catalog__desc">
                  View stock availability and pricing below. To place an order, please
                  <a href="/pages/contact">contact us</a>.
                </p>
                {%- if customer.current_company != blank -%}
                  <p class="b2b-catalog__company-info">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    <span>{{ customer.current_company.name }}</span>
                    {%- if customer.current_location != blank and customer.current_location.name != customer.current_company.name -%}
                      <span class="b2b-catalog__company-sep">·</span>
                      <span>{{ customer.current_location.name }}</span>
                    {%- endif -%}
                  </p>
                {%- endif -%}
              </div>
              <div class="b2b-catalog__legend">
                <span class="b2b-stock-badge">In Stock</span>
                <span class="b2b-stock-badge b2b-stock-badge--low">Low Stock</span>
                <span class="b2b-stock-badge b2b-stock-badge--out">Out of Stock</span>
              </div>
            </div>

            {%- if collections.all.products_count > 0 -%}
              <div class="b2b-catalog__table-wrap">
                <table class="b2b-catalog__table">
                  <thead>
                    <tr>
                      <th class="b2b-catalog__th b2b-catalog__th--product">Product</th>
                      <th class="b2b-catalog__th">Variant</th>
                      <th class="b2b-catalog__th">SKU</th>
                      <th class="b2b-catalog__th">Stock</th>
                      <th class="b2b-catalog__th b2b-catalog__th--price">Retail Price</th>
                      <th class="b2b-catalog__th b2b-catalog__th--price">Member Price</th>
                    </tr>
                  </thead>
                  <tbody>
                    {%- for product in collections.all.products -%}
                      {%- for variant in product.variants -%}
                        {%- liquid
                          assign qty = variant.inventory_quantity | default: 0
                          if variant.inventory_management != 'shopify' or variant.inventory_policy == 'continue'
                            assign stock_class = 'b2b-stock-badge'
                            assign stock_label = 'Available'
                            assign stock_qty_show = false
                          elsif qty > 10
                            assign stock_class = 'b2b-stock-badge'
                            assign stock_label = 'In Stock'
                            assign stock_qty_show = true
                          elsif qty > 0
                            assign stock_class = 'b2b-stock-badge b2b-stock-badge--low'
                            assign stock_label = 'Low Stock'
                            assign stock_qty_show = true
                          else
                            assign stock_class = 'b2b-stock-badge b2b-stock-badge--out'
                            assign stock_label = 'Out of Stock'
                            assign stock_qty_show = false
                          endif
                        -%}
                        <tr class="b2b-catalog__row{% if forloop.first %} b2b-catalog__row--first{% endif %}">
                          {%- if forloop.first -%}
                            <td class="b2b-catalog__product-cell" rowspan="{{ product.variants.size }}">
                              <a href="{{ product.url }}" class="b2b-catalog__product-link">
                                {%- if product.featured_image -%}
                                  <img
                                    src="{{ product.featured_image | image_url: width: 80 }}"
                                    alt="{{ product.featured_image.alt | escape }}"
                                    width="40"
                                    height="40"
                                    class="b2b-catalog__thumb"
                                    loading="lazy"
                                  >
                                {%- else -%}
                                  <span class="b2b-catalog__thumb b2b-catalog__thumb--placeholder"></span>
                                {%- endif -%}
                                <span class="b2b-catalog__product-name">{{ product.title }}</span>
                              </a>
                            </td>
                          {%- endif -%}
                          <td class="b2b-catalog__td">
                            {%- if variant.title == 'Default Title' -%}
                              <span class="b2b-catalog__td--muted">—</span>
                            {%- else -%}
                              {{ variant.title }}
                            {%- endif -%}
                          </td>
                          <td class="b2b-catalog__td b2b-catalog__td--sku">
                            {{ variant.sku | default: '—' }}
                          </td>
                          <td class="b2b-catalog__td">
                            <span class="{{ stock_class }}">
                              {{ stock_label }}{% if stock_qty_show %} ({{ qty }}){% endif %}
                            </span>
                          </td>
                          <td class="b2b-catalog__td b2b-catalog__td--price">
                            {%- if variant.compare_at_price > variant.price -%}
                              {{ variant.compare_at_price | money }}
                            {%- else -%}
                              <span class="b2b-catalog__td--muted">—</span>
                            {%- endif -%}
                          </td>
                          <td class="b2b-catalog__td b2b-catalog__td--price b2b-catalog__td--member">
                            {{ variant.price | money }}
                          </td>
                        </tr>
                      {%- endfor -%}
                    {%- endfor -%}
                  </tbody>
                </table>
              </div>
            {%- else -%}
              <p class="b2b-catalog__empty">No products available at this time.</p>
            {%- endif -%}

            {%- if paginate.pages > 1 -%}
              <nav class="b2b-catalog__pagination" aria-label="{{ 'general.pagination.label' | t }}">
                {%- if paginate.previous -%}
                  <a href="{{ paginate.previous.url }}" class="btn btn--outline b2b-catalog__page-btn">
                    &larr; Previous
                  </a>
                {%- endif -%}
                <span class="b2b-catalog__page-info">
                  Page {{ paginate.current_page }} of {{ paginate.pages }}
                </span>
                {%- if paginate.next -%}
                  <a href="{{ paginate.next.url }}" class="btn btn--outline b2b-catalog__page-btn">
                    Next &rarr;
                  </a>
                {%- endif -%}
              </nav>
            {%- endif -%}

          </div>
        {%- endpaginate -%}

        <div class="b2b-catalog__account-details">
          <h2>{{ 'customer.account.details' | t }}</h2>
          {{ customer.default_address | format_address }}
          <a href="{{ routes.account_addresses_url }}" class="btn btn--underline">
            {{ 'customer.account.view_addresses' | t }} ({{ customer.addresses_count }})
          </a>
        </div>
      </div>

    {%- else -%}

      <div>
        <div>
          <h2>{{ 'customer.orders.title' | t }}</h2>

          {% paginate customer.orders by 20 %}
            {%- if customer.orders.size > 0 -%}
              <table role="table" class="order-history">
                <caption class="visually-hidden">
                  {{ 'customer.orders.title' | t }}
                </caption>
                <thead role="rowgroup">
                  <tr role="row">
                    <th id="ColumnOrder" scope="col" role="columnheader">{{ 'customer.orders.order_number' | t }}</th>
                    <th id="ColumnDate" scope="col" role="columnheader">{{ 'customer.orders.date' | t }}</th>
                    <th id="ColumnPayment" scope="col" role="columnheader">{{ 'customer.orders.payment_status' | t }}</th>
                    <th id="ColumnFulfillment" scope="col" role="columnheader">
                      {{ 'customer.orders.fulfillment_status' | t }}
                    </th>
                    <th id="ColumnTotal" scope="col" role="columnheader">{{ 'customer.orders.total' | t }}</th>
                  </tr>
                </thead>
                <tbody role="rowgroup">
                  {%- for order in customer.orders -%}
                    <tr role="row">
                      <td
                        id="RowOrder"
                        role="cell"
                        headers="ColumnOrder"
                        data-label="{{ 'customer.orders.order_number' | t }}"
                      >
                        <a
                          href="{{ order.customer_url }}"
                          aria-label="{{ 'customer.orders.order_number_link' | t: number: order.name }}"
                        >
                          {{ order.name }}
                        </a>
                      </td>
                      <td headers="RowOrder ColumnDate" role="cell" data-label="{{ 'customer.orders.date' | t }}">
                        {{ order.created_at | time_tag: format: 'date' }}
                      </td>
                      <td
                        headers="RowOrder ColumnPayment"
                        role="cell"
                        data-label="{{ 'customer.orders.payment_status' | t }}"
                      >
                        {{ order.financial_status_label }}
                      </td>
                      <td
                        headers="RowOrder ColumnFulfillment"
                        role="cell"
                        data-label="{{ 'customer.orders.fulfillment_status' | t }}"
                      >
                        {{ order.fulfillment_status_label }}
                      </td>
                      <td headers="RowOrder ColumnTotal" role="cell" data-label="{{ 'customer.orders.total' | t }}">
                        {{ order.total_price | money_with_currency }}
                      </td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            {%- else -%}
              <p>{{ 'customer.orders.none' | t }}</p>
            {%- endif -%}

            {%- if paginate.pages > 1 -%}
              {%- if paginate.parts.size > 0 -%}
                <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
                  <ul role="list">
                    {%- if paginate.previous -%}
                      <li>
                        <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">
                          <svg aria-hidden="true" focusable="false" viewBox="0 0 10 6">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
                          </svg>
                        </a>
                      </li>
                    {%- endif -%}

                    {%- for part in paginate.parts -%}
                      <li>
                        {%- if part.is_link -%}
                          <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
                            {{- part.title -}}
                          </a>
                        {%- else -%}
                          {%- if part.title == paginate.current_page -%}
                            <span
                              aria-current="page"
                              aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
                            >
                              {{- part.title -}}
                            </span>
                          {%- else -%}
                            <span>{{ part.title }}</span>
                          {%- endif -%}
                        {%- endif -%}
                      </li>
                    {%- endfor -%}

                    {%- if paginate.next -%}
                      <li>
                        <a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">
                          <svg aria-hidden="true" focusable="false" viewBox="0 0 10 6">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
                          </svg>
                        </a>
                      </li>
                    {%- endif -%}
                  </ul>
                </nav>
              {%- endif -%}
            {%- endif -%}
          {% endpaginate %}
        </div>

        <div>
          <h2>{{ 'customer.account.details' | t }}</h2>

          {{ customer.default_address | format_address }}

          <a href="{{ routes.account_addresses_url }}" class="btn btn--underline">
            {{ 'customer.account.view_addresses' | t }} ({{ customer.addresses_count }})
          </a>
        </div>
      </div>

    {%- endif -%}

  </div>
</div>

