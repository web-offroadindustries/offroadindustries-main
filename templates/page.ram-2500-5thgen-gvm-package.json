        "subheading_ram6g_s1": {
          "type": "subheading",
          "settings": {
            "subheading": "Stage 1: Installed & Engineered — Contact for Pricing",
            "subheading_size": "h5"
          }
        },
        "heading_ram6g_s1": {
          "type": "heading",
          "settings": {
            "heading": "<strong>Stage 1: The Weekender — 2\" Lift on 35s</strong>",
            "highlight_style": "none",
            "enable_highlight_text_color": false,
            "heading_size": "h2"
          }
        },
        "text_ram6g_s1": {
          "type": "text",
          "settings": {
            "text": "<p><em>The entry point to the 6th Gen programme, lifting GVM to 5500kg on a modest two inch lift.</em></p><ul><li><strong>GVM:</strong> 5500kg | <strong>GCM:</strong> 12,474kg | <strong>Braked Towing:</strong> 4500kg</li><li><strong>Lift &amp; Tyres:</strong> 2\" lift, running up to 35x12.5 R18 or 35x12.5 R20.</li><li><strong>Key Features:</strong> Fox 2.5 Performance Elite Series front and rear, BDS 3\" radius arm kit, Husky Extenda flares, ORI mud flap brackets.</li><li><strong>Best For:</strong> Daily drivers and light tourers who want a legal capacity lift without moving to load rated wheels.</li></ul>"
          }
        }
      },
