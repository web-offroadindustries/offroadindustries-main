/* =========================
   BRAND FONTS
========================= */
@font-face {
  font-family: "Evogria";
  src: url("{{ 'Evogria.woff2' | asset_url }}") format("woff2");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: "Geomanist";
  src: url("{{ 'Geomanist-Regular.woff2' | asset_url }}") format("woff2");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: "Geomanist";
  src: url("{{ 'Geomanist-Medium.woff2' | asset_url }}") format("woff2");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}

/* =========================
   BRAND VARIABLES
========================= */
:root {
  --brand-teal: #56BDC2;
  --brand-black: #000000;

  /* Falls back to the fonts chosen in Theme settings > Typography rather than
     to generic sans-serif. The three @font-face files above are not on the
     theme yet, so without this every heading renders as the browser default
     instead of the merchant's own choice. Upload Evogria.woff2,
     Geomanist-Regular.woff2 and Geomanist-Medium.woff2 to Assets and they take
     over automatically, with no further change needed here. */
  /* One stack for the whole store, so every page and block resolves to the
     same faces. Evogria and Geomanist stay first: their .woff2 files are not
     on the theme yet, and uploading them to Assets makes them take over with
     no change here. Saira Condensed and Barlow are the freely licensable
     stand-ins loaded in theme.liquid. The theme's own typography settings are
     the last resort before generic sans. */
  --brand-display-font: "Evogria", "Saira Condensed", {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
  --brand-body-font: "Geomanist", "Barlow", {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};

  /* The theme's own variables are repointed at the same stacks. Roughly a dozen
     rules across theme.css, product.css, collection.css, cart-drawer.css and
     others read --font-heading-family / --font-body-family directly, and the
     .font-heading / .font-body utilities do it with !important at a higher
     specificity than the h1-h6 rule below. Overriding the variables fixes every
     one of those consumers at once instead of chasing each selector.

     critical-css.liquid sets these on :root earlier in the head, so this later
     :root block wins at equal specificity. The tails are read from the same
     theme settings, so nothing is lost if the brand faces are unavailable. */
  --font-heading-family: "Evogria", "Saira Condensed", {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
  --font-body-family: "Geomanist", "Barlow", {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
  --font-subheading-family: "Geomanist", "Barlow", {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
}

/* =========================
   GLOBAL TYPE (GUIDELINES)
   Evogria = headlines/display
   Geomanist Medium = subhead
   Geomanist Regular = body
========================= */
body,
input,
textarea,
select,
button,
.f-site-nav__sub-link {
  font-family: var(--brand-body-font) !important;
  font-weight: 400;
  color: var(--brand-black);
}

/* Headlines / display */
h1, h2, h3, h4, h5, h6,
.h0, .h1, .h2, .h3, .h4, .h5, .h6 {
  font-family: var(--brand-display-font) !important;
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 0.02em;
}

.subhead,
.subtitle,
.section__subheading,
.banner__subtitle,
.collection-hero__description strong,
.rte h4,
.rte h5,
.f-site-nav__link,
.products-bundle__subheading p,
.f-hero_subheading,
.f-hero_subheading p,
button, .btn, .spr-summary-actions-newreview {
  font-family: var(--brand-body-font) !important;
  font-weight: 500;
}

/* =========================
   IN-PAGE ANCHOR OFFSET
   The header is sticky, so a plain #anchor jump parks the target at y=0 and
   the header then covers its heading. scroll-margin-top moves the landing
   point down by the header's own height, which theme-script.liquid publishes
   as --f-header-height on load (and header.js keeps current).

   Applied to section wrappers, since every section carries data-section-type,
   plus :target as a catch-all for anchors sitting on an inner element.
   Harmless when the header is not sticky: it just leaves a little more room
   above the target.
========================= */
[data-section-type],
.shopify-section,
:target {
  scroll-margin-top: calc(var(--f-header-height, 80px) + 12px);
}

/* =========================
   BRAND COLOR (PRIMARY TEAL)
========================= */
a,
.link,
.text-link {
  color: var(--brand-teal);
}

.button,
.btn,
button[type="submit"] {
  background-color: var(--brand-teal);
  border-color: var(--brand-teal);
  color: #fff;
}

.button--secondary,
.btn--secondary {
  background: transparent;
  border-color: var(--brand-teal);
  color: var(--brand-teal);
}
.button-show-more.btn--underline,
.active-facets .active-facets__button {
  font-size: 12px;
  padding: 5px 10px !important;
  line-height: normal;
  min-height: 34px;
}