/* =========================
   BRAND FONTS
========================= */
@font-face {
  font-family: "Evogria";
  src: url("{{ 'Evogria.woff2' | asset_url }}") format("woff2");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: "Geomanist";
  src: url("{{ 'Geomanist-Regular.woff2' | asset_url }}") format("woff2");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: "Geomanist";
  src: url("{{ 'Geomanist-Medium.woff2' | asset_url }}") format("woff2");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}

/* =========================
   BRAND VARIABLES
========================= */
:root {
  --brand-teal: #56BDC2;
  --brand-black: #000000;

  --brand-display-font: "Evogria", sans-serif;
  --brand-body-font: "Geomanist", sans-serif;
}

/* =========================
   GLOBAL TYPE (GUIDELINES)
   Evogria = headlines/display
   Geomanist Medium = subhead
   Geomanist Regular = body
========================= */
body,
input,
textarea,
select,
button,
.f-site-nav__sub-link {
  font-family: var(--brand-body-font) !important;
  font-weight: 400;
  color: var(--brand-black);
}

/* Headlines / display */
h1, h2, h3, h4, h5, h6,
.h0, .h1, .h2, .h3, .h4, .h5, .h6 {
  font-family: var(--brand-display-font) !important;
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 0.02em;
}

.subhead,
.subtitle,
.section__subheading,
.banner__subtitle,
.collection-hero__description strong,
.rte h4,
.rte h5,
.f-site-nav__link,
.products-bundle__subheading p,
.f-hero_subheading,
.f-hero_subheading p,
button, .btn, .spr-summary-actions-newreview {
  font-family: var(--brand-body-font) !important;
  font-weight: 500;
}

/* =========================
   IN-PAGE ANCHOR OFFSET
   The header is sticky, so a plain #anchor jump parks the target at y=0 and
   the header then covers its heading. scroll-margin-top moves the landing
   point down by the header's own height, which theme-script.liquid publishes
   as --f-header-height on load (and header.js keeps current).

   Applied to section wrappers, since every section carries data-section-type,
   plus :target as a catch-all for anchors sitting on an inner element.
   Harmless when the header is not sticky: it just leaves a little more room
   above the target.
========================= */
[data-section-type],
.shopify-section,
:target {
  scroll-margin-top: calc(var(--f-header-height, 80px) + 12px);
}

/* =========================
   BRAND COLOR (PRIMARY TEAL)
========================= */
a,
.link,
.text-link {
  color: var(--brand-teal);
}

.button,
.btn,
button[type="submit"] {
  background-color: var(--brand-teal);
  border-color: var(--brand-teal);
  color: #fff;
}

.button--secondary,
.btn--secondary {
  background: transparent;
  border-color: var(--brand-teal);
  color: var(--brand-teal);
}
.button-show-more.btn--underline,
.active-facets .active-facets__button {
  font-size: 12px;
  padding: 5px 10px !important;
  line-height: normal;
  min-height: 34px;
}